<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles" version="1">
  <grid anchorCell="A1">
    <control type="Label"
             name="Title"
             text="PersonalEventBuilder"
             row="1"
             column="1"
             columnSpan="8"
             style="pageTitle"/>

    <control type="Button"
             name="HelloWorld"
             caption="Hello World"
             row="3"
             column="5"
             rowSpan="2"
             columnSpan="3"
             style="primaryButton"
             onClick="{Binding Module=ex_PersonalEventBuilder; Method=fn_HelloWorld}"/>
  </grid>

  <styles>
    <controlStyle name="pageTitle"
                  backColor="#1F2937"
                  textColor="#F9FAFB"
                  fontName="Calibri"
                  fontSize="16"
                  fontBold="true"
                  horizontal="center"
                  vertical="center"/>

    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{
                backColor:#1F2329;
                fontColor:#E5E7EB;
                borderColor:#111827;
                borderWeight:thin;
                rowHeight:21;
                overflow:wrap;
                gridLines:false;
                zoom:90%;
              }"/>

        <rule target="column"
              selector="address=A:A"
              styles="{
                width:2;
              }"/>
      </layer>

      <layer name="layout">
        <rule target="control"
              selector="type=button"
              styles="{
                horizontal:center;
                vertical:center;
              }"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>