<?xml version="1.0" encoding="utf-8"?>
<tableSync>
    <profile name="Movement"
             default="true"
             source="C:\Users\isrepeat\Desktop\ШПО_new.xlsx"
             target="C:\Users\isrepeat\Desktop\РУХ_last.xlsx"
             overwriteTarget="false"
             previewDiff="MovementPreview"
             appliedDiff="MovementApplied">
        <outputs directory="C:\WORK\Windows\Строевые приказы\Tasks\2026.10.25.SurnameChanges\Results\{DATE}">
            <workbook file="{targetName} (synced).xlsx" />
            <previewReport file="{targetName} (sync preview).diff.html" />
            <appliedReport file="{targetName} (sync applied).diff.html" />
        </outputs>
        <mapping sourceSheet="ОС"
                 targetSheet="Список"
                 sourceKey="ІПН"
                 targetKey="ІПН"
                 sourceFallback="Прізвище, ім’я, по батькові"
                 targetFallback="ПІБ">
            <field source="ІПН"
                   target="ІПН" />
            <field source="Прізвище, ім’я, по батькові"
                   target="ПІБ"
                   compareIgnorePattern="\s*\([0-9]{10}\)\s*\z" />
        </mapping>
        <externalTools>
            <tool executable="../../TableDiff/build/TableDiff.exe">
                <tableDiff>
                    <profiles>
                        <profile name="MovementPreview">
                            <outputs directory="C:\WORK\Windows\Строевые приказы\Tasks\2026.10.25.SurnameChanges\Results\{DATE}">
                                <report file="MovementPreview.diff.html" />
                            </outputs>
                            <old file="C:\Users\isrepeat\Desktop\РУХ_last.xlsx" />
                            <new file="C:\Users\isrepeat\Desktop\ШПО_new.xlsx" />
                            <comparisons>
                                <comparison key="ІПН"
                                            threshold="0.65">
                                    <old sheet="Список" />
                                    <new sheet="ОС" />
                                </comparison>
                            </comparisons>
                        </profile>
                        <profile name="MovementApplied">
                            <outputs directory="C:\WORK\Windows\Строевые приказы\Tasks\2026.10.25.SurnameChanges\Results\{DATE}">
                                <report file="MovementApplied.diff.html" />
                            </outputs>
                            <old file="C:\Users\isrepeat\Desktop\РУХ_last.xlsx" />
                            <new file="C:\WORK\Windows\Строевые приказы\Tasks\2026.10.25.SurnameChanges\Results\{DATE}\РУХ_last (synced).xlsx" />
                            <comparisons>
                                <comparison key="ІПН"
                                            threshold="1"
                                            match="row">
                                    <old sheet="Список" />
                                    <new sheet="Список" />
                                </comparison>
                            </comparisons>
                        </profile>
                    </profiles>
                </tableDiff>
            </tool>
        </externalTools>
    </profile>
</tableSync>