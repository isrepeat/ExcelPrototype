<wordTableTemplates xmlns="urn:excelprototype:profiles"
                    version="1">
  <styles>
    <tableStyle name="Ticket"
                width="474.95pt"
                alignment="left"
                layout="fixed"
                borders="none"
                cellPadding="0pt"
                cellPaddingLeft="5.4pt"
                cellPaddingRight="5.4pt"/>
    <cellStyle name="Body"
               fontName="Times New Roman"
               fontSize="16"
               horizontal="left"
               vertical="center"
               spaceBefore="0pt"
               spaceAfter="0pt"/>
    <cellStyle name="Centered"
               basedOn="Body"
               horizontal="center"/>
    <cellStyle name="HeaderCell"
               basedOn="Centered"
               vertical="top"/>
    <cellStyle name="TicketDetails"
               basedOn="Centered"
               fontSize="12"
               spaceAfter="3pt"/>
    <cellStyle name="Caption"
               basedOn="Centered"
               fontSize="12"/>
    <cellStyle name="Title"
               basedOn="Centered"
               fontBold="true"/>
    <cellStyle name="Stamp"
               basedOn="Body"
               fontSize="14"
               vertical="top"/>
    <cellStyle name="Logo"
               basedOn="Centered"
               fontSize="11"
               fontBold="true"/>
    <cellStyle name="LogoCode"
               basedOn="Centered"
               fontSize="9"
               spaceAfter="4pt"/>
    <cellStyle name="Underlined"
               basedOn="Centered"
               borderBottom="single"/>
    <cellStyle name="UnderlinedLeft"
               basedOn="Body"
               borderBottom="single"/>
  </styles>
  <template name="BusinessTrip">
    <table style="Ticket">
      <columns>
        <column name="C1"
                width="11.85pt"/>
        <column name="C2"
                width="51.95pt"/>
        <column name="C3"
                width="63.9pt"/>
        <column name="C4"
                width="67.75pt"/>
        <column name="C5"
                width="98.2pt"/>
        <column name="C6"
                width="181.3pt"/>
      </columns>
      <row allowBreakAcrossPages="false"
           height="7.25pt"
           heightRule="atLeast">
        <cell rowSpan="6"
              columnSpan="4"
              style="HeaderCell">
          <paragraph style="Logo">
            <image source="Emblem"
                   width="7mm"
                   height="9mm"/>
          </paragraph>
          <paragraph style="Logo">
            <text>МІНІСТЕРСТВО ОБОРОНИ{#newline}УКРАЇНИ{#newline}ЗБРОЙНІ СИЛИ УКРАЇНИ{#newline}ВІЙСЬКОВА ЧАСТИНА{#newline}А7383</text>
          </paragraph>
          <paragraph style="LogoCode">
            <text>Код ЄДРПОУ 26630678</text>
          </paragraph>
        </cell>
        <cell rowSpan="9"
              style="HeaderCell">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
        <cell style="Stamp">
          <paragraph>
            <text>Додаток 29</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="12.8pt"
           heightRule="atLeast">
        <cell style="Stamp">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="36.4pt"
           heightRule="atLeast">
        <cell style="Stamp">
          <paragraph>
            <text>до Інструкції з діловодства у Збройних Силах України</text>
          </paragraph>
          <paragraph>
            <text>(пункт 2.8.8.3)</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell style="Stamp">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell style="Stamp">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="18.4pt"
           heightRule="atLeast">
        <cell rowSpan="4"
              style="Stamp">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell style="TicketDetails">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
        <cell columnSpan="3"
              style="TicketDetails">
          <paragraph>
            <text>"{[TicketDateDay]}" {[TicketDateMonth]} {[TicketDateYear]} р.</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell style="TicketDetails">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
        <cell columnSpan="3"
              style="TicketDetails">
          <paragraph>
            <text>№ {[TicketNum]}</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="4.75pt"
           heightRule="atLeast">
        <cell style="TicketDetails">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
        <cell columnSpan="3"
              style="TicketDetails">
          <paragraph>
            <text>м. Харків, 61121</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="12.5pt"
           heightRule="atLeast">
        <cell columnSpan="6"
              style="Centered">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="6"
              style="Title">
          <paragraph>
            <text>ПОСВІДЧЕННЯ ПРО ВІДРЯДЖЕННЯ</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="12.5pt"
           heightRule="atLeast">
        <cell columnSpan="6"
              style="Centered">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="2"
              style="Body">
          <paragraph>
            <text>Видано</text>
          </paragraph>
        </cell>
        <cell columnSpan="4"
              style="Underlined">
          <paragraph>
            <text>{[PersonalLine]}</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="19.7pt"
           heightRule="atLeast">
        <cell columnSpan="2"
              style="Caption">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
        <cell columnSpan="4"
              style="Caption">
          <paragraph>
            <text>(військове звання, прізвище, ім’я та по батькові)</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="6"
              style="Centered">
          <paragraph>
            <text>{[Position]|regexreplace:"^який перебуває ",""}</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="21.65pt"
           heightRule="atLeast">
        <cell columnSpan="6"
              style="Caption">
          <paragraph>
            <text>(посада, місце роботи)</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="3"
              style="UnderlinedLeft">
          <paragraph>
            <text>відрядженому до</text>
          </paragraph>
        </cell>
        <cell columnSpan="3"
              style="Underlined">
          <paragraph>
            <text>{#if [HasTravelPlaces]}{#for place in PlaceChain}{#if #not place.__first}; {#endif}{#if place.[IsMilitary]}військової частини {#endif}{place.[Destination]}{#endfor}{#else}{[TravelPlace]}{#endif}</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="19.3pt"
           heightRule="atLeast">
        <cell columnSpan="3"
              style="Caption">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
        <cell columnSpan="3"
              style="Caption">
          <paragraph>
            <text>(місце відрядження)</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="27.75pt"
           heightRule="atLeast">
        <cell columnSpan="6"
              style="Centered">
          <paragraph>
            <text>Термін відрядження: {#if [TripIndefinite]}з {[TripDeparture]} до окремого розпорядження.{#else}{[TripDays]} {#if [TripDaysOne]}доба{#else}{#if [TripDaysFew]}доби{#else}діб{#endif}{#endif}, з "{[DateFromDay]}" {[DateFromMonth]} {[DateFromYear]} р. по "{[DateToDay]}" {[DateToMonth]} {[DateToYear]} р.{#endif}</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="9.55pt"
           heightRule="atLeast">
        <cell columnSpan="6"
              style="Centered">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <if test="[IsAwolTrip]">
        <row allowBreakAcrossPages="false">
          <cell columnSpan="6"
                style="Centered">
            <text>для подальшого проходження військової служби</text>
          </cell>
        </row>
        <row allowBreakAcrossPages="false">
          <cell columnSpan="6"
                style="Caption">
            <text>(мета відрядження)</text>
          </cell>
        </row>
      </if>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="6"
              style="Body">
          <paragraph>
            <text>Підстава: {[Basis]}</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="12pt"
           heightRule="exact">
        <cell columnSpan="6"
              style="Body">
          <text/>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="6"
              style="Body">
          <text>Дійсно в разі пред’явлення документа, який засвідчує особу.</text>
        </cell>
      </row>
      <if test="[WeaponLine]">
        <row allowBreakAcrossPages="false">
          <cell columnSpan="6"
                style="Body">
            <text>Слідує зі зброєю: {[WeaponLine]}.</text>
          </cell>
        </row>
      </if>
    </table>
  </template>
</wordTableTemplates>