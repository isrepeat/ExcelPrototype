            <text/>
          </paragraph>
        </cell>
        <cell columnSpan="3"
              style="Centered">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="11"
              style="Underlined">
          <paragraph>
            <text>військову частину А7383 </text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="11"
              style="Caption">
          <paragraph>
            <text>(найменування військової частини або населеного пункту)</text>
          </paragraph>
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="11"
              style="Body">
          <paragraph>
            <text>{[DateArrival]} до 08:00 год.</text>
