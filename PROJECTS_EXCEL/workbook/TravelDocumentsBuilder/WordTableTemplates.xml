<wordTableTemplates xmlns="urn:excelprototype:profiles"
                    version="1">
  <styles>
    <tableStyle name="Ticket"
                width="474.95pt"
                alignment="left"
                layout="fixed"
                borders="none"
                cellPadding="0pt"
                cellPaddingLeft="5.4pt"
                cellPaddingRight="5.4pt"/>
    <cellStyle name="Body"
               fontName="Times New Roman"
               fontSize="16"
               horizontal="left"
               vertical="center"
               spaceBefore="0pt"
               spaceAfter="0pt"/>
    <cellStyle name="Centered"
               basedOn="Body"
               horizontal="center"/>
    <cellStyle name="HeaderCell"
               basedOn="Centered"
               vertical="top"/>
    <cellStyle name="Caption"
               basedOn="Centered"
               fontSize="12"/>
    <cellStyle name="Title"
               basedOn="Centered"
               fontBold="true"/>
    <cellStyle name="Stamp"
               basedOn="Body"
               fontSize="14"
               vertical="top"/>
    <cellStyle name="Logo"
               basedOn="Centered"
               fontSize="11"
               fontBold="true"/>
    <cellStyle name="LogoCode"
               basedOn="Centered"
               fontSize="9"/>
    <cellStyle name="Underlined"
               basedOn="Centered"
               borderBottom="single"/>
    <cellStyle name="UnderlinedLeft"
               basedOn="Body"
               borderBottom="single"/>
  </styles>
  <template name="Ticket">
    <table style="Ticket">
      <columns>
        <column name="C1"
                width="11.85pt"/>
        <column name="C2"
                width="78.55pt"/>
        <column name="C3"
                width="14.2pt"/>
        <column name="C4"
                width="90.85pt"/>
        <column name="C5"
                width="50.35pt"/>
        <column name="C6"
                width="0.45pt"/>
        <column name="C7"
                width="8.95pt"/>
        <column name="C8"
                width="35.25pt"/>
        <column name="C9"
                width="3.2pt"/>
        <column name="C10"
                width="101.45pt"/>
        <column name="C11"
                width="79.85pt"/>
      </columns>
      <row allowBreakAcrossPages="false"
           height="7.25pt"
           heightRule="atLeast">
        <cell rowSpan="6"
              columnSpan="4"
              style="HeaderCell">
          <paragraph style="Logo">
            <image source="Emblem"
                   width="7mm"
                   height="9mm"/>
          </paragraph>
          <paragraph style="Logo">
            <text>МІНІСТЕРСТВО ОБОРОНИ{#newline}УКРАЇНИ{#newline}ЗБРОЙНІ СИЛИ УКРАЇНИ{#newline}ВІЙСЬКОВА ЧАСТИНА{#newline}А7383</text>
          </paragraph>
          <paragraph style="LogoCode">
            <text>Код ЄДРПОУ 26630678</text>
          </paragraph>
        </cell>
        <cell rowSpan="9"
              columnSpan="5"
              style="HeaderCell">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
        <cell columnSpan="2"
              style="Stamp">
          <paragraph>
            <text>Додаток 31</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="8.2pt"
           heightRule="atLeast">
        <cell columnSpan="2"
              style="Stamp">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="2"
              style="Stamp">
          <paragraph>
            <text>до Інструкції з діловодства у Збройних Силах України</text>
          </paragraph>
          <paragraph>
            <text>(пункт 2.8.9)</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="2"
              style="Stamp">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell columnSpan="2"
              style="Stamp">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="18.4pt"
           heightRule="atLeast">
        <cell rowSpan="4"
              columnSpan="2"
              style="Stamp">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell style="Centered">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
        <cell columnSpan="3"
              style="Centered">
          <paragraph>
            <text>{[TicketDate]}</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false">
        <cell style="Centered">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
        <cell columnSpan="3"
              style="Centered">
          <paragraph>
            <text>№ {[TicketNum]}</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
           height="4.75pt"
           heightRule="atLeast">
        <cell style="Centered">
          <paragraph>
            <text/>
          </paragraph>
        </cell>
        <cell columnSpan="3"
              style="Centered">
          <paragraph>
            <text>м. Харків, 61121</text>
          </paragraph>
        </cell>
      </row>
      <row allowBreakAcrossPages="false"
