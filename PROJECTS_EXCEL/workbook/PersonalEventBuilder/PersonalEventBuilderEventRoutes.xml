<?xml version="1.0" encoding="utf-8"?>
<eventRoutes xmlns="urn:excelprototype:profiles"
             version="1"
             bindingField="ModeId">
  <imports>
    <import alias="word"
            path="PersonalEventBuilderWordResultTemplates.xml"/>
    <import alias="movement"
            path="PersonalEventBuilderMovementTemplates.xml"/>
  </imports>
  <events>
    <event label="З відрядження"
           caption="З відрядження"
           id="FromBusinessTrip"
           direction="Arrival"
           form="LeaveArrival">
      <movement template="movement:FromBusinessTrip"/>
      <word template="word:FromBusinessTrip"/>
    </event>
    <event label="З лікування"
           caption="З лікування"
           id="FromHospital"
           direction="Arrival"
           form="Treatment">
      <movement template="movement:FromHospital"/>
      <word template="word:FromHospital"/>
    </event>
    <event label="З відпустки для лікування"
           caption="З відпустки для лікування"
           id="FromVacationForCuring"
           direction="Arrival"
           form="LeaveArrival">
      <movement template="movement:FromVacationForCuring"/>
      <word template="word:FromVacationForCuring"/>
    </event>
    <event label="З щорічної відпустки"
           caption="З щорічної відпустки"
           id="FromAnnualMainVacation"
           direction="Arrival"
           form="LeaveArrival">
      <movement template="movement:FromAnnualMainVacation"/>
      <word template="word:FromAnnualMainVacation"/>
    </event>
    <event label="З відпустки за сімейними обставинами"
           caption="З відпустки за сімейними обставинами"
           id="FromVacationForFamily"
           direction="Arrival"
           form="LeaveArrival">
      <movement template="movement:FromVacationForFamily"/>
      <word template="word:FromVacationForFamily"/>
    </event>
    <event label="З амбулаторного ВЛК"
           caption="З амбулаторного ВЛК"
           id="FromOutpatientExaminationOrVlk"
           direction="Arrival"
           form="Treatment">
      <movement template="movement:FromOutpatientExaminationOrVlk"/>
    </event>
    <event label="З ВЛК за межами"
           caption="З ВЛК за межами"
           id="FromExternalVlk"
           direction="Arrival"
           form="Treatment">
      <movement template="movement:FromExternalVlk"/>
      <word template="word:FromExternalVlk"/>
    </event>
    <event label="З медичної роти"
           caption="З медичної роти"
           id="FromMedicalCompanyForTreatment"
           direction="Arrival"
           form="MedicalCompany">
      <movement template="movement:FromMedicalCompanyForTreatment"/>
      <word template="word:FromMedicalCompanyForTreatment"/>
    </event>
    <event label="У відрядження"
           caption="У відрядження"
           id="ToBusinessTrip"
           direction="Departure"
           form="Leave">
      <movement template="movement:ToBusinessTrip"/>
      <word template="word:ToBusinessTrip"/>
    </event>
    <event label="На лікування"
           caption="На лікування"
           id="ToHospital"
           direction="Departure"
           form="Treatment">
      <movement template="movement:ToHospital"/>
      <word template="word:ToHospital"/>
    </event>
    <event label="У щорічну відпустку"
           caption="У щорічну відпустку"
           id="ToAnnualMainVacation"
           direction="Departure"
           form="Leave">
      <movement template="movement:ToAnnualMainVacation"/>
      <word template="word:ToAnnualMainVacation"/>
    </event>
    <event label="У відпустку за сімейними обставинами"
           caption="У відпустку за сімейними обставинами"
           id="ToVacationForFamily"
           direction="Departure"
           form="Leave">
      <movement template="movement:ToVacationForFamily"/>
      <word template="word:ToVacationForFamily"/>
    </event>
    <event label="У відпустку у зв’язку з вагітністю та пологами"
           caption="У відпустку у зв’язку з вагітністю та пологами"
           id="ToMaternityLeave"
           direction="Departure"
           form="Leave">
      <movement template="movement:ToMaternityLeave"/>
      <word template="word:ToMaternityLeave"/>
    </event>
    <event label="У відпустку для лікування"
           caption="У відпустку для лікування"
           id="ToVacationForCuring"
           direction="Departure"
           form="Leave">
      <movement template="movement:ToVacationForCuring"/>
      <word template="word:ToVacationForCuring"/>
    </event>
    <event label="У відпустку для лікування в медроті А7383"
           caption="У відпустку для лікування в медроті А7383"
           id="ToMedicalCompanyVacationForCuring"
           direction="Departure"
           form="Leave">
      <movement template="movement:ToMedicalCompanyVacationForCuring"/>
      <word template="word:ToMedicalCompanyVacationForCuring"/>
    </event>
    <event label="На амбулаторне ВЛК"
           caption="На амбулаторне ВЛК"
           id="ToOutpatientExaminationOrVlk"
           direction="Departure"
           form="Treatment">
      <movement template="movement:ToOutpatientExaminationOrVlk"/>
    </event>
    <event label="В медичну роту"
           caption="В медичну роту"
           id="ToMedicalCompanyForTreatment"
           direction="Departure"
           form="MedicalCompany">
      <movement template="movement:ToMedicalCompanyForTreatment"/>
      <word template="word:ToMedicalCompanyForTreatment"/>
    </event>
  </events>
  <transitions wordSectionAnchor="StatusChanges"
               movementTemplate="movement:StatusChange">
    <statuses>
      <status id="Vlk"
              captionRef="ExternalVlk"
              wordFrom="word:status.FromVlk"
              wordTo="word:status.ToVlk"/>
      <status id="Awol"
              caption="СЗЧ"/>
      <status id="Missing"
              caption="безвісти зниклий"
              wordFrom="word:status.FromMissing"/>
      <status id="Hospital"
              caption="лікування в лікарні"
              sourceCaption="Лікування"
              departure="ToHospital"
              wordFrom="word:status.FromHospital"
              wordTo="word:status.ToHospital"/>
      <status id="ExternalVlk"
              caption="ВЛК за межами"
              wordFrom="word:status.FromExternalVlk"
              wordTo="word:status.ToVlk"/>
      <status id="BusinessTrip"
              caption="відрядження"
              departure="ToBusinessTrip"/>
      <status id="MedicalLeave"
              caption="відпустка для лікування"
              departure="ToVacationForCuring"/>
      <status id="OutpatientVlk"
              caption="амбулаторне ВЛК"
              departure="ToOutpatientExaminationOrVlk"/>
      <status id="AnnualVacation"
              caption="щорічна відпустка"
              departure="ToAnnualMainVacation"
              wordFrom="word:status.FromAnnualLeave"
              wordTo="word:status.ToAnnualLeave"/>
      <status id="FamilyVacation"
              caption="відпустка за сімейними обставинами"
              departure="ToVacationForFamily"
              wordFrom="word:status.FromFamilyLeave"
              wordTo="word:status.ToFamilyLeave"/>
      <status id="MaternityLeave"
              caption="відпустка у зв’язку з вагітністю та пологами"
              departure="ToMaternityLeave"/>
      <status id="VacationForCuring"
              captionRef="MedicalLeave"
              wordFrom="word:status.FromMedicalLeave"
              wordTo="word:status.ToMedicalLeave"/>
      <status id="MedicalCompanyLeave"
              caption="відпустка для лікування в медичній роті"
              departure="ToMedicalCompanyVacationForCuring"/>
      <status id="MedicalCompanyTreatment"
              caption="лікування в медичній роті"
              departure="ToMedicalCompanyForTreatment"/>
      <status id="MedicalLeaveContinuation"
              caption="продовження відпустки для лікування"
              wordTo="word:status.ToMedicalContinuation"/>
      <status id="AnnualVacationContinuation"
              caption="продовження щорічної відпустки"
              wordTo="word:status.ToAnnualContinuation"/>
      <status id="MedicalCompanyForTreatment"
              captionRef="MedicalCompanyTreatment"
              sourceCaption="Медична рота"
              wordFrom="word:status.FromMedicalCompany"/>
      <status id="MedicalCompanyVacationForCuring"
              captionRef="MedicalCompanyLeave"
              wordFrom="word:status.FromMedicalCompanyVacation"
              wordTo="word:status.ToMedicalLeave"/>
    </statuses>
    <routes>
      <transition source="Awol"
                  targets="BusinessTrip"
                  form="Leave"
                  targetCaption="Відрядження"
                  wordLayout="word:AwolBusinessTripPreview"/>
      <transition source="Hospital">
        <route targets="AnnualVacationContinuation"
               form="HospitalLeave"
               movementTemplate="movement:StatusChangeLeaveContinuation"
               wordLayout="word:LeaveWithPreviousTicket"/>
        <route targets="MedicalLeaveContinuation"
               form="HospitalLeave"
               movementTemplate="movement:StatusChangeLeaveContinuation"
               wordLayout="word:MedicalLeaveContinuation"/>
        <route targets="VacationForCuring"
               form="HospitalLeave"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:MedicalLeave"/>
        <route targets="MedicalCompanyVacationForCuring"
               form="HospitalLeave"
               labelSourceCaption="Лікування в лікарні"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:MedicalLeave"/>
        <route targets="ExternalVlk"
               form="Treatment"
               wordLayout="word:ExternalVlk"
               wordFrom="word:status.FromHospitalOptional"/>
      </transition>
      <transition source="VacationForCuring">
        <route targets="VacationForCuring"
               form="Leave"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:MedicalLeaveWithPreviousTicket"/>
        <route targets="Hospital"
               form="Treatment"
               wordLayout="word:HospitalWithPreviousTicket"/>
        <route targets="Vlk"
               form="Treatment"
               wordLayout="word:ExternalVlkWithPreviousTicket"/>
        <route targets="AnnualVacation"
               form="Leave"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:LeaveWithPreviousTicket"/>
      </transition>
      <transition source="AnnualVacation">
        <route targets="Hospital"
               form="Treatment"
               wordLayout="word:HospitalWithPreviousTicket"/>
        <route targets="Vlk"
               form="Treatment"
               wordLayout="word:ExternalVlkWithPreviousTicket"/>
        <route targets="FamilyVacation"
               form="Leave"
               wordLayout="word:LeaveWithPreviousTicket"/>
        <route targets="VacationForCuring"
               form="Leave"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:MedicalLeaveWithPreviousTicket"/>
      </transition>
      <transition source="FamilyVacation">
        <route targets="Vlk"
               form="Treatment"
               wordLayout="word:ExternalVlkWithPreviousTicket"/>
        <route targets="AnnualVacation"
               form="Leave"
               wordLayout="word:LeaveWithPreviousTicket"/>
        <route targets="Hospital"
               form="Treatment"
               wordLayout="word:HospitalWithPreviousTicket"/>
        <route targets="VacationForCuring"
               form="Leave"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:MedicalLeaveWithPreviousTicket"/>
      </transition>
      <transition source="Vlk">
        <route targets="VacationForCuring"
               form="Leave"
               legacy="true"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:MedicalLeave"/>
        <route targets="Hospital"
               form="Treatment"
               legacy="true"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:HospitalWithVlkBasis"/>
      </transition>
      <transition source="MedicalCompanyForTreatment">
        <route targets="Hospital"
               form="Treatment"
               wordLayout="word:HospitalFromMedicalCompany"/>
        <route targets="VacationForCuring"
               form="Leave"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:MedicalLeave"
               wordFrom="word:status.FromMedicalCompanyAlt"/>
      </transition>
      <transition source="MedicalCompanyVacationForCuring">
        <route targets="Hospital"
               form="Treatment"
               wordLayout="word:HospitalFromMedicalCompanyWithPreviousTicket"/>
        <route targets="VacationForCuring"
               form="Leave"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:MedicalLeaveWithPreviousTicket"
               wordFrom="word:status.FromMedicalCompanyVacationAlt"/>
      </transition>
      <transition source="ExternalVlk">
        <route targets="VacationForCuring"
               form="Leave"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:MedicalLeave"/>
        <route targets="Hospital"
               form="Treatment"
               movementTemplate="movement:StatusChangeWithVlkBasis"
               wordLayout="word:HospitalWithVlkBasis"/>
        <route targets="AnnualVacation"
               form="Leave"
               wordLayout="word:Leave"/>
      </transition>
      <transition source="OutpatientVlk">
        <route targets="Hospital"
               form="Treatment"
               direction="Departure"
               wordTemplate="word:ToHospital"
               wordSectionAnchor="ToHospital"/>
        <route targets="VacationForCuring"
               form="Leave"
               direction="Departure"
               wordTemplate="word:ToVacationForCuring"/>
        <route targets="AnnualVacation"
               form="Leave"
               direction="Departure"
               wordTemplate="word:ToAnnualMainVacation"
               wordSectionAnchor="ToAnnualMainVacation"/>
      </transition>
      <transition source="Missing">
        <route targets="Hospital|AnnualVacation"
               legacyDepartureIds="true"/>
        <route targets="FamilyVacation|MaternityLeave"
               legacyDepartureIds="true"
               movementTemplate="movement:StatusChangeWithoutDepartureDocuments"/>
        <route targets="MedicalLeave|MedicalCompanyLeave|OutpatientVlk|MedicalCompanyTreatment|BusinessTrip"
               legacyDepartureIds="true"/>
      </transition>
    </routes>
  </transitions>
</eventRoutes>