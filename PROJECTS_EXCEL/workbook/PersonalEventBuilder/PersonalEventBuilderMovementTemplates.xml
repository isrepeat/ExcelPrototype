<?xml version="1.0" encoding="utf-8"?>
<resultTemplates xmlns="urn:excelprototype:profiles"
                 version="1">
  <resources>
    <dictionary name="DocumentNames"
                ignoreCase="true"
                normalize="trim,slashSpaces"
                onMissing="keep">
      <entry key="м/к">
        <variant value="МКСХ"/>
        <variant value="ВМКСХ"
                 field="SourceStatus"
                 equals="HospitalTreatment"/>
      </entry>
      <entry key="в/к">
        <variant value="В/к"/>
      </entry>
      <entry key="Довідка ВЛК">
        <variant value="довідка військово-лікарської комісії"/>
      </entry>
    </dictionary>
    <itemOrder name="BasisDocuments"
               field="DocumentNote"
               ignoreCase="true"
               normalize="trim,slashSpaces">
      <item key="м/к"
            aliases="медична карта стаціонарного хворого|виписка із медичної карти стаціонарного хворого"/>
      <item key="Довідка ВЛК"
            aliases="довідка військово-лікарської комісії"/>
      <others/>
      <item key="в/к"
            aliases="відпускний квиток"/>
    </itemOrder>
  </resources>
  <sharedTemplates>
    <sharedTemplate id="block.IncomingBasis">
      <text><![CDATA[#^
#_        #let __IsRaportFromSelf = $ex_Helpers.m_RegexIsMatch("{[ReportPerson]}", "^\s*$|^\s*[Сс][Аа][Мм]\s*$");#^
#_        рапорт #^
#_        {#if __IsRaportFromSelf}{[RankGenitive]} {[FIOInitialsGenitive]|nbspBeforeInitials}{#else}{[ReporterGenitive]|nbspBeforeInitials}{#endif}#^
#_        {#space}(вх. № {[IncomingNo]} від {[IncomingDateShort]})#^
#_        {#for item in HistoryReports}; рапорт #^
#_          {#if item.[ReportPerson]}{item.[ReporterGenitive]|lowerFirstLetter|nbspBeforeInitials}{#else}{[RankGenitive]|lowerFirstLetter} {[FIOInitialsGenitive]|nbspBeforeInitials}{#endif}#^
#_          {#space}(вх. № {item.[IncomingNo]} від {item.[IncomingDateShort]})#^
#_        {#endfor}#^
        ]]></text>
    </sharedTemplate>
    <sharedTemplate id="block.DocumentName">
      <text><![CDATA[#^
#_        {[__DocumentName]|lowerFirstLetter|lookup:"DocumentNames"}#^
      ]]></text>
    </sharedTemplate>
    <sharedTemplate id="block.OptionalBasisDocuments">
      <text><![CDATA[#^
#_        {#for item in BasisDocuments orderBy:"BasisDocuments"}#^
#_          #let __IsSupportingDocument = $ex_Helpers.m_RegexIsMatch("{item.[DocumentNote]}", "^\s*(?:[Вв]\s*/\s*[Кк]|[Вв]ідпускний\s+квиток|[Пп]освідчення\s+про\s+відрядження)\s*$");#^
#_          {#if __IsSupportingDocument}{#else}#^
#_          {#if item.[DocumentNote] #and item.[DocNo] #or item.[DocumentNote] #and item.[DocDateShort]}#^
#_            ; #let __DocumentName = "{item.[DocumentNote]}";{#include block.DocumentName}#^
#_            {#if item.[DocNo]}{#space}№ {item.[DocNo]}{#endif}#^
#_            {#if item.[DocDateShort]}{#space}від {item.[DocDateShort]}{#endif}#^
#_          {#endif}#^
#_          {#endif}#^
#_        {#endfor}#^
      ]]></text>
    </sharedTemplate>
    <sharedTemplate id="block.OptionalDepartureBasisDocuments">
      <text><![CDATA[#^
#_        {#for item in BasisDocuments orderBy:"BasisDocuments"}#^
#_          #let __IsVacationTicket = $ex_Helpers.m_RegexIsMatch("{item.[DocumentNote]}", "^\s*(?:[Вв]\s*/\s*[Кк]|[Вв]ідпускний\s+квиток|[Пп]освідчення\s+про\s+відрядження)\s*$");#^
#_          {#if __IsVacationTicket}{#else}#^
#_            {#if item.[DocumentNote] #and item.[DocNo] #or item.[DocumentNote] #and item.[DocDateShort]}#^
#_              ; #let __DocumentName = "{item.[DocumentNote]}";{#include block.DocumentName}#^
#_              {#if item.[DocNo]}{#space}№ {item.[DocNo]}{#endif}#^
#_              {#if item.[DocDateShort]}{#space}від {item.[DocDateShort]}{#endif}#^
#_            {#endif}#^
#_          {#endif}#^
#_        {#endfor}#^
      ]]></text>
    </sharedTemplate>
    <sharedTemplate id="block.OptionalVacationTicket">
      <text><![CDATA[#^
#_        #let __TicketInDocument = $ex_Helpers.m_RegexIsMatch("{[DocumentNote]}", "^\s*(?:[Вв]\s*/\s*[Кк]|[Вв]ідпускний\s+квиток)\s*$");#^
#_        {#if __TicketInDocument}{#else}#^
#_        {#if [VacationTicketNo] #or [VacationTicketDateShort]}; В/к{#if [VacationTicketNo]} № {[VacationTicketNo]}{#endif}{#if [VacationTicketDateShort]} від {[VacationTicketDateShort]}{#endif}{#endif}#^
#_        {#endif}#^
        ]]></text>
    </sharedTemplate>
    <sharedTemplate id="block.OptionalBusinessTripCertificate">
      <text><![CDATA[#^
#_        {#if [VacationTicketNo] #or [VacationTicketDateShort]}; посвідчення про відрядження{#if [VacationTicketNo]} № {[VacationTicketNo]}{#endif}{#if [VacationTicketDateShort]} від {[VacationTicketDateShort]}{#endif}{#endif}#^
        ]]></text>
    </sharedTemplate>
    <sharedTemplate id="block.OptionalPreviousVacationTicket">
      <text><![CDATA[#^
#_        {#if [PrevVacationTicketNo] #or [PrevVacationTicketDateShort]}; В/к{#if [PrevVacationTicketNo]} № {[PrevVacationTicketNo]}{#endif}{#if [PrevVacationTicketDateShort]} від {[PrevVacationTicketDateShort]}{#endif}{#endif}#^
        ]]></text>
    </sharedTemplate>
    <sharedTemplate id="block.OptionalVlkCertificate">
      <text><![CDATA[#^
#_        {#if [VlkNo] #or [VlkDateShort]}; довідка військово-лікарської комісії{#if [VlkNo]} № {[VlkNo]}{#endif}{#if [VlkDateShort]} від {[VlkDateShort]}{#endif}{#endif}#^
        ]]></text>
    </sharedTemplate>
    <sharedTemplate id="block.VlkBasisDocuments">
      <text><![CDATA[#^
#_        {#include block.OptionalBasisDocuments}#^
      ]]></text>
    </sharedTemplate>
  </sharedTemplates>
