<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1">
  <grid anchorCell="A1">
    <controls:button name="Calculate"
                     row="2"
                     column="2"
                     rowSpan="2"
                     columnSpan="2"
                     style="calculateButton"
                     caption="{Binding Path=Text.Calculate}"
                     command="{Binding Path=Commands.Calculate}"/>

    <controls:button name="Cancel"
                     row="5"
                     column="2"
                     columnSpan="2"
                     style="cancelButton"
                     caption="{Binding Path=Text.Cancel}"
                     command="{Binding Path=Commands.Cancel}"/>

    <controls:button name="Export"
                     row="2"
                     column="4"
                     rowSpan="2"
                     style="exportButton"
                     caption="{Binding Path=Text.Export}"
                     command="{Binding Path=Commands.Export}"/>

    <controls:form name="CalculationParameters"
                   dataContext="{Binding Path=Form}"
                   row="2"
                   column="8"
                   orientation="vertical"
                   labelPosition="left"
                   labelStyle="parameterLabel"
                   fieldStyle="parameterField">
      <field name="EndDate"
             type="text"
             value="{Binding Path=EndDate}"
             label="{Binding Path=Text.EndDateLabel}"
             required="true"/>
    </controls:form>

    <controls:label name="LastStatusLabel"
                    row="2"
                    column="11"
                    columnSpan="2"
                    style="statusHeading"
                    text="{Binding Path=Text.LastStatus}"/>

    <controls:label name="LastStatus"
                    row="3"
                    column="11"
                    rowSpan="3"
                    columnSpan="2"
                    style="{Binding Path=Form.ActionStatusStyle}"
                    text="{Binding Path=Form.ActionStatus}"/>

    <stackPanel row="7"
                column="2"
                orientation="vertical">
    <controls:table name="CalculationRows"
                    itemsSource="{Binding Path=Data.CalculationRows}"
                    style="resultTable"
                    representation="Smart"
                    excelTableName="tbPADCCalculationRows"
                    showHeaders="true"/>
    </stackPanel>
  </grid>
  <styles>
    <controlStyle name="calculateButton"
                  backColor="#3B3B3B"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="exportButton"
                  backColor="#3B3B3B"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="cancelButton"
                  backColor="#303030"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="parameterLabel"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="parameterField"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="resultTable"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="statusHeading"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#999999"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="statusNormal"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#909090"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"/>
    <controlStyle name="statusError"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#FFD966"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"/>
    <stylePipelineStage name="default">
      <layer name="sheet">
        <rule target="sheet"
              styles="{backColor:#262626;fontColor:#FFFFFF;fontName:Calibri;fontSize:11;borderColor:#000000;borderWeight:thin;rowHeight:25;overflow:wrap;gridLines:false;zoom:90%;}"/>
        <rule target="column"
              selector="address=A:A"
              styles="{width:9;}"/>
        <rule target="column"
              selector="address=B:N"
              styles="{width:18;}"/>
        <rule target="cell"
              selector="address=I2"
              styles="{cellType:text;}"/>
        <rule target="range"
              selector="address=H2:I2"
              styles="{fontSize:11;}"/>
      </layer>
      <layer name="table">
        <rule target="controlPart"
              selector="type=table;part=header"
              styles="{backColor:#333333;fontColor:#FFFFFF;fontBold:true;horizontal:center;vertical:center;overflow:wrap;rowHeight:auto;}"/>
        <rule target="controlPart"
              selector="type=table;part=rows"
              styles="{overflow:wrap;rowHeight:auto;}"/>
        <rule target="controlPart"
              selector="type=table;part=row;tags=even"
              styles="{backColor:#383838;}"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>