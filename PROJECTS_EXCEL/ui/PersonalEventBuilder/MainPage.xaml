<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="
      urn:excelprototype:controls" version="1">
  <grid anchorCell="A1">
    <controls:label name="Title"
                    text="{Binding Path=Text.Title}"
                    row="1"
                    column="1"
                    columnSpan="8"
                    style="{Binding Path=Resources.PageTitle}"/>

    <controls:button name="HelloWorld"
                     row="3"
                     column="8"
                     rowSpan="2"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.HelloWorld}"
                     command="{Binding Path=Commands.HelloWorldCommand}"/>

    <controls:button name="UpdatePage"
                     row="3"
                     column="5"
                     rowSpan="2"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.UpdatePage}"
                     command="{Binding Path=Commands.UpdatePageCommand}"/>

    <controls:button name="GenerateTables"
                     row="3"
                     column="11"
                     rowSpan="2"
                     columnSpan="3"
                     style="{Binding Path=Resources.PrimaryButton}"
                     caption="{Binding Path=Text.GenerateTables}"
                     command="{Binding Path=Commands.GenerateTablesCommand}"/>

    <controls:tableList name="GeneratedTables"
                        itemsSource="{Binding Path=Data.Tables}"
                        row="14"
                        column="2"
                        showHeaders="true"
                        gapRows="1"/>

    <controls:form name="EventDraftForm"
                   dataContext="{Binding Path=Form}"
                   row="2"
                   column="2"
                   orientation="horizontal"
                   labelPosition="left"
                   labelStyle="formLabel"
                   fieldStyle="formField"
                   onChange="{Binding Path=Commands.FormChangedCommand}">
      <field name="EventName"
             label="Event name"
             type="text"
             required="true"/>

      <field name="Category"
             label="Category"
             type="select"
             itemsSource="{Binding Path=Data.EventTypes}"
             panelStyle="formSelectPanel"
             itemStyle="formSelectItem"/>

      <field name="Notes"
             label="Notes"
             type="text"/>

      <controls:button name="SubmitEventDraft"
                       caption="Submit form"
                       style="primaryButton"
                       command="{Binding Path=Commands.SubmitFormCommand}"/>
    </controls:form>
  </grid>

  <styles>
    <controlStyle name="pageTitle"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="16"
                  fontBold="true"
                  horizontal="center"
                  vertical="center"/>

    <controlStyle name="formLabel"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  horizontal="right"
                  vertical="center"/>

    <controlStyle name="formField"
                  backColor="#2D2D2D"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  vertical="center"/>

    <controlStyle name="formSelectPanel"
                  backColor="#2D2D2D"
                  borderColor="#000000"
                  borderWeight="thin"/>

    <controlStyle name="formSelectItem"
                  backColor="#2D2D2D"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  vertical="center"/>

    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{
                backColor:#262626;
                fontColor:#FFFFFF;
                borderColor:#000000;
                borderWeight:thin;
                rowHeight:25;
                overflow:wrap;
                gridLines:false;
                zoom:90%;
              }"/>
        <rule target="column"
              selector="address=A:A"
              styles="{
                width:2;
              }"/>
      </layer>
      <layer name="layout">
        <rule target="control"
              selector="type=button"
              styles="{
                horizontal:center;
                vertical:center;
              }"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>