<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1"
      zoom="80%">
  <grid row="2"
        column="2">
    <controls:label name="OrderQueryLabel"
                    row="1"
                    column="1"
                    columnSpan="4"
                    style="formLabel"
                    text="{Binding Path=Text.OrderQueryLabel}"/>
    <controls:select name="OrderQuery"
                     itemsSource="{Binding Path=Data.OrderOptions}"
                     row="2"
                     column="1"
                     columnSpan="4"
                     style="formField"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"
                     value="{Binding Path=Form.OrderQuery}"
                     editable="true"
                     highlightValue="{Binding Path=Data.TodayOrderOptions}"
                     highlightStyle="currentOrderItem"
                     itemHeight="20"
                     onChange="{Binding Path=Commands.OrderQueryChanged}"/>
    <controls:label name="OrderYearLabel"
                    row="1"
                    column="5"
                    columnSpan="2"
                    style="formLabel"
                    text="{Binding Path=Text.OrderYearLabel}"/>
    <controls:input name="OrderYear"
                    row="2"
                    column="5"
                    columnSpan="2"
                    style="formField"
                    value="{Binding Path=Form.OrderYear}"
                    onChange="{Binding Path=Commands.SearchOrders}"/>
    <controls:label name="AcceptedOrder"
                    row="1"
                    column="7"
                    rowSpan="2"
                    columnSpan="6"
                    style="statusText"
                    text="{Binding Path=Form.AcceptedOrderText}"/>

    <controls:label name="PersonnelSection"
                    row="4"
                    column="1"
                    columnSpan="12"
                    style="sectionTitle"
                    text="{Binding Path=Text.PersonnelSection}"/>

    <controls:form name="PersonnelForm"
                   dataContext="{Binding Path=Form}"
                   row="5"
                   column="1"
                   columnSpan="12"
                   orientation="horizontal"
                   labelPosition="top"
                   labelStyle="formLabel"
                   fieldStyle="formField">
      <field name="AbsenceType"
             type="text"
             columnSpan="1"
             value="{Binding Path=AbsenceType}"
             label="{Binding Path=Text.AbsenceTypeLabel}"/>
      <field name="Destination"
             type="text"
             columnSpan="2"
             value="{Binding Path=Destination}"
             label="{Binding Path=Text.DestinationLabel}"/>
      <field name="PersonRank"
             type="text"
             columnSpan="1"
             value="{Binding Path=PersonRank}"
             label="{Binding Path=Text.PersonRankLabel}"
             readOnly="true"/>
      <field name="PersonName"
             type="text"
             columnSpan="2"
             value="{Binding Path=PersonName}"
             label="{Binding Path=Text.PersonNameLabel}"
             onChange="{Binding Path=Commands.SearchPersonnel}"/>
      <field name="PersonId"
             type="text"
             columnSpan="1"
             value="{Binding Path=PersonId}"
             label="{Binding Path=Text.PersonIdLabel}"
             readOnly="true"/>
      <field name="PositionCode"
             type="text"
             columnSpan="1"
             value="{Binding Path=PositionCode}"
             label="{Binding Path=Text.PositionCodeLabel}"
             readOnly="true"/>
      <field name="PersonPosition"
             type="text"
             columnSpan="1"
             value="{Binding Path=PersonPosition}"
             label="{Binding Path=Text.PersonPositionLabel}"
             readOnly="true"/>
      <field name="DepartureDate"
             type="text"
             columnSpan="1"
             value="{Binding Path=DepartureDate}"
             label="{Binding Path=Text.DepartureDateLabel}"/>
      <field name="TicketNumber"
             type="text"
             columnSpan="1"
             value="{Binding Path=TicketNumber}"
             label="{Binding Path=Text.TicketNumberLabel}"/>
      <field name="TicketDate"
             type="text"
             columnSpan="1"
             value="{Binding Path=TicketDate}"
             label="{Binding Path=Text.TicketDateLabel}"/>
    </controls:form>

    <controls:candidates name="Candidates"
                    itemsSource="{Binding Path=Data.PersonnelCandidates}"
                    row="8"
                    column="1"
                    style="candidateTable"
                    alignToForm="PersonnelForm"
                    selectionMode="{Binding Path=Settings.CandidateSelectionMode}"
                    selectedItem="{Binding Path=Data.SelectedPersonnel}"
                    onSelect="{Binding Path=Commands.SelectPersonnel}"
                    selectedStyle="candidateSelected"
                    showHeaders="true"/>

    <controls:label name="ActionsSection"
                    row="4"
                    column="14"
                    columnSpan="2"
                    style="sectionTitle"
                    text="{Binding Path=Text.ActionsSection}"/>
    <controls:button name="RefreshPersonnel"
                     row="5"
                     column="14"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.RefreshPersonnel}"
                     command="{Binding Path=Commands.RefreshPersonnel}"/>
    <controls:label name="LastStatusLabel"
                    row="7"
                    column="14"
                    columnSpan="2"
                    style="statusHeading"
                    text="{Binding Path=Text.LastStatus}"/>
    <controls:label name="ActionStatus"
                    row="8"
                    column="14"
                    rowSpan="5"
                    columnSpan="2"
                    style="{Binding Path=Form.ActionStatusStyle}"
                    text="{Binding Path=Form.ActionStatus}"/>
  </grid>

  <styles>
    <controlStyle name="currentOrderItem"
                  backColor="#375D7A"/>
    <controlStyle name="statusHeading"
                  indent="1"
                  backColor="#2D2D2D"
                  textColor="#999999"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="actionSuccess"
                  indent="1"
                  backColor="#262626"
                  textColor="#909090"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"/>
    <controlStyle name="actionError"
                  indent="1"
                  backColor="#262626"
                  textColor="#FFD966"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"/>
    <controlStyle name="disabledButton"
                  backColor="#333333"
                  textColor="#777777"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="sectionTitle"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="searchLabel"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formLabel"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formField"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="statusText"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="candidateTable"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="candidateSelected"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#375D7A"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#6A9EC4"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="secondaryButton"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#3B3B3B"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formSelectPanel"
                  shadow="true"
                  shadowColor="#000000"
                  shadowBlur="6"
                  shadowTransparency="0.55"
                  shadowOffsetX="3"
                  shadowOffsetY="3"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#383838"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="formSelectItem"
                  shadow="false"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#383838"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{backColor:#262626;fontColor:#FFFFFF;fontName:Calibri;fontSize:11;borderColor:#000000;borderWeight:thin;rowHeight:30;overflow:wrap;gridLines:true;}"/>
        <rule target="column"
              selector="address=A:A"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=B:M"
              styles="{width:19,5;}"/>
        <rule target="column"
              selector="address=N:N"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=O:O"
              styles="{width:25;}"/>
        <rule target="column"
              selector="address=P:P"
              styles="{width:12;}"/>
      </layer>
      <layer name="table-parts">
        <rule target="control"
              selector="name=OrderQuery"
              styles="{cellType:text;}"/>
        <rule target="control"
              selector="name=OrderYear"
              styles="{cellType:text;}"/>
        <rule target="control"
              selector="name=PersonId_input"
              styles="{cellType:text;}"/>
        <rule target="controlPart"
              selector="type=candidates;part=header"
              styles="{backColor:#355D8C;fontColor:#FFFFFF;fontBold:true;horizontal:center;vertical:center;}"/>
        <rule target="controlPart"
              selector="type=candidates;part=row;tags=even"
              styles="{backColor:#383838;}"/>
        <rule target="controlPart"
              selector="type=tablelist;part=header"
              styles="{backColor:#355D8C;fontColor:#FFFFFF;fontBold:true;horizontal:center;vertical:center;}"/>
        <rule target="controlPart"
              selector="type=tablelist;part=row;tags=even"
              styles="{backColor:#383838;}"/>
      </layer>
      <layer name="candidate-sources">
        <rule target="controlPart"
              selector="type=candidates;part=rows;sourceAlias=Personnel"
              styles="{backColor:#2D2D2D;fontColor:#FFFFFF;}"/>
        <rule target="controlPart"
              selector="type=candidates;part=rows;sourceAlias=Absence"
              styles="{backColor:#303A35;fontColor:#F4A46B;}"/>
        <rule target="controlPart"
              selector="type=candidates;part=rows;sourceAlias=Personnel;tags=even"
              styles="{backColor:#383838;}"/>
        <rule target="controlPart"
              selector="type=candidates;part=rows;sourceAlias=Absence;tags=even"
              styles="{backColor:#39473D;}"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>