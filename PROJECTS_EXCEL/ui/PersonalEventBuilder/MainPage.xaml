<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1">
  <grid row="2"
        column="2">
    <controls:label name="PersonnelSection"
                    row="1"
                    column="1"
                    columnSpan="7"
                    style="sectionTitle"
                    text="{Binding Path=Text.PersonnelSection}"/>

    <controls:form name="PersonnelForm"
                   dataContext="{Binding Path=Form}"
                   row="2"
                   column="1"
                   orientation="horizontal"
                   labelPosition="top"
                   labelStyle="formLabel"
                   fieldStyle="formField">
      <field name="EventNote"
             type="text"
             value="{Binding Path=EventNote}"
             label="{Binding Path=Text.EventNoteLabel}"/>
      <field name="PersonName"
             type="text"
             value="{Binding Path=PersonName}"
             label="{Binding Path=Text.PersonNameLabel}"
             onChange="{Binding Path=Commands.SearchPersonnel}"/>
      <field name="PersonId"
             type="text"
             value="{Binding Path=PersonId}"
             label="{Binding Path=Text.PersonIdLabel}"
             readOnly="true"/>
      <field name="PersonRank"
             type="text"
             value="{Binding Path=PersonRank}"
             label="{Binding Path=Text.PersonRankLabel}"
             readOnly="true"/>
      <field name="EventDate"
             type="text"
             value="{Binding Path=EventDate}"
             label="{Binding Path=Text.EventDateLabel}"/>
      <field name="PersonPosition"
             type="text"
             value="{Binding Path=PersonPosition}"
             label="{Binding Path=Text.PersonPositionLabel}"
             readOnly="true"/>
      <field name="PersonUnit"
             type="text"
             value="{Binding Path=PersonUnit}"
             label="{Binding Path=Text.PersonUnitLabel}"
             readOnly="true"/>
    </controls:form>

    <controls:candidates name="Candidates"
                    itemsSource="{Binding Path=Data.PersonnelCandidates}"
                    row="5"
                    column="1"
                    style="candidateTable"
                    alignToForm="PersonnelForm"
                    selectedItem="{Binding Path=Data.SelectedPersonnel}"
                    onSelect="{Binding Path=Commands.SelectPersonnel}"
                    selectedStyle="candidateSelected"
                    showHeaders="true"/>

    <controls:label name="ActionsSection"
                    row="1"
                    column="9"
                    columnSpan="2"
                    style="sectionTitle"
                    text="{Binding Path=Text.ActionsSection}"/>
    <controls:button name="RefreshPersonnel"
                     row="2"
                     column="9"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.RefreshPersonnel}"
                     command="{Binding Path=Commands.RefreshPersonnel}"/>
  </grid>

  <styles>
    <controlStyle name="sectionTitle"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="searchLabel"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formLabel"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formField"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="statusText"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="candidateTable"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="candidateSelected"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#375D7A"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#6A9EC4"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="secondaryButton"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#3B3B3B"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formSelectPanel"
                  shadow="true"
                  shadowColor="#000000"
                  shadowBlur="6"
                  shadowTransparency="0.55"
                  shadowOffsetX="3"
                  shadowOffsetY="3"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#383838"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="formSelectItem"
                  shadow="false"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#383838"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{backColor:#262626;fontColor:#FFFFFF;fontName:Calibri;fontSize:11;borderColor:#000000;borderWeight:thin;rowHeight:30;overflow:wrap;gridLines:true;zoom:90%;}"/>
        <rule target="column"
              selector="address=A:A"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=B:B"
              styles="{width:21;}"/>
        <rule target="column"
              selector="address=C:C"
              styles="{width:21;}"/>
        <rule target="column"
              selector="address=D:D"
              styles="{width:21;}"/>
        <rule target="column"
              selector="address=E:E"
              styles="{width:21;}"/>
        <rule target="column"
              selector="address=F:F"
              styles="{width:21;}"/>
        <rule target="column"
              selector="address=G:G"
              styles="{width:21;}"/>
        <rule target="column"
              selector="address=H:H"
              styles="{width:21;}"/>
        <rule target="column"
              selector="address=I:I"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=J:J"
              styles="{width:25;}"/>
        <rule target="column"
              selector="address=K:K"
              styles="{width:12;}"/>
      </layer>
      <layer name="table-parts">
        <rule target="control"
              selector="name=PersonId_input"
              styles="{cellType:text;}"/>
        <rule target="controlPart"
              selector="type=candidates;part=header"
              styles="{backColor:#355D8C;fontColor:#FFFFFF;fontBold:true;horizontal:center;vertical:center;}"/>
        <rule target="controlPart"
              selector="type=candidates;part=row;tags=even"
              styles="{backColor:#383838;}"/>
        <rule target="controlPart"
              selector="type=tablelist;part=header"
              styles="{backColor:#355D8C;fontColor:#FFFFFF;fontBold:true;horizontal:center;vertical:center;}"/>
        <rule target="controlPart"
              selector="type=tablelist;part=row;tags=even"
              styles="{backColor:#383838;}"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>