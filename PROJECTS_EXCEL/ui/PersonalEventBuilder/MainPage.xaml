<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1"
      zoom="80%"
      styleSources="CommonControlStyles.xaml">
  <fieldCatalog name="EventFields">
    <field name="Destination"
           type="text"
           value="{Binding Path=Destination}"
           label="{Binding Path=Text.ModeDestinationLabel}"
           fieldStyle="{Binding Path=Form.DestinationStyle}"
           readOnly="{Binding Path=Form.DestinationReadOnly}"
           partStylesEnabled="true"/>
    <field name="PersonRank"
           type="text"
           value="{Binding Path=PersonRank}"
           label="{Binding Path=Text.ModePersonRankLabel}"
           fieldStyle="{Binding Path=Form.PersonRankStyle}"
           readOnly="{Binding Path=Form.PersonRankReadOnly}"
           partStylesEnabled="true"/>
    <field name="PersonName"
           type="text"
           value="{Binding Path=PersonName}"
           label="{Binding Path=Text.ModePersonNameLabel}"
           fieldStyle="{Binding Path=Form.PersonNameStyle}"
           onChange="{Binding Path=Commands.PersonNameChanged}"
           readOnly="{Binding Path=Form.PersonNameReadOnly}"
           partStylesEnabled="false"/>
    <field name="PersonId"
           type="text"
           value="{Binding Path=PersonId}"
           label="{Binding Path=Text.ModePersonIdLabel}"
           fieldStyle="{Binding Path=Form.PersonIdStyle}"
           readOnly="{Binding Path=Form.PersonIdReadOnly}"
           partStylesEnabled="true"/>
    <field name="PositionCode"
           type="text"
           value="{Binding Path=PositionCode}"
           label="{Binding Path=Text.ModePositionCodeLabel}"
           fieldStyle="{Binding Path=Form.PositionCodeStyle}"
           readOnly="{Binding Path=Form.PositionCodeReadOnly}"
           partStylesEnabled="true"/>
    <field name="PersonPosition"
           type="text"
           value="{Binding Path=PersonPosition}"
           label="{Binding Path=Text.ModePersonPositionLabel}"
           fieldStyle="{Binding Path=Form.PersonPositionStyle}"
           readOnly="{Binding Path=Form.PersonPositionReadOnly}"
           partStylesEnabled="true"/>
    <field name="ReportRank"
           type="text"
           value="{Binding Path=ReportRank}"
           label="{Binding Path=Text.ModeReportRankLabel}"
           fieldStyle="{Binding Path=Form.ReportRankStyle}"
           readOnly="{Binding Path=Form.ReportRankReadOnly}"
           partStylesEnabled="true"/>
    <field name="ReportName"
           type="text"
           value="{Binding Path=ReportName}"
           label="{Binding Path=Text.ModeReportNameLabel}"
           fieldStyle="{Binding Path=Form.ReportNameStyle}"
           onChange="{Binding Path=Commands.ReportNameChanged}"
           readOnly="{Binding Path=Form.ReportNameReadOnly}"
           partStylesEnabled="false"/>
    <field name="ReportPositionCode"
           type="text"
           value="{Binding Path=ReportPositionCode}"
           label="{Binding Path=Text.ModeReportPositionCodeLabel}"
           fieldStyle="{Binding Path=Form.ReportPositionCodeStyle}"
           readOnly="{Binding Path=Form.ReportPositionCodeReadOnly}"
           partStylesEnabled="true"/>
    <field name="IncomingNumber"
           type="text"
           value="{Binding Path=IncomingNumber}"
           label="{Binding Path=Text.ModeIncomingNumberLabel}"
           fieldStyle="{Binding Path=Form.IncomingNumberStyle}"
           readOnly="{Binding Path=Form.IncomingNumberReadOnly}"
           partStylesEnabled="false"/>
    <field name="IncomingDate"
           type="text"
           value="{Binding Path=IncomingDate}"
           label="{Binding Path=Text.ModeIncomingDateLabel}"
           fieldStyle="{Binding Path=Form.IncomingDateStyle}"
           readOnly="{Binding Path=Form.IncomingDateReadOnly}"
           partStylesEnabled="false"/>
    <field name="EventDate"
           type="text"
           value="{Binding Path=EventDate}"
           label="{Binding Path=Text.ModeEventDateLabel}"
           fieldStyle="{Binding Path=Form.EventDateStyle}"
           readOnly="{Binding Path=Form.EventDateReadOnly}"
           partStylesEnabled="false"/>
    <field name="DurationDays"
           type="text"
           value="{Binding Path=DurationDays}"
           label="{Binding Path=Text.ModeDurationDaysLabel}"
           fieldStyle="{Binding Path=Form.DurationDaysStyle}"
           partStylesEnabled="false"/>
    <field name="TicketNumber"
           type="text"
           value="{Binding Path=TicketNumber}"
           label="{Binding Path=Text.ModeTicketNumberLabel}"
           fieldStyle="{Binding Path=Form.TicketNumberStyle}"
           readOnly="{Binding Path=Form.TicketNumberReadOnly}"
           partStylesEnabled="true"/>
    <field name="TicketDate"
           type="text"
           value="{Binding Path=TicketDate}"
           label="{Binding Path=Text.ModeTicketDateLabel}"
           fieldStyle="{Binding Path=Form.TicketDateStyle}"
           readOnly="{Binding Path=Form.TicketDateReadOnly}"
           partStylesEnabled="true"/>
    <field name="Hospital"
           type="text"
           value="{Binding Path=Hospital}"
           label="{Binding Path=Text.ModeHospitalLabel}"
           fieldStyle="{Binding Path=Form.HospitalStyle}"
           onChange="{Binding Path=Commands.HospitalChanged}"
           readOnly="{Binding Path=Form.HospitalReadOnly}"
           partStylesEnabled="false"/>
    <field name="HospitalShortName"
           type="text"
           value="{Binding Path=HospitalShortName}"
           label="{Binding Path=Text.ModeHospitalShortNameLabel}"
           fieldStyle="{Binding Path=Form.HospitalShortNameStyle}"
           readOnly="{Binding Path=Form.HospitalShortNameReadOnly}"
           partStylesEnabled="true"/>
    <field name="Document"
           type="text"
           value="{Binding Path=Document}"
           label="{Binding Path=Text.ModeDocumentLabel}"
           fieldStyle="{Binding Path=Form.DocumentStyle}"
           onChange="{Binding Path=Commands.DocumentChanged}"
           readOnly="{Binding Path=Form.DocumentReadOnly}"
           partStylesEnabled="false"/>
    <field name="DocumentDate"
           type="text"
           value="{Binding Path=DocumentDate}"
           label="{Binding Path=Text.ModeDocumentDateLabel}"
           fieldStyle="{Binding Path=Form.DocumentDateStyle}"
           readOnly="{Binding Path=Form.DocumentDateReadOnly}"
           partStylesEnabled="false"/>
    <field name="DocumentNumber"
           type="text"
           value="{Binding Path=DocumentNumber}"
           label="{Binding Path=Text.ModeDocumentNumberLabel}"
           fieldStyle="{Binding Path=Form.DocumentNumberStyle}"
           readOnly="{Binding Path=Form.DocumentNumberReadOnly}"
           partStylesEnabled="false"/>
  </fieldCatalog>


  <grid row="2"
        column="2">
    <stackPanel name="ModesPanel"
                row="1"
                column="1"
                orientation="horizontal">
      <stackPanel name="ArrivalModes"
                  rowSpan="7"
                  columnSpan="2"
                  orientation="vertical"
                  horizontalAlignment="stretch">
        <controls:button name="FromTreatment"
                         style="{Binding Path=Settings.FromHospitalStyle}"
                         caption="{Binding Path=Text.FromHospital}"
                         command="{Binding Path=Commands.FromHospital}"/>
        <controls:button name="FromAnnualLeave"
                         style="{Binding Path=Settings.FromAnnualMainVacationStyle}"
                         caption="{Binding Path=Text.FromAnnualMainVacation}"
                         command="{Binding Path=Commands.FromAnnualMainVacation}"/>
        <controls:button name="FromMedicalLeave"
                         style="{Binding Path=Settings.FromVacationForCuringStyle}"
                         caption="{Binding Path=Text.FromVacationForCuring}"
                         command="{Binding Path=Commands.FromVacationForCuring}"/>
        <controls:button name="FromFamilyLeave"
                         style="{Binding Path=Settings.FromVacationForFamilyStyle}"
                         caption="{Binding Path=Text.FromVacationForFamily}"
                         command="{Binding Path=Commands.FromVacationForFamily}"/>
        <controls:button name="FromOutpatient"
                         style="{Binding Path=Settings.FromOutpatientExaminationOrVlkStyle}"
                         caption="{Binding Path=Text.FromOutpatientExaminationOrVlk}"
                         command="{Binding Path=Commands.FromOutpatient}"/>
        <controls:button name="FromMedicalCompany"
                         style="{Binding Path=Settings.FromMedicalCompanyForTreatmentStyle}"
                         caption="{Binding Path=Text.FromMedicalCompanyForTreatment}"
                         command="{Binding Path=Commands.FromMedicalCompany}"/>
        <controls:button name="FromBusinessTrip"
                         style="{Binding Path=Settings.FromBusinessTripStyle}"
                         caption="{Binding Path=Text.FromBusinessTrip}"
                         command="{Binding Path=Commands.FromBusinessTrip}"/>
      </stackPanel>
      <stackPanel name="DepartureModes"
                  rowSpan="7"
                  columnSpan="2"
                  orientation="vertical"
                  horizontalAlignment="stretch">
        <controls:button name="ToTreatment"
                         style="{Binding Path=Settings.ToHospitalStyle}"
                         caption="{Binding Path=Text.ToHospital}"
                         command="{Binding Path=Commands.ToHospital}"/>
        <controls:button name="ToAnnualLeave"
                         style="{Binding Path=Settings.ToAnnualMainVacationStyle}"
                         caption="{Binding Path=Text.ToAnnualMainVacation}"
                         command="{Binding Path=Commands.ToAnnualMainVacation}"/>
        <controls:button name="ToMedicalLeave"
                         style="{Binding Path=Settings.ToVacationForCuringStyle}"
                         caption="{Binding Path=Text.ToVacationForCuring}"
                         command="{Binding Path=Commands.ToVacationForCuring}"/>
        <controls:button name="ToFamilyLeave"
                         style="{Binding Path=Settings.ToVacationForFamilyStyle}"
                         caption="{Binding Path=Text.ToVacationForFamily}"
                         command="{Binding Path=Commands.ToVacationForFamily}"/>
        <controls:button name="ToOutpatient"
                         style="{Binding Path=Settings.ToOutpatientExaminationOrVlkStyle}"
                         caption="{Binding Path=Text.ToOutpatientExaminationOrVlk}"
                         command="{Binding Path=Commands.ToOutpatient}"/>
        <controls:button name="ToMedicalCompany"
                         style="{Binding Path=Settings.ToMedicalCompanyForTreatmentStyle}"
                         caption="{Binding Path=Text.ToMedicalCompanyForTreatment}"
                         command="{Binding Path=Commands.ToMedicalCompany}"/>
        <controls:button name="ToBusinessTrip"
                         style="{Binding Path=Settings.ToBusinessTripStyle}"
                         caption="{Binding Path=Text.ToBusinessTrip}"
                         command="{Binding Path=Commands.ToBusinessTrip}"/>
      </stackPanel>
      <stackPanel name="StatusModes"
                  rowSpan="7"
                  columnSpan="2"
                  orientation="vertical"
                  horizontalAlignment="stretch">
        <controls:button name="HospitalToLeave"
                         style="{Binding Path=Settings.MoveFromHospitalToVacationForCuringStyle}"
                         caption="{Binding Path=Text.MoveFromHospitalToVacationForCuring}"
                         command="{Binding Path=Commands.HospitalToLeave}"/>
        <controls:button name="AnnualToMedicalLeave"
                         style="{Binding Path=Settings.MoveFromAnnualVacationToVacationForCuringStyle}"
                         caption="{Binding Path=Text.MoveFromAnnualVacationToVacationForCuring}"
                         command="{Binding Path=Commands.AnnualToMedicalLeave}"/>
        <controls:button name="MedicalLeaveExtend"
                         style="{Binding Path=Settings.MoveFromVacationForCuringToVacationForCuringStyle}"
                         caption="{Binding Path=Text.MoveFromVacationForCuringToVacationForCuring}"
                         command="{Binding Path=Commands.MedicalLeaveExtend}"/>
        <controls:button name="FamilyToMedicalLeave"
                         style="{Binding Path=Settings.MoveFromFamilyVacationToVacationForCuringStyle}"
                         caption="{Binding Path=Text.MoveFromFamilyVacationToVacationForCuring}"
                         command="{Binding Path=Commands.FamilyToMedicalLeave}"/>
        <controls:button name="OutpatientToMedicalLeave"
                         style="{Binding Path=Settings.MoveFromOutpatientVlkToVacationForCuringStyle}"
                         caption="{Binding Path=Text.MoveFromOutpatientVlkToVacationForCuring}"
                         command="{Binding Path=Commands.OutpatientToMedicalLeave}"/>
        <controls:button name="MedCompanyToMedicalLeave"
                         style="{Binding Path=Settings.MoveFromMedicalCompanyForTreatmentToVacationForCuringStyle}"
                         caption="{Binding Path=Text.MoveFromMedicalCompanyForTreatmentToVacationForCuring}"
                         command="{Binding Path=Commands.MedCompanyToMedicalLeave}"/>
        <controls:button name="ToBusinessTripAwol"
                         style="{Binding Path=Settings.MoveFromAwolToBusinessTripStyle}"
                         caption="{Binding Path=Text.MoveFromAwolToBusinessTrip}"
                         command="{Binding Path=Commands.ToBusinessTripAwol}"/>
      </stackPanel>
      <stackPanel name="DummyModes2"
                  rowSpan="7"
                  columnSpan="2"
                  orientation="vertical"
                  horizontalAlignment="stretch">
        <controls:button name="MedicalLeaveToHospital"
                         style="{Binding Path=Settings.MoveFromVacationForCuringToHospitalStyle}"
                         caption="{Binding Path=Text.MoveFromVacationForCuringToHospital}"
                         command="{Binding Path=Commands.MedicalLeaveToHospital}"/>
        <controls:button name="MedicalLeaveToAnnual"
                         style="{Binding Path=Settings.MoveFromVacationForCuringToAnnualVacationStyle}"
                         caption="{Binding Path=Text.MoveFromVacationForCuringToAnnualVacation}"
                         command="{Binding Path=Commands.MedicalLeaveToAnnual}"/>
        <controls:select name="ExtendedModes"
                         itemsSource="{Binding Path=Data.ExtendedModes}"
                         style="{Binding Path=Settings.ExtendedModeStyle}"
                         value="{Binding Path=Form.ExtendedMode}"
                         placeholder="{Binding Path=Text.ExtendedModes}"
                         panelStyle="formSelectPanel"
                         itemStyle="formSelectItem"
                         itemHeight="25"
                         onChange="{Binding Path=Commands.ExtendedModeChanged}"/>
      </stackPanel>
    </stackPanel>
    <controls:label name="OrderQueryLabel"
                    row="1"
                    column="9"
                    columnSpan="2"
                    style="formLabel"
                    text="{Binding Path=Text.OrderQueryLabel}"/>
    <controls:select name="OrderQuery"
                     itemsSource="{Binding Path=Data.OrderOptions}"
                     row="2"
                     column="9"
                     columnSpan="2"
                     style="lookupKeyField"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"
                     value="{Binding Path=Form.OrderQuery}"
                     editable="true"
                     shapeWidth="1/6"
                     shapeHeight="1"
                     shapeHorizontalAlignment="right"
                     shapeVerticalAlignment="center"
                     highlightValue="{Binding Path=Data.TodayOrderOptions}"
                     highlightStyle="currentOrderItem"
                     itemHeight="20"
                     onChange="{Binding Path=Commands.OrderQueryChanged}"/>
    <controls:label name="OrderYearLabel"
                    row="1"
                    column="11"
                    columnSpan="2"
                    style="formLabel"
                    text="{Binding Path=Text.OrderYearLabel}"/>
    <controls:input name="OrderYear"
                    row="2"
                    column="11"
                    columnSpan="2"
                    style="lookupKeyField"
                    value="{Binding Path=Form.OrderYear}"
                    onChange="{Binding Path=Commands.SearchOrders}"/>
    <controls:checkbox name="AutoFillPersonnel"
                       row="9"
                       column="1"
                       columnSpan="2"
                       style="secondaryButton"
                       value="{Binding Path=Form.AutoFillPersonnel}"
                       caption="{Binding Path=Text.AutoFillPersonnelLabel}"
                       checkedGlyph="{Binding Path=Text.CheckboxChecked}"
                       uncheckedGlyph="{Binding Path=Text.CheckboxUnchecked}"
                       onChange="{Binding Path=Commands.AutoFillPersonnelChanged}"/>
    <controls:button name="ResetForm"
                     row="9"
                     column="3"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ResetForm}"
                     command="{Binding Path=Commands.ResetForm}"/>
    <controls:button name="ScrollFormLeft"
                     row="9"
                     column="5"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ScrollFormLeft}"
                     command="{Binding Path=Commands.ScrollFormLeft}"
                     visibility="{Binding Path=Settings.FormScrollVisibility}"/>
    <controls:button name="ScrollFormRight"
                     row="9"
                     column="6"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ScrollFormRight}"
                     command="{Binding Path=Commands.ScrollFormRight}"
                     visibility="{Binding Path=Settings.FormScrollVisibility}"/>
    <controls:button name="ReinitializePage"
                     row="22"
                     column="20"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ReinitializePage}"
                     command="{Binding Path=Commands.ReinitializePage}"/>
    <controls:button name="EnvironmentSwitch"
                     row="1"
                     column="22"
                     style="secondaryButton"
                     caption="{Binding Path=Text.EnvironmentSwitch}"
                     command="{Binding Path=Commands.EnvironmentSwitch}"
                     shapePlacement="moveAndSize"/>
    <controls:label name="WordPreview"
                    row="3"
                    column="9"
                    rowSpan="7"
                    columnSpan="8"
                    style="wordPreview"
                    text="{Binding Path=Form.WordPreviewText}"/>

    <stackPanel name="EventWorkspace"
                row="10"
                column="1"
                orientation="vertical">
      <stackPanel name="ExtensionMenus"
                  orientation="vertical"
                  contentSource="ExtensionHeader"/>
      <controls:form name="PersonnelForm"
                     dataContext="{Binding Path=Form}"
                     row="1"
                     column="1"
                     columnSpan="18"
                     orientation="horizontal"
                     labelPosition="top"
                     labelStyle="formLabel"
                     fieldStyle="formField"
                     fieldCatalog="EventFields"
                     fieldsSource="{Binding Path=Data.EventFields}"/>

      <stackPanel name="ExtensionRows"
                  orientation="vertical"
                  contentSource="ExtensionBody"/>
      <stackPanel name="RecordPanels"
                  row="1"
                  column="1"
                  orientation="vertical">
        <controls:candidates name="Candidates"
                             itemsSource="{Binding Path=Data.PersonnelCandidates}"
                             detailsSource="{Binding Path=Data.PersonnelCandidateDetails}"
                             textWarningLimit="{Binding Path=Settings.CandidateTextWarningLimit}"
                             textWarningColumn="{Binding Path=Settings.CandidateTextWarningColumn}"
                             column="1"
                             style="candidateTable"
                             visibility="{Binding Path=Form.CandidatesVisibility}"
                             closeCommand="{Binding Path=Commands.CloseCandidates}"
                             closeCaption="{Binding Path=Text.CloseTable}"
                             alignToForm="PersonnelForm"
                             workspaceFirstColumn="1"
                             workspaceLastColumn="18"
                             selectionMode="{Binding Path=Settings.CandidateSelectionMode}"
                             selectedItem="{Binding Path=Data.SelectedPersonnel}"
                             onSelect="{Binding Path=Commands.SelectPersonnel}"
                             partStylesEnabled="true"
                             detailedPartStylesEnabled="true"
                             selectedStyle="candidateSelected"
                             showHeaders="true"/>
        <controls:table name="HistoryEvents"
                        itemsSource="{Binding Path=Data.HistoryEvents}"
                        style="candidateTable"
                        visibility="{Binding Path=Form.HistoryVisibility}"
                        closeCommand="{Binding Path=Commands.CloseHistory}"
                        closeCaption="{Binding Path=Text.CloseTable}"
                        selectionMode="Confirm"
                        selectedItem="{Binding Path=Data.SelectedHistory}"
                        onSelect="{Binding Path=Commands.SelectHistory}"
                        selectedStyle="candidateSelected"
                        showHeaders="true"/>
        <controls:table name="MovementConflicts"
                        itemsSource="{Binding Path=Data.MovementConflicts}"
                        style="candidateTable"
                        visibility="{Binding Path=Form.ConflictsVisibility}"
                        selectionMode="Confirm"
                        selectedColumn="{Binding Path=Form.ConflictColumn}"
                        onSelect="{Binding Path=Commands.SelectConflict}"
                        selectedStyle="candidateSelected"
                        showHeaders="true"/>
      </stackPanel>

    </stackPanel>

    <controls:label name="ActionsSection"
                    row="1"
                    column="20"
                    columnSpan="2"
                    style="sectionTitle"
                    text="{Binding Path=Text.ActionsSection}"/>
    <controls:button name="RefreshPersonnel"
                     row="2"
                     column="20"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.RefreshPersonnel}"
                     command="{Binding Path=Commands.RefreshPersonnel}"/>
    <controls:button name="DeleteLastEvent"
                     row="23"
                     column="20"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.DeleteLastEvent}"
                     command="{Binding Path=Commands.DeleteLastEvent}"/>
    <controls:label name="LastStatusLabel"
                    row="8"
                    column="20"
                    columnSpan="3"
                    style="statusHeading"
                    text="{Binding Path=Text.LastStatus}"/>
    <controls:label name="ActionStatus"
                    row="9"
                    column="20"
                    rowSpan="3"
                    columnSpan="3"
                    style="{Binding Path=Form.ActionStatusStyle}"
                    text="{Binding Path=Form.ActionStatus}"/>
    <controls:button name="ExportMovement"
                     row="4"
                     column="20"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ExportMovement}"
                     command="{Binding Path=Commands.ExportMovement}"/>
    <controls:button name="ExportWord"
                     row="5"
                     column="20"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ExportWord}"
                     command="{Binding Path=Commands.ExportWord}"/>
    <controls:button name="SaveHistory"
                     row="6"
                     column="20"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.SaveHistory}"
                     command="{Binding Path=Commands.SaveHistory}"/>
    <controls:button name="ShowHistory"
                     row="7"
                     column="20"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ShowHistory}"
                     command="{Binding Path=Commands.ShowHistory}"/>
    <controls:label name="HistoryEditMode"
                    row="12"
                    column="20"
                    columnSpan="3"
                    style="statusHeading"
                    text="{Binding Path=Text.HistoryEditMode}"/>
    <controls:label name="SourceLegendTitle"
                    row="14"
                    column="20"
                    columnSpan="3"
                    style="sectionTitle"
                    text="{Binding Path=Text.SourceLegendTitle}"/>
    <controls:label name="SourceLegendPersonnel"
                    row="15"
                    column="22"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendPersonnelEntry}"/>
    <controls:label name="SourceLegendAbsence"
                    row="18"
                    column="22"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendAbsenceEntry}"/>
    <controls:label name="LegendPersonnelSample"
                    row="15"
                    column="20"
                    style="legendSample"
                    text="{Binding Path=Text.SourceLegendSample}"/>
    <controls:label name="LegendPersonnelSeparator"
                    row="15"
                    column="21"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendSeparator}"/>
    <controls:label name="LegendAbsenceSample"
                    row="18"
                    column="20"
                    style="legendSample"
                    text="{Binding Path=Text.SourceLegendSample}"/>
    <controls:label name="LegendAbsenceSeparator"
                    row="18"
                    column="21"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendSeparator}"/>
    <controls:label name="SourceLegendReturnTickets"
                    row="19"
                    column="22"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendReturnTicketsEntry}"/>
    <controls:label name="LegendReturnTicketsSample"
                    row="19"
                    column="20"
                    style="movementTicketField"
                    text="{Binding Path=Text.SourceLegendSample}"/>
    <controls:label name="LegendReturnTicketsSeparator"
                    row="19"
                    column="21"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendSeparator}"/>
    <controls:label name="LegendOrderDateSample"
                    row="20"
                    column="20"
                    style="currentOrderField"
                    text="{Binding Path=Text.SourceLegendSample}"/>
    <controls:label name="LegendOrderDateSeparator"
                    row="20"
                    column="21"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendSeparator}"/>
    <controls:label name="SourceLegendOrderDate"
                    row="20"
                    column="22"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendOrderDate}"/>
    <controls:label name="LegendHospitalSample"
                    row="16"
                    column="20"
                    style="legendSample"
                    text="{Binding Path=Text.SourceLegendSample}"/>
    <controls:label name="LegendHospitalSeparator"
                    row="16"
                    column="21"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendSeparator}"/>
    <controls:label name="SourceLegendHospital"
                    row="16"
                    column="22"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendHospitalEntry}"/>
    <controls:label name="LegendDocumentSample"
                    row="17"
                    column="20"
                    style="legendSample"
                    text="{Binding Path=Text.SourceLegendSample}"/>
    <controls:label name="LegendDocumentSeparator"
                    row="17"
                    column="21"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendSeparator}"/>
    <controls:label name="SourceLegendDocument"
                    row="17"
                    column="22"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendDocumentEntry}"/>
  </grid>

  <styles>
    <controlStyle name="currentOrderField"
                  cellType="text"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#87CEFA"
                  fontColor="#87CEFA"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="legendSample"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="legendDescription"
                  backColor="#262626"
                  textColor="#909090"
                  horizontal="center"
                  vertical="center"
                  overflow="wrap"/>
    <controlStyle name="personnelSource"
                  backColor="#2D2D2D"
                  fontColor="#FFFFFF"/>
    <controlStyle name="absenceSource"
                  backColor="#303A35"
                  fontColor="#F4A46B"/>
    <controlStyle name="movementSource"
                  fontColor="#FFFF00"/>
    <controlStyle name="currentOrderSource"
                  fontColor="#87CEFA"/>
    <controlStyle name="wordPreview"
                  indent="1"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"
                  overflow="wrap"/>
    <controlStyle name="lookupKeyField"
                  cellType="text"
                  backColor="#3A3A3A"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="personnelFormFieldLookup"
                  cellType="text"
                  backColor="#3A3A3A"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="absenceFormFieldLookup"
                  cellType="text"
                  backColor="#3A3A3A"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="movementTicketFieldLookup"
                  cellType="text"
                  backColor="#3A3A3A"
                  textColor="#FFFF00"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="currentOrderFieldLookup"
                  cellType="text"
                  backColor="#3A3A3A"
                  textColor="#87CEFA"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="activeModeButton"
