<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1">
  <grid anchorCell="A1">
    <grid.columnDefinitions>
      <columnDefinition size="1"/>
      <columnDefinition size="auto"/>
      <columnDefinition size="2"/>
      <columnDefinition size="auto"/>
      <columnDefinition size="2"/>
      <columnDefinition size="2"/>
    </grid.columnDefinitions>

    <grid.rowDefinitions>
      <rowDefinition size="auto"/>
      <rowDefinition size="auto"/>
    </grid.rowDefinitions>

    <controls:label name="Title"
                    column="2"
                    columnSpan="5"
                    style="{Binding Path=Resources.PageTitle}"
                    text="{Binding Path=Text.Title}"/>

    <stackPanel row="2"
                column="2"
                orientation="vertical">
      <controls:form name="EventDraftForm"
                     dataContext="{Binding Path=Form}"
                     orientation="vertical"
                     labelPosition="left"
                     labelStyle="formLabel"
                     fieldStyle="formField"
                     onChange="{Binding Path=Commands.FormChangedCommand}">
        <field name="EventName"
               type="text"
               value="{Binding Path=EventName}"
               label="Event name"
               required="true"/>

        <field name="Category"
               type="select"
               itemsSource="{Binding Path=Data.EventTypes}"
               value="{Binding Path=Category}"
               label="Category"
               panelStyle="formSelectPanel"
               itemStyle="formSelectItem"/>

        <field name="Notes"
               type="text"
               value="{Binding Path=Notes}"
               label="Notes"/>

        <controls:button name="SubmitEventDraft"
                         style="primaryButton"
                         caption="Submit form"
                         command="{Binding Path=Commands.SubmitFormCommand}"/>
      </controls:form>

      <stackPanel orientation="vertical"/>

      <controls:form name="PersonnelForm"
                     dataContext="{Binding Path=Form}"
                     orientation="vertical"
                     labelPosition="left"
                     labelStyle="formLabel"
                     fieldStyle="formField">
        <field name="PersonName"
               type="text"
               value="{Binding Path=PersonName}"
               label="{Binding Path=Text.PersonNameLabel}"
               onChange="{Binding Path=Commands.SearchPersonnel}"/>

        <field name="PersonId"
               type="text"
               value="{Binding Path=PersonId}"
               label="{Binding Path=Text.PersonIdLabel}"
               readOnly="true"/>

        <field name="PersonRank"
               type="text"
               value="{Binding Path=PersonRank}"
               label="{Binding Path=Text.PersonRankLabel}"
               readOnly="true"/>

        <field name="PersonPosition"
               type="text"
               value="{Binding Path=PersonPosition}"
               label="{Binding Path=Text.PersonPositionLabel}"
               readOnly="true"/>

        <field name="PersonUnit"
               type="text"
               value="{Binding Path=PersonUnit}"
               label="{Binding Path=Text.PersonUnitLabel}"
               readOnly="true"/>
      </controls:form>

      <stackPanel orientation="vertical"/>

      <controls:tableList name="GeneratedTables"
                          itemsSource="{Binding Path=Data.Tables}"
                          showHeaders="true"
                          gapRows="1"/>
    </stackPanel>

    <stackPanel row="2"
                column="4"
                orientation="vertical">
      <controls:label name="LookupStatus"
                      rowSpan="2"
                      columnSpan="5"
                      style="formField"
                      text="{Binding Path=Text.PersonnelStatus}"/>

      <controls:table name="Candidates"
                      itemsSource="{Binding Path=Data.PersonnelCandidates}"
                      style="candidateTable"
                      selectedItem="{Binding Path=Data.SelectedPersonnel}"
                      onSelect="{Binding Path=Commands.SelectPersonnel}"
                      selectedStyle="candidateSelected"
                      showHeaders="true"/>
    </stackPanel>

    <stackPanel row="2"
                column="6"
                orientation="vertical">
      <controls:button name="UpdatePage"
                       rowSpan="2"
                       columnSpan="2"
                       style="secondaryButton"
                       caption="{Binding Path=Text.UpdatePage}"
                       command="{Binding Path=Commands.UpdatePageCommand}"/>

      <controls:button name="Reset"
                       rowSpan="2"
                       columnSpan="2"
                       style="secondaryButton"
                       caption="{Binding Path=Text.Reset}"
                       command="{Binding Path=Commands.ResetCommand}"/>

      <controls:button name="RefreshPersonnel"
                       rowSpan="2"
                       columnSpan="2"
                       style="secondaryButton"
                       caption="{Binding Path=Text.RefreshPersonnel}"
                       command="{Binding Path=Commands.RefreshPersonnel}"/>
      <controls:button name="GenerateTables"
                       rowSpan="2"
                       columnSpan="2"
                       style="{Binding Path=Resources.PrimaryButton}"
                       caption="{Binding Path=Text.GenerateTables}"
                       command="{Binding Path=Commands.GenerateTablesCommand}"/>
    </stackPanel>
  </grid>

  <styles>
    <controlStyle name="candidateTable"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  borderColor="#444444"
                  borderWeight="thin"
                  vertical="center"/>

    <controlStyle name="candidateSelected"
                  backColor="#375D7A"
                  textColor="#FFFFFF"
                  borderColor="#6A9EC4"
                  borderWeight="thin"
                  vertical="center"/>

    <controlStyle name="pageTitle"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="16"
                  fontBold="true"
                  horizontal="center"
                  vertical="center"/>

    <controlStyle name="formLabel"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  horizontal="right"
                  vertical="center"/>

    <controlStyle name="formField"
                  backColor="#2D2D2D"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>

    <controlStyle name="formSelectPanel"
                  backColor="#2D2D2D"
                  borderColor="#000000"
                  borderWeight="thin"/>

    <controlStyle name="formSelectItem"
                  backColor="#2D2D2D"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  vertical="center"/>

    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{
                backColor:#262626;
                fontColor:#FFFFFF;
                borderColor:#000000;
                borderWeight:thin;
                rowHeight:40;
                overflow:wrap;
                gridLines:false;
                zoom:90%;
              }"/>

        <rule target="column"
              selector="address=A:A"
              styles="{
                width:2;
              }"/>
      </layer>

      <layer name="candidate-columns">
        <rule target="column"
              selector="address=G:G"
              styles="{width:38;}"/>

        <rule target="column"
              selector="address=H:H"
              styles="{width:15;}"/>

        <rule target="column"
              selector="address=I:I"
              styles="{width:18;}"/>

        <rule target="column"
              selector="address=J:J"
              styles="{width:35;}"/>

        <rule target="column"
              selector="address=K:K"
              styles="{width:25;}"/>
      </layer>

      <layer name="layout">
        <rule style="pageTitle"
              target="control"
              selector="style=pageTitle"/>

        <rule style="formLabel"
              target="control"
              selector="style=formLabel"/>

        <rule style="formField"
              target="control"
              selector="style=formField"/>

        <rule style="candidateTable"
              target="control"
              selector="style=candidateTable"/>

        <rule target="control"
              selector="type=button"
              styles="{
                horizontal:center;
                vertical:center;
              }"/>
      </layer>
      <layer name="table-parts">
        <rule target="controlPart"
              selector="type=table;part=header"
              styles="{backColor:#355D8C;fontColor:#FFFFFF;fontBold:true;}"/>

        <rule target="controlPart"
              selector="type=table;part=row;tags=even"
              styles="{backColor:#383838;}"/>

        <rule target="controlPart"
              selector="type=tablelist;part=header"
              styles="{backColor:#355D8C;fontColor:#FFFFFF;fontBold:true;}"/>

        <rule target="controlPart"
              selector="type=tablelist;part=row;tags=even"
              styles="{backColor:#383838;}"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>