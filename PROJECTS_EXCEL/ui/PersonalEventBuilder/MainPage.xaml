<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1"
      zoom="80%">
  <fieldCatalog name="EventFields">
    <field name="Destination"
           type="text"
           value="{Binding Path=Destination}"
           label="{Binding Path=Text.ModeDestinationLabel}"
           readOnly="{Binding Path=Form.AutoFillPersonnel}"/>
    <field name="PersonRank"
           type="text"
           value="{Binding Path=PersonRank}"
           label="{Binding Path=Text.ModePersonRankLabel}"
           readOnly="{Binding Path=Form.AutoFillPersonnel}"/>
    <field name="PersonName"
           type="text"
           value="{Binding Path=PersonName}"
           label="{Binding Path=Text.ModePersonNameLabel}"
           fieldStyle="lookupKeyField"
           onChange="{Binding Path=Commands.PersonNameChanged}"/>
    <field name="PersonId"
           type="text"
           value="{Binding Path=PersonId}"
           label="{Binding Path=Text.ModePersonIdLabel}"
           readOnly="{Binding Path=Form.AutoFillPersonnel}"/>
    <field name="PositionCode"
           type="text"
           value="{Binding Path=PositionCode}"
           label="{Binding Path=Text.ModePositionCodeLabel}"
           readOnly="{Binding Path=Form.AutoFillPersonnel}"/>
    <field name="PersonPosition"
           type="text"
           value="{Binding Path=PersonPosition}"
           label="{Binding Path=Text.ModePersonPositionLabel}"
           readOnly="{Binding Path=Form.AutoFillPersonnel}"/>
    <field name="ReportRank"
           type="text"
           value="{Binding Path=ReportRank}"
           label="{Binding Path=Text.ModeReportRankLabel}"/>
    <field name="ReportName"
           type="text"
           value="{Binding Path=ReportName}"
           label="{Binding Path=Text.ModeReportNameLabel}"
           fieldStyle="lookupKeyField"
           onChange="{Binding Path=Commands.ReportNameChanged}"/>
    <field name="ReportPositionCode"
           type="text"
           value="{Binding Path=ReportPositionCode}"
           label="{Binding Path=Text.ModeReportPositionCodeLabel}"/>
    <field name="IncomingNumber"
           type="text"
           value="{Binding Path=IncomingNumber}"
           label="{Binding Path=Text.ModeIncomingNumberLabel}"/>
    <field name="IncomingDate"
           type="text"
           value="{Binding Path=IncomingDate}"
           label="{Binding Path=Text.ModeIncomingDateLabel}"/>
    <field name="EventDate"
           type="text"
           value="{Binding Path=EventDate}"
           label="{Binding Path=Text.ModeEventDateLabel}"/>
    <field name="TicketNumber"
           type="text"
           value="{Binding Path=TicketNumber}"
           label="{Binding Path=Text.ModeTicketNumberLabel}"
           readOnly="{Binding Path=Form.AutoFillPersonnel}"/>
    <field name="TicketDate"
           type="text"
           value="{Binding Path=TicketDate}"
           label="{Binding Path=Text.ModeTicketDateLabel}"
           readOnly="{Binding Path=Form.AutoFillPersonnel}"/>
    <field name="Hospital"
           type="text"
           value="{Binding Path=Hospital}"
           label="{Binding Path=Text.ModeHospitalLabel}"
           fieldStyle="lookupKeyField"
           onChange="{Binding Path=Commands.HospitalChanged}"/>
    <field name="HospitalShortName"
           type="text"
           value="{Binding Path=HospitalShortName}"
           label="{Binding Path=Text.ModeHospitalShortNameLabel}"/>
    <field name="Document"
           type="text"
           value="{Binding Path=Document}"
           label="{Binding Path=Text.ModeDocumentLabel}"/>
    <field name="DocumentDate"
           type="text"
           value="{Binding Path=DocumentDate}"
           label="{Binding Path=Text.ModeDocumentDateLabel}"/>
    <field name="DocumentNumber"
           type="text"
           value="{Binding Path=DocumentNumber}"
           label="{Binding Path=Text.ModeDocumentNumberLabel}"/>
  </fieldCatalog>

  <formLayouts name="EventLayouts"
               catalog="EventFields">
    <formLayout name="Leave">
      <fieldRef name="Destination"
                columnSpan="1"/>
      <fieldRef name="PersonRank"
                columnSpan="1"/>
      <fieldRef name="PersonName"
                columnSpan="1"/>
      <fieldRef name="PersonId"
                columnSpan="1"/>
      <fieldRef name="PositionCode"
                columnSpan="1"/>
      <fieldRef name="PersonPosition"
                columnSpan="1"/>
      <fieldRef name="ReportRank"
                columnSpan="1"/>
      <fieldRef name="ReportName"
                columnSpan="1"/>
      <fieldRef name="ReportPositionCode"
                columnSpan="1"/>
      <fieldRef name="IncomingNumber"
                columnSpan="1"/>
      <fieldRef name="IncomingDate"
                columnSpan="1"/>
      <fieldRef name="EventDate"
                columnSpan="1"/>
      <fieldRef name="TicketNumber"
                columnSpan="1"/>
      <fieldRef name="TicketDate"
                columnSpan="1"/>
    </formLayout>
    <formLayout name="Treatment">
      <fieldRef name="Hospital"
                columnSpan="1"/>
      <fieldRef name="HospitalShortName"
                columnSpan="1"/>
      <fieldRef name="PersonRank"
                columnSpan="1"/>
      <fieldRef name="PersonName"
                columnSpan="1"/>
      <fieldRef name="PersonId"
                columnSpan="1"/>
      <fieldRef name="PositionCode"
                columnSpan="1"/>
      <fieldRef name="PersonPosition"
                columnSpan="1"/>
      <fieldRef name="ReportRank"
                columnSpan="1"/>
      <fieldRef name="ReportName"
                columnSpan="1"/>
      <fieldRef name="ReportPositionCode"
                columnSpan="1"/>
      <fieldRef name="IncomingNumber"
                columnSpan="1"/>
      <fieldRef name="IncomingDate"
                columnSpan="1"/>
      <fieldRef name="Document"
                columnSpan="1"/>
      <fieldRef name="DocumentDate"
                columnSpan="1"/>
      <fieldRef name="DocumentNumber"
                columnSpan="1"/>
      <fieldRef name="EventDate"
                columnSpan="1"/>
    </formLayout>
  </formLayouts>

  <grid row="2"
        column="2">
    <stackPanel name="ModesPanel"
                row="4"
                column="1"
                orientation="horizontal">
      <stackPanel name="ArrivalModes"
                  rowSpan="5"
                  columnSpan="2"
                  orientation="vertical"
                  horizontalAlignment="stretch">
        <controls:button name="FromTreatment"
                         style="{Binding Path=Settings.ArrivalTreatmentStyle}"
                         caption="{Binding Path=Text.ArrivalTreatment}"
                         command="{Binding Path=Commands.ArrivalTreatment}"/>
        <controls:button name="FromAnnualLeave"
                         style="{Binding Path=Settings.ArrivalAnnualLeaveStyle}"
                         caption="{Binding Path=Text.ArrivalAnnualLeave}"
                         command="{Binding Path=Commands.ArrivalAnnualLeave}"/>
        <controls:button name="FromMedicalLeave"
                         style="{Binding Path=Settings.ArrivalMedicalLeaveStyle}"
                         caption="{Binding Path=Text.ArrivalMedicalLeave}"
                         command="{Binding Path=Commands.ArrivalMedicalLeave}"/>
        <controls:button name="FromFamilyLeave"
                         style="{Binding Path=Settings.ArrivalFamilyLeaveStyle}"
                         caption="{Binding Path=Text.ArrivalFamilyLeave}"
                         command="{Binding Path=Commands.ArrivalFamilyLeave}"/>
      </stackPanel>
      <stackPanel name="DepartureModes"
                  rowSpan="5"
                  columnSpan="2"
                  orientation="vertical"
                  horizontalAlignment="stretch">
        <controls:button name="ToTreatment"
                         style="{Binding Path=Settings.DepartureTreatmentStyle}"
                         caption="{Binding Path=Text.DepartureTreatment}"
                         command="{Binding Path=Commands.DepartureTreatment}"/>
        <controls:button name="ToAnnualLeave"
                         style="{Binding Path=Settings.DepartureAnnualLeaveStyle}"
                         caption="{Binding Path=Text.DepartureAnnualLeave}"
                         command="{Binding Path=Commands.DepartureAnnualLeave}"/>
        <controls:button name="ToMedicalLeave"
                         style="{Binding Path=Settings.DepartureMedicalLeaveStyle}"
                         caption="{Binding Path=Text.DepartureMedicalLeave}"
                         command="{Binding Path=Commands.DepartureMedicalLeave}"/>
        <controls:button name="ToFamilyLeave"
                         style="{Binding Path=Settings.DepartureFamilyLeaveStyle}"
                         caption="{Binding Path=Text.DepartureFamilyLeave}"
                         command="{Binding Path=Commands.DepartureFamilyLeave}"/>
      </stackPanel>
      <stackPanel name="DummyModes1"
                  rowSpan="5"
                  columnSpan="2"
                  orientation="vertical"
                  horizontalAlignment="stretch">
        <controls:button name="DummyMode11"
                         style="disabledButton"
                         caption="{Binding Path=Text.DummyMode}"
                         command="{Binding Path=Commands.DummyMode11}"/>
        <controls:button name="DummyMode12"
                         style="disabledButton"
                         caption="{Binding Path=Text.DummyMode}"
                         command="{Binding Path=Commands.DummyMode12}"/>
        <controls:button name="DummyMode13"
                         style="disabledButton"
                         caption="{Binding Path=Text.DummyMode}"
                         command="{Binding Path=Commands.DummyMode13}"/>
        <controls:button name="DummyMode14"
                         style="disabledButton"
                         caption="{Binding Path=Text.DummyMode}"
                         command="{Binding Path=Commands.DummyMode14}"/>
      </stackPanel>
      <stackPanel name="DummyModes2"
                  rowSpan="5"
                  columnSpan="2"
                  orientation="vertical"
                  horizontalAlignment="stretch">
        <controls:button name="DummyMode21"
                         style="disabledButton"
                         caption="{Binding Path=Text.DummyMode}"
                         command="{Binding Path=Commands.DummyMode21}"/>
        <controls:button name="DummyMode22"
                         style="disabledButton"
                         caption="{Binding Path=Text.DummyMode}"
                         command="{Binding Path=Commands.DummyMode22}"/>
        <controls:button name="DummyMode23"
                         style="disabledButton"
                         caption="{Binding Path=Text.DummyMode}"
                         command="{Binding Path=Commands.DummyMode23}"/>
        <controls:button name="DummyMode24"
                         style="disabledButton"
                         caption="{Binding Path=Text.DummyMode}"
                         command="{Binding Path=Commands.DummyMode24}"/>
      </stackPanel>
    </stackPanel>
    <controls:label name="OrderQueryLabel"
                    row="1"
                    column="1"
                    columnSpan="4"
                    style="formLabel"
                    text="{Binding Path=Text.OrderQueryLabel}"/>
    <controls:select name="OrderQuery"
                     itemsSource="{Binding Path=Data.OrderOptions}"
                     row="2"
                     column="1"
                     columnSpan="4"
                     style="lookupKeyField"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"
                     value="{Binding Path=Form.OrderQuery}"
                     editable="true"
                     shapeWidth="1/12"
                     shapeHeight="1"
                     shapeHorizontalAlignment="right"
                     shapeVerticalAlignment="center"
                     highlightValue="{Binding Path=Data.TodayOrderOptions}"
                     highlightStyle="currentOrderItem"
                     itemHeight="20"
                     onChange="{Binding Path=Commands.OrderQueryChanged}"/>
    <controls:label name="OrderYearLabel"
                    row="1"
                    column="5"
                    columnSpan="2"
                    style="formLabel"
                    text="{Binding Path=Text.OrderYearLabel}"/>
    <controls:input name="OrderYear"
                    row="2"
                    column="5"
                    columnSpan="2"
                    style="lookupKeyField"
                    value="{Binding Path=Form.OrderYear}"
                    onChange="{Binding Path=Commands.SearchOrders}"/>
    <controls:label name="AcceptedOrder"
                    row="1"
                    column="7"
                    rowSpan="2"
                    columnSpan="10"
                    style="statusText"
                    text="{Binding Path=Form.AcceptedOrderText}"/>
    <controls:label name="WordPreview"
                    row="3"
                    column="9"
                    rowSpan="7"
                    columnSpan="8"
                    style="wordPreview"
                    text="{Binding Path=Form.WordPreviewText}"/>

    <controls:label name="PersonnelSection"
                    row="10"
                    column="1"
                    columnSpan="16"
                    style="sectionTitle"
                    text="{Binding Path=Text.PersonnelSection}"/>

    <controls:form name="PersonnelForm"
                   dataContext="{Binding Path=Form}"
                   row="11"
                   column="1"
                   columnSpan="16"
                   orientation="horizontal"
                   labelPosition="top"
                   labelStyle="formLabel"
                   fieldStyle="formField"
                   layoutSource="EventLayouts"
                   layout="{Binding Path=Form.ModeForm}"/>

    <controls:candidates name="Candidates"
                         itemsSource="{Binding Path=Data.PersonnelCandidates}"
                         row="14"
                         column="1"
                         style="candidateTable"
                         alignToForm="PersonnelForm"
                         workspaceFirstColumn="1"
                         workspaceLastColumn="16"
                         selectionMode="{Binding Path=Settings.CandidateSelectionMode}"
                         selectedItem="{Binding Path=Data.SelectedPersonnel}"
                         onSelect="{Binding Path=Commands.SelectPersonnel}"
                         selectedStyle="candidateSelected"
                         showHeaders="true"/>

    <controls:label name="ActionsSection"
                    row="1"
                    column="18"
                    columnSpan="3"
                    style="sectionTitle"
                    text="{Binding Path=Text.ActionsSection}"/>
    <controls:button name="RefreshPersonnel"
                     row="2"
                     column="18"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.RefreshPersonnel}"
                     command="{Binding Path=Commands.RefreshPersonnel}"/>
    <controls:checkbox name="AutoFillPersonnel"
                       row="3"
                       column="18"
                       columnSpan="3"
                       style="secondaryButton"
                       value="{Binding Path=Form.AutoFillPersonnel}"
                       caption="{Binding Path=Text.AutoFillPersonnelLabel}"
                       checkedGlyph="{Binding Path=Text.CheckboxChecked}"
                       uncheckedGlyph="{Binding Path=Text.CheckboxUnchecked}"
                       onChange="{Binding Path=Commands.AutoFillPersonnelChanged}"/>
    <controls:label name="LastStatusLabel"
                    row="7"
                    column="18"
                    columnSpan="3"
                    style="statusHeading"
                    text="{Binding Path=Text.LastStatus}"/>
    <controls:label name="ActionStatus"
                    row="8"
                    column="18"
                    rowSpan="3"
                    columnSpan="3"
                    style="{Binding Path=Form.ActionStatusStyle}"
                    text="{Binding Path=Form.ActionStatus}"/>
    <controls:button name="PreviewWord"
                     row="4"
                     column="18"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.PreviewWord}"
                     command="{Binding Path=Commands.PreviewWord}"/>
    <controls:button name="ExportMovement"
                     row="6"
                     column="18"
                     columnSpan="3"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ExportMovement}"
                     command="{Binding Path=Commands.ExportMovement}"/>
    <controls:label name="SourceLegendTitle"
                    row="14"
                    column="18"
                    columnSpan="3"
                    style="sectionTitle"
                    text="{Binding Path=Text.SourceLegendTitle}"/>
    <controls:label name="SourceLegendPersonnel"
                    row="15"
                    column="20"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendPersonnelEntry}"/>
    <controls:label name="SourceLegendAbsence"
                    row="16"
                    column="20"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendAbsenceEntry}"/>
    <controls:label name="LegendPersonnelSample"
                    row="15"
                    column="18"
                    style="legendSample"
                    text="{Binding Path=Text.SourceLegendSample}"/>
    <controls:label name="LegendPersonnelSeparator"
                    row="15"
                    column="19"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendSeparator}"/>
    <controls:label name="LegendAbsenceSample"
                    row="16"
                    column="18"
                    style="legendSample"
                    text="{Binding Path=Text.SourceLegendSample}"/>
    <controls:label name="LegendAbsenceSeparator"
                    row="16"
                    column="19"
                    style="legendDescription"
                    text="{Binding Path=Text.SourceLegendSeparator}"/>
  </grid>

  <styles>
    <controlStyle name="legendSample"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="legendDescription"
                  backColor="#262626"
                  textColor="#909090"
                  horizontal="center"
                  vertical="center"
                  overflow="wrap"/>
    <controlStyle name="personnelSource"
                  backColor="#2D2D2D"
                  fontColor="#FFFFFF"/>
    <controlStyle name="absenceSource"
                  backColor="#303A35"
                  fontColor="#F4A46B"/>
    <controlStyle name="wordPreview"
                  indent="1"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"
                  overflow="wrap"/>
    <controlStyle name="lookupKeyField"
                  cellType="text"
                  backColor="#3A3A3A"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="activeModeButton"
                  backColor="#375D7A"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="currentOrderItem"
                  backColor="#375D7A"/>
    <controlStyle name="statusHeading"
                  indent="1"
                  backColor="#2D2D2D"
                  textColor="#999999"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="actionSuccess"
                  indent="1"
                  backColor="#262626"
                  textColor="#909090"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"/>
    <controlStyle name="actionError"
                  indent="1"
                  backColor="#262626"
                  textColor="#FFD966"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"/>
    <controlStyle name="disabledButton"
                  backColor="#333333"
                  textColor="#777777"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="sectionTitle"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="searchLabel"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formLabel"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formField"
                  cellType="text"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="statusText"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="candidateTable"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="candidateSelected"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#375D7A"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#6A9EC4"
                  borderWeight="thin"
                  borderScope="outline"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="secondaryButton"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#3B3B3B"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formSelectPanel"
                  shadow="true"
                  shadowColor="#000000"
                  shadowBlur="6"
                  shadowTransparency="0.55"
                  shadowOffsetX="3"
                  shadowOffsetY="3"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#383838"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="formSelectItem"
                  shadow="false"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#383838"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{
                backColor:#262626;
                fontColor:#FFFFFF;
                fontName:Calibri;
                fontSize:11;
                borderColor:#000000;
                borderWeight:thin;
                rowHeight:30;
                overflow:wrap;
                gridLines:true;
              }"/>
        <rule target="column"
              selector="address=A:A"
              styles="{
                width:2;
              }"/>
        <rule target="column"
              selector="address=B:Q"
              styles="{
                width:15;
              }"/>
        <rule target="column"
              selector="address=R:R"
              styles="{
                width:2;
              }"/>
        <rule target="column"
              selector="address=S:S"
              styles="{
                width:15;
              }"/>
        <rule target="column"
              selector="address=T:T"
              styles="{width:3;}"/>
        <rule target="column"
              selector="address=U:U"
              styles="{width:15;}"/>
      </layer>
      <layer name="table-parts">
        <rule target="usedRange"
              selector="row=13"
              styles="{
                rowHeight:45;
              }"/>
        <rule target="usedRange"
              selector="row=16:"
              styles="{
                rowHeight:45;
              }"/>
        <rule target="control"
              selector="name=OrderQuery"
              styles="{
                cellType:text;
              }"/>
        <rule target="control"
              selector="name=OrderYear"
              styles="{
                cellType:text;
              }"/>
        <rule target="control"
              selector="name=PersonId_input"
              styles="{
                cellType:text;
              }"/>
        <rule target="controlPart"
              selector="type=candidates;part=header"
              styles="{
                backColor:#3A3A3A;
                fontColor:#FFFFFF;
                fontBold:true;
                horizontal:center;
                vertical:center;
              }"/>
        <rule target="controlPart"
              selector="type=candidates;part=row;tags=even"
              styles="{
                backColor:#383838;
              }"/>
        <rule target="controlPart"
              selector="type=tablelist;part=header"
              styles="{
                backColor:#355D8C;
                fontColor:#FFFFFF;
                fontBold:true;
                horizontal:center;
                vertical:center;
              }"/>
        <rule target="controlPart"
              selector="type=tablelist;part=row;tags=even"
              styles="{
                backColor:#383838;
              }"/>
      </layer>
      <layer name="candidate-sources">
        <rule target="control"
              selector="name=SourceLegendTitle"
              styles="{fontColor:#909090;}"/>
        <rule target="control"
              selector="name=LegendPersonnelSample"
              style="personnelSource"/>
        <rule target="control"
              selector="name=LegendAbsenceSample"
              style="absenceSource"/>
        <rule target="controlPart"
              selector="type=candidates;part=rows;sourceAlias=Personnel"
              style="personnelSource"/>
        <rule target="controlPart"
              selector="type=candidates;part=rows;sourceAlias=Absence"
              style="absenceSource"/>
        <rule target="controlPart"
              selector="type=candidates;part=rows;sourceAlias=Personnel;tags=even"
              styles="{
                backColor:#383838;
              }"/>
        <rule target="controlPart"
              selector="type=candidates;part=rows;sourceAlias=Absence;tags=even"
              styles="{
                backColor:#39473D;
              }"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>