<?xml version="1.0" encoding="UTF-8"?>
<styles xmlns="urn:excelprototype:profiles">
  <controlStyle name="workbook"
                tableStyle="TableStyleDark1"
                nativeTableStyle="TableStyleDark_my"
                showGridLines="false"/>
  <controlStyle name="body"
                backColor="#303030"
                textColor="#FFFFFF"
                fontName="Times New Roman"
                fontSize="12"
                vertical="center"
                overflow="wrap"/>
  <controlStyle name="header"
                basedOn="body"
                backColor="#151515"
                fontBold="true"
                horizontal="center"/>
  <controlStyle name="tableBody"
                basedOn="body"
                columnWidth="21"
                rowHeight="38"/>
  <controlStyle name="tableHeader"
                basedOn="header"
                rowHeight="60"/>
  <controlStyle name="registryBody"
                basedOn="body"
                columnWidth="28"
                rowHeight="38"/>
  <controlStyle name="inputBody"
                basedOn="body"
                columnWidth="20"
                rowHeight="62"/>
  <controlStyle name="inputMetadata"
                columnWidth="18"/>
  <controlStyle name="inputText"
                columnWidth="35"/>
  <controlStyle name="inputLongText"
                columnWidth="55"/>
  <controlStyle name="nativeDestination"
                columnWidth="55"
                overflow="wrap"/>
  <controlStyle name="nativeRows"
                rowHeight="80"/>
  <controlStyle name="wordBody"
                basedOn="body"
                vertical="top"/>
  <controlStyle name="wordLongRows"
                rowHeight="210"/>
  <controlStyle name="wordRows"
                rowHeight="175"/>
  <controlStyle name="wordErrorRow"
                rowHeight="75"/>
  <controlStyle name="wordText"
                columnWidth="100"/>
  <controlStyle name="wordError"
                columnWidth="60"/>
  <controlStyle name="topAligned"
                vertical="top"/>
  <controlStyle name="code"
                columnWidth="28"/>
  <controlStyle name="recordName"
                columnWidth="32"/>
  <controlStyle name="report"
                columnWidth="24"/>
  <controlStyle name="sectionTitle"
                textColor="#202020"
                fontName="Times New Roman"
                fontSize="12"
                fontBold="true"/>
  <controlStyle name="expectedRowsCaption"
                basedOn="body"
                textColor="#FF9B5E"
                fontBold="true"
                horizontal="left"/>
  <controlStyle name="centered"
                horizontal="center"/>
  <controlStyle name="date"
                horizontal="center"
                numberFormat="dd\.mm\.yyyy"/>
  <controlStyle name="nativeDate"
                numberFormat="dd.mm.yyyy"/>
</styles>