<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1">
  <grid row="2"
        column="2">

    <controls:label name="PersonnelSection"
                    row="1"
                    column="1"
                    columnSpan="2"
                    style="sectionTitle"
                    text="{Binding Path=Text.PersonnelSection}"/>

    <controls:label name="PersonNameLabel"
                    row="3"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.PersonNameLabel}"/>

    <controls:input name="PersonName"
                    row="3"
                    column="2"
                    style="formField"
                    value="{Binding Path=Form.PersonName}"
                    onFocus="{Binding Path=Commands.FocusPersonnel}"
                    onChange="{Binding Path=Commands.PersonNameChanged}"/>

    <controls:label name="PersonIdLabel"
                    row="4"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.PersonIdLabel}"/>

    <controls:input name="PersonId"
                    row="4"
                    column="2"
                    style="formField"
                    value="{Binding Path=Form.PersonId}"
                    onFocus="{Binding Path=Commands.FocusPersonnel}"/>

    <controls:label name="PersonRankLabel"
                    row="2"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.PersonRankLabel}"/>

    <controls:input name="PersonRank"
                    row="2"
                    column="2"
                    style="formField"
                    value="{Binding Path=Form.PersonRank}"/>

    <controls:label name="PersonPositionCodeLabel"
                    row="5"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.PersonPositionCodeLabel}"/>

    <controls:input name="PersonPositionCode"
                    row="5"
                    column="2"
                    style="formField"
                    value="{Binding Path=Form.PersonPositionCode}"/>

    <controls:label name="PersonPositionLabel"
                    row="6"
                    column="1"
                    rowSpan="2"
                    style="formLabel"
                    text="{Binding Path=Text.PersonPositionLabel}"/>

    <controls:input name="PersonPosition"
                    row="6"
                    column="2"
                    rowSpan="2"
                    style="formField"
                    value="{Binding Path=Form.PersonPosition}"/>

    <controls:label name="PersonUnitLabel"
                    row="8"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.PersonUnitLabel}"/>

    <controls:input name="PersonUnit"
                    row="8"
                    column="2"
                    style="formField"
                    value="{Binding Path=Form.PersonUnit}"/>

    <controls:label name="DocumentSection"
                    row="10"
                    column="1"
                    columnSpan="2"
                    style="sectionTitle"
                    text="{Binding Path=Text.DocumentSection}"/>

    <controls:label name="VacationKindLabel"
                    row="11"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.VacationKind}"/>

    <controls:select name="VacationKind"
                     itemsSource="{Binding Path=Data.VacationKinds}"
                     row="11"
                     column="2"
                     style="formField"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"
                     value="{Binding Path=Form.VacationKind}"/>

    <controls:label name="VacationStatusLabel"
                    row="12"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.VacationStatus}"/>

    <controls:select name="VacationStatus"
                     itemsSource="{Binding Path=Data.StatusOptions}"
                     row="12"
                     column="2"
                     style="formField"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"
                     value="{Binding Path=Form.VacationStatus}"/>

    <controls:label name="DocumentTargetLabel"
                    row="13"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.DocumentTargetLabel}"/>

    <controls:input name="DocumentTarget"
                    row="13"
                    column="2"
                    style="formField"
                    value="{Binding Path=Form.DocumentTarget}"/>

    <controls:label name="OrderReferenceLabel"
                    row="14"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.OrderReference}"/>

    <controls:input name="OrderReference"
                     row="14"
                     column="2"
                     style="formField"
                     value="{Binding Path=Form.OrderReference}"/>

    <controls:label name="DepartureDateLabel"
                    row="15"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.DepartureDateLabel}"/>

    <controls:select name="DepartureDate"
                    itemsSource="{Binding Path=Data.DepartureDates}"
                    row="15"
                    column="2"
                    style="formField"
                    value="{Binding Path=Form.DepartureDate}"
                    editable="true"
                    highlightValue="{Binding Path=Data.CurrentDate}"
                    highlightStyle="currentDateItem"
                    itemHeight="20"
                    panelStyle="formSelectPanel"
                    itemStyle="formSelectItem"
                    onChange="{Binding Path=Commands.VacationDatesChanged}"/>

    <controls:label name="VacationDaysLabel"
                    row="16"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.VacationDays}"/>

    <controls:input name="VacationDays"
                     row="16"
                     column="2"
                     style="formField"
                     value="{Binding Path=Form.VacationDays}"
                     onChange="{Binding Path=Commands.VacationDatesChanged}"/>

    <controls:label name="RoadDaysLabel"
                    row="17"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.RoadDays}"/>

    <controls:input name="RoadDays"
                     row="17"
                     column="2"
                     style="formField"
                     value="{Binding Path=Form.RoadDays}"
                     onChange="{Binding Path=Commands.VacationDatesChanged}"/>

    <controls:label name="DonationDaysLabel"
                    row="18"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.DonationDays}"/>

    <controls:input name="DonationDays"
                     row="18"
                     column="2"
                     style="formField"
                     value="{Binding Path=Form.DonationDays}"
                     onChange="{Binding Path=Commands.VacationDatesChanged}"/>

    <controls:label name="VacationAbroadLabel"
                    row="19"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.VacationAbroad}"/>

    <controls:select name="VacationAbroad"
                     itemsSource="{Binding Path=Data.AbroadOptions}"
                     row="19"
                     column="2"
                     style="formField"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"
                     value="{Binding Path=Form.VacationAbroad}"/>

    <controls:label name="TvoNameLabel"
                    row="20"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.TvoName}"/>

    <controls:input name="TvoName"
                    row="20"
                    column="2"
                    style="formField"
                    value="{Binding Path=Form.TvoName}"
                    onFocus="{Binding Path=Commands.FocusTvo}"/>

    <controls:label name="TvoIpnLabel"
                    row="21"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.TvoIpn}"/>

    <controls:input name="TvoIpn"
                    row="21"
                    column="2"
                    style="formField"
                    value="{Binding Path=Form.TvoIpn}"
                    onFocus="{Binding Path=Commands.FocusTvo}"/>

    <controls:label name="TvoPositionLabel"
                    row="22"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.TvoPosition}"/>

    <controls:input name="TvoPosition"
                    row="22"
                    column="2"
                    style="formField"
                    value="{Binding Path=Form.TvoPosition}"
                    onFocus="{Binding Path=Commands.FocusTvo}"/>

    <controls:label name="PurposeLabel"
                    row="23"
                    column="1"
                    rowSpan="2"
                    style="formLabel"
                    text="{Binding Path=Text.PurposeLabel}"/>

    <controls:input name="Purpose"
                    row="23"
                    column="2"
                    rowSpan="2"
                    style="formField"
                    value="{Binding Path=Form.Purpose}"/>

    <controls:label name="TemplatePathLabel"
                    row="25"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.TemplatePath}"/>

    <controls:input name="TemplatePath"
                     row="25"
                     column="2"
                     style="formField"
                     value="{Binding Path=Form.TemplatePath}"/>

    <controls:label name="OutputFolderPathLabel"
                    row="26"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.OutputFolderPath}"/>

    <controls:input name="OutputFolderPath"
                     row="26"
                     column="2"
                     style="formField"
                     value="{Binding Path=Form.OutputFolderPath}"/>

    <controls:label name="DocumentTypeLabel"
                    row="9"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.DocumentTypeLabel}"/>

    <controls:select name="DocumentType"
                     itemsSource="{Binding Path=Data.DocumentTypes}"
                     row="9"
                     column="2"
                     style="formField"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"
                     value="{Binding Path=Form.DocumentType}"
                     onChange="{Binding Path=Commands.DocumentTypeChanged}"/>

    <controls:button name="CreateDocument"
                     row="4"
                     column="10"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.CreateDocument}"
                     command="{Binding Path=Commands.CreateDocument}"/>

    <controls:button name="UpdateDocument"
                     row="6"
                     column="10"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.UpdateDocument}"
                     command="{Binding Path=Commands.UpdateDocument}"/>

    <controls:label name="TicketNoLabel"
                    row="8"
                    column="10"
                    columnSpan="2"
                    style="formLabel"
                    text="{Binding Path=Text.TicketNo}"/>

    <controls:label name="TicketNo"
                    row="9"
                    column="10"
                    columnSpan="2"
                    style="formField"
                    text="{Binding Path=Form.TicketNo}"/>

    <controls:label name="DocumentPathLabel"
                    row="11"
                    column="10"
                    columnSpan="2"
                    style="formLabel"
                    text="{Binding Path=Text.DocumentPath}"/>

    <controls:label name="DocumentPath"
                    row="12"
                    column="10"
                    rowSpan="4"
                    columnSpan="2"
                    style="formField"
                    text="{Binding Path=Form.DocumentPath}"/>

    <controls:label name="GenerationStatus"
                    row="17"
                    column="10"
                    rowSpan="5"
                    columnSpan="2"
                    style="{Binding Path=Form.GenerationStatusStyle}"
                    text="{Binding Path=Form.GenerationStatus}"/>

    <controls:label name="SearchSection"
                    row="1"
                    column="4"
                    columnSpan="5"
                    style="sectionTitle"
                    text="{Binding Path=Text.SearchSection}"/>

    <controls:label name="SearchLabel"
                    row="2"
                    column="4"
                    style="searchLabel"
                    text="{Binding Path=Text.SearchLabel}"/>

    <controls:input name="PersonnelQuery"
                    row="2"
                    column="5"
                    columnSpan="4"
                    style="formField"
                    value="{Binding Path=Form.PersonnelQuery}"
                    onChange="{Binding Path=Commands.SearchPersonnel}"/>

    <controls:checkbox name="AutoFillPersonnel"
                       row="3"
                       column="4"
                       columnSpan="2"
                       style="personnelCheckbox"
                       value="{Binding Path=Form.AutoFillPersonnel}"
                         caption="{Binding Path=Text.AutoFillPersonnelLabel}"
                         checkedGlyph="{Binding Path=Text.CheckboxChecked}"
                         uncheckedGlyph="{Binding Path=Text.CheckboxUnchecked}"/>

    <controls:label name="CandidateCount"
                    row="5"
                    column="7"
                    columnSpan="2"
                    style="statusText"
                    text="{Binding Path=Text.CandidateCount}"/>

    <controls:label name="ActionsSection"
                    row="1"
                    column="10"
                    columnSpan="2"
                    style="sectionTitle"
                    text="{Binding Path=Text.ActionsSection}"/>

    <controls:button name="RefreshPersonnel"
                     row="2"
                     column="10"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.RefreshPersonnel}"
                     command="{Binding Path=Commands.RefreshPersonnel}"/>

    <controls:button name="LookupTarget"
                     row="3"
                     column="6"
                     columnSpan="3"
                     style="lookupToggle"
                     caption="{Binding Path=Text.LookupTargetCaption}"
                     command="{Binding Path=Commands.ToggleLookupTarget}"/>

    <controls:button name="ClearTvo"
                     row="23"
                     column="10"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ClearTvo}"
                     command="{Binding Path=Commands.ClearTvo}"/>

    <controls:label name="LookupStatus"
                    row="4"
                    column="4"
                    columnSpan="5"
                    style="statusText"
                    text="{Binding Path=Text.PersonnelStatus}"/>

    <controls:table name="Candidates"
                    itemsSource="{Binding Path=Data.PersonnelCandidates}"
                    row="6"
                    column="4"
                    style="candidateTable"
                    selectedItem="{Binding Path=Data.SelectedPersonnel}"
                    onSelect="{Binding Path=Commands.SelectPersonnel}"
                    selectedStyle="candidateSelected"
                    showHeaders="true"/>
  </grid>

  <styles>
    <controlStyle name="searchLabel"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="pageTitle"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="18"
                  fontBold="true"
                  borderColor="#262626"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="toolbarLabel"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#262626"
                  borderWeight="thin"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="sectionTitle"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formLabel"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="formField"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="statusText"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="personnelCheckbox"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="false"
                  borderColor="#262626"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="candidateTable"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="candidateSelected"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#375D7A"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#6A9EC4"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="secondaryButton"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#3B3B3B"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="generationError"
                  indent="1"
                  backColor="#262626"
                  textColor="#FFD966"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"/>
    <controlStyle name="generationSuccess"
                  indent="1"
                  backColor="#262626"
                  textColor="#909090"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"/>
    <controlStyle name="lookupToggle"
                  backColor="#3B3B3B"
                  textColor="#909090"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"
                  paddingLeft="10"
                  paddingRight="10"/>
    <controlStyle name="currentDateItem"
                  backColor="#375D7A"
                  textColor="#F4A46B"
                  fontBold="true"/>
    <controlStyle name="formSelectPanel"
                  shadow="true"
                  shadowColor="#000000"
                  shadowBlur="6"
                  shadowTransparency="0.55"
                  shadowOffsetX="3"
                  shadowOffsetY="3"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#383838"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="formSelectItem"
                  shadow="false"
                  indent="1"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#383838"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{backColor:#262626;fontColor:#FFFFFF;fontName:Calibri;fontSize:11;borderColor:#000000;borderWeight:thin;rowHeight:30;overflow:wrap;gridLines:true;zoom:90%;}"/>
        <rule target="column"
              selector="address=A:A"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=B:B"
              styles="{width:22;}"/>
        <rule target="column"
              selector="address=C:C"
              styles="{width:40;}"/>
        <rule target="column"
              selector="address=D:D"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=E:E"
              styles="{width:19;}"/>
        <rule target="column"
              selector="address=F:F"
              styles="{width:37;}"/>
        <rule target="column"
              selector="address=G:G"
              styles="{width:16;}"/>
        <rule target="column"
              selector="address=H:H"
              styles="{width:16;}"/>
        <rule target="column"
              selector="address=I:I"
              styles="{width:32;}"/>
        <rule target="column"
              selector="address=J:J"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=K:K"
              styles="{width:25;}"/>
        <rule target="column"
              selector="address=L:L"
              styles="{width:12;}"/>
      </layer>
      <layer name="table-parts">
        <rule target="control"
              selector="name=DepartureDate"
              styles="{cellType:text;}"/>
        <rule target="control"
              selector="name=OrderReference"
              styles="{cellType:text;}"/>
        <rule target="control"
              selector="name=PersonId"
              styles="{cellType:text;}"/>
        <rule target="control"
              selector="name=TvoIpn"
              styles="{cellType:text;}"/>
        <rule target="control"
              selector="name=CandidateCount"
              styles="{horizontal:right;indent:1;}"/>
        <rule target="controlPart"
              selector="type=table;part=header"
              styles="{backColor:#355D8C;fontColor:#FFFFFF;fontBold:true;horizontal:center;vertical:center;}"/>
        <rule target="controlPart"
              selector="type=table;part=row;tags=even"
              styles="{backColor:#383838;}"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>