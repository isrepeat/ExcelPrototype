<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1">
  <grid row="2"
        column="2">

    <stackPanel name="MainForm"
                row="1"
                column="1"
                orientation="vertical">
      <grid>
        <controls:label name="DocumentTypeLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.DocumentTypeLabel}"/>
        <controls:select name="DocumentType"
                         itemsSource="{Binding Path=Data.DocumentTypes}"
                         row="1"
                         column="2"
                         columnSpan="2"
                         style="formField"
                         value="{Binding Path=Form.DocumentType}"
                         panelStyle="formSelectPanel"
                         itemStyle="formSelectItem"
                         onChange="{Binding Path=Commands.DocumentTypeChanged}"/>
      </grid>
      <grid visibility="{Binding Path=Form.VacationVisibility}">
        <controls:label name="VacationKindLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.VacationKind}"/>
        <controls:select name="VacationKind"
                         itemsSource="{Binding Path=Data.VacationKinds}"
                         row="1"
                         column="2"
                         columnSpan="2"
                         style="formField"
                         value="{Binding Path=Form.VacationKind}"
                         onChange="{Binding Path=Commands.VacationKindChanged}"
                         panelStyle="formSelectPanel"
                         itemStyle="formSelectItem"/>
      </grid>
      <grid>
        <controls:label name="VacationStatusLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.VacationStatus}"/>
        <controls:select name="VacationStatus"
                         itemsSource="{Binding Path=Data.StatusOptions}"
                         row="1"
                         column="2"
                         columnSpan="2"
                         style="formField"
                         value="{Binding Path=Form.VacationStatus}"
                         panelStyle="formSelectPanel"
                         itemStyle="formSelectItem"/>
      </grid>
      <grid>
        <controls:label name="ReportNoLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.ReportNo}"/>
        <controls:input name="ReportNo"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="formField"
                        value="{Binding Path=Form.ReportNo}"/>
      </grid>
      <grid>
        <controls:label name="PersonRankLabel"
                        row="1"
                        column="1"
                        style="{Binding Path=Form.PersonRankLabelStyle}"
                        text="{Binding Path=Text.PersonRankLabel}"/>
        <controls:input name="PersonRank"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="{Binding Path=Form.PersonRankStyle}"
                        value="{Binding Path=Form.PersonRank}"
                        readOnly="{Binding Path=Form.PersonRankReadOnly}"/>
      </grid>
      <grid>
        <controls:label name="PersonNameLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.PersonNameLabel}"/>
        <controls:input name="PersonName"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="lookupKeyField"
                        value="{Binding Path=Form.PersonName}"
                        onChange="{Binding Path=Commands.PersonNameChanged}"/>
      </grid>
      <grid>
        <controls:label name="PersonIdLabel"
                        row="1"
                        column="1"
                        style="{Binding Path=Form.PersonIdLabelStyle}"
                        text="{Binding Path=Text.PersonIdLabel}"/>
        <controls:input name="PersonId"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="{Binding Path=Form.PersonIdStyle}"
                        value="{Binding Path=Form.PersonId}"
                        readOnly="{Binding Path=Form.PersonIdReadOnly}"/>
      </grid>
      <grid>
        <controls:label name="PersonPositionCodeLabel"
                        row="1"
                        column="1"
                        style="{Binding Path=Form.PersonPositionCodeLabelStyle}"
                        text="{Binding Path=Text.PersonPositionCodeLabel}"/>
        <controls:input name="PersonPositionCode"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="{Binding Path=Form.PersonPositionCodeStyle}"
                        value="{Binding Path=Form.PersonPositionCode}"
                        readOnly="{Binding Path=Form.PersonPositionCodeReadOnly}"/>
      </grid>
      <grid>
        <controls:label name="PersonPositionLabel"
                        row="1"
                        column="1"
                        rowSpan="2"
                        style="{Binding Path=Form.PersonPositionLabelStyle}"
                        text="{Binding Path=Text.PersonPositionLabel}"/>
        <controls:input name="PersonPosition"
                        row="1"
                        column="2"
                        rowSpan="2"
                        columnSpan="2"
                        style="{Binding Path=Form.PersonPositionStyle}"
                        value="{Binding Path=Form.PersonPosition}"
                        readOnly="{Binding Path=Form.PersonPositionReadOnly}"/>
      </grid>
      <grid visibility="{Binding Path=Form.DestinationVisibility}">
        <controls:label name="PlaceKindLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.PlaceKind}"/>
        <controls:select name="PlaceKind"
                         itemsSource="{Binding Path=Data.PlaceKinds}"
                         row="1"
                         column="2"
                         columnSpan="2"
                         style="formField"
                         value="{Binding Path=Form.PlaceKind}"
                         onChange="{Binding Path=Commands.PlaceKindChanged}"
                         panelStyle="formSelectPanel"
                         itemStyle="formSelectItem"/>
      </grid>
      <grid visibility="{Binding Path=Form.DestinationVisibility}">
        <controls:label name="DocumentTargetLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.DocumentTargetLabel}"/>
        <controls:input name="DocumentTarget"
                        row="1"
                        column="2"
                        style="lookupKeyField"
                        value="{Binding Path=Form.DocumentTarget}"
                        onChange="{Binding Path=Commands.PlaceChanged}"/>
        <controls:button name="AddPlace"
                         row="1"
                         column="3"
                         style="tvoIconButton"
                         caption="{Binding Path=Text.AddPlace}"
                         command="{Binding Path=Commands.AddPlace}"/>
      </grid>
      <stackPanel name="PlaceFields"
                  orientation="vertical"
                  visibility="{Binding Path=Form.PlaceFieldsVisibility}">
        <grid>
          <controls:label name="PlaceRegionLabel"
                          row="1"
                          column="1"
                          style="manualPlaceLabel"
                          text="{Binding Path=Text.PlaceRegion}"/>
          <controls:input name="PlaceRegion"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.PlaceRegion}"/>
        </grid>
        <grid>
          <controls:label name="PlaceTypeLabel"
                          row="1"
                          column="1"
                          style="manualPlaceLabel"
                          text="{Binding Path=Text.PlaceType}"/>
          <controls:input name="PlaceType"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.PlaceType}"/>
        </grid>
        <grid>
          <controls:label name="PlaceNameLabel"
                          row="1"
                          column="1"
                          style="manualPlaceLabel"
                          text="{Binding Path=Text.PlaceName}"/>
          <controls:input name="PlaceName"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.PlaceName}"/>
        </grid>
        <grid visibility="{Binding Path=Form.DomesticPlaceFieldsVisibility}">
          <controls:label name="PlaceDistrictLabel"
                          row="1"
                          column="1"
                          style="manualPlaceLabel"
                          text="{Binding Path=Text.PlaceDistrict}"/>
          <controls:input name="PlaceDistrict"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.PlaceDistrict}"/>
        </grid>
      </stackPanel>
      <stackPanel name="ForeignPlaceFields"
                  orientation="vertical"
                  visibility="{Binding Path=Form.ForeignPlaceFieldsVisibility}">
        <grid>
          <controls:label name="PlaceCountryLabel"
                          row="1"
                          column="1"
                          style="manualPlaceLabel"
                          text="{Binding Path=Text.PlaceCountry}"/>
          <controls:input name="PlaceCountry"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.PlaceCountry}"/>
        </grid>
        <grid>
          <controls:label name="PlaceCountryEnLabel"
                          row="1"
                          column="1"
                          style="manualPlaceLabel"
                          text="{Binding Path=Text.PlaceCountryEn}"/>
          <controls:input name="PlaceCountryEn"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.PlaceCountryEn}"/>
        </grid>
        <grid>
          <controls:label name="PlaceRegionEnLabel"
                          row="1"
                          column="1"
                          style="manualPlaceLabel"
                          text="{Binding Path=Text.PlaceRegionEn}"/>
          <controls:input name="PlaceRegionEn"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.PlaceRegionEn}"/>
        </grid>
        <grid>
          <controls:label name="PlaceNameEnLabel"
                          row="1"
                          column="1"
                          style="manualPlaceLabel"
                          text="{Binding Path=Text.PlaceNameEn}"/>
          <controls:input name="PlaceNameEn"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.PlaceNameEn}"/>
        </grid>
      </stackPanel>
      <stackPanel name="PlaceChainPanel"
                  orientation="vertical"
                  visibility="{Binding Path=Form.PlaceChainVisibility}">
        <grid>
          <controls:label name="PlaceChainTitle"
                          row="1"
                          column="1"
                          columnSpan="2"
                          style="sectionTitle"
                          text="{Binding Path=Text.PlaceChainTitle}"/>
          <controls:button name="RemovePlace"
                           row="1"
                           column="3"
                           style="tvoIconButton"
                           caption="{Binding Path=Text.RemovePlace}"
                           command="{Binding Path=Commands.RemovePlace}"/>
        </grid>
        <controls:table name="PlaceList"
                        itemsSource="{Binding Path=Data.PlaceChainView}"
                        style="statusText"
                        showHeaders="false"/>
      </stackPanel>
      <grid>
        <controls:label name="DepartureDateLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.DepartureDateLabel}"/>
        <controls:select name="DepartureDate"
                         itemsSource="{Binding Path=Data.DepartureDates}"
                         row="1"
                         column="2"
                         columnSpan="2"
                         style="formField"
                         value="{Binding Path=Form.DepartureDate}"
                         editable="true"
                         arrowColumnSpan="1"
                         highlightValue="{Binding Path=Data.CurrentDate}"
                         highlightStyle="currentDateItem"
                         itemHeight="20"
                         panelStyle="formSelectPanel"
                         itemStyle="formSelectItem"
                         onChange="{Binding Path=Commands.VacationDatesChanged}"/>
      </grid>
      <grid>
        <controls:label name="VacationDaysLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.VacationDays}"/>
        <controls:input name="VacationDays"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="formField"
                        value="{Binding Path=Form.VacationDays}"
                        onChange="{Binding Path=Commands.VacationDatesChanged}"/>
      </grid>
      <grid>
        <controls:label name="RoadDaysLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.RoadDays}"/>
        <controls:input name="RoadDays"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="formField"
                        value="{Binding Path=Form.RoadDays}"
                        onChange="{Binding Path=Commands.VacationDatesChanged}"/>
      </grid>
      <grid visibility="{Binding Path=Form.VacationVisibility}">
        <controls:label name="DonationDaysLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.DonationDays}"/>
        <controls:input name="DonationDays"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="formField"
                        value="{Binding Path=Form.DonationDays}"
                        onChange="{Binding Path=Commands.VacationDatesChanged}"/>
      </grid>
      <grid>
        <controls:label name="VacationAbroadLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.VacationAbroad}"/>
        <controls:select name="VacationAbroad"
                         itemsSource="{Binding Path=Data.AbroadOptions}"
                         row="1"
                         column="2"
                         columnSpan="2"
                         style="formField"
                         value="{Binding Path=Form.VacationAbroad}"
                         onChange="{Binding Path=Commands.VacationAbroadChanged}"
                         panelStyle="formSelectPanel"
                         itemStyle="formSelectItem"/>
      </grid>
      <stackPanel name="TreatmentFields"
                  orientation="vertical"
                  visibility="{Binding Path=Form.TreatmentVisibility}">
        <grid>
          <controls:label name="VlkNoLabel"
                          row="1"
                          column="1"
                          style="formLabel"
                          text="{Binding Path=Text.VlkNo}"/>
          <controls:input name="VlkNo"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.VlkNo}"/>
        </grid>
        <grid>
          <controls:label name="VlkDateLabel"
                          row="1"
                          column="1"
                          style="formLabel"
                          text="{Binding Path=Text.VlkDate}"/>
          <controls:input name="VlkDate"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.VlkDate}"/>
        </grid>
        <grid>
          <controls:label name="LongTreatmentDaysLabel"
                          row="1"
                          column="1"
                          style="formLabel"
                          text="{Binding Path=Text.LongTreatmentDays}"/>
          <controls:input name="LongTreatmentDays"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.LongTreatmentDays}"/>
        </grid>
        <grid>
          <controls:label name="TreatmentLeaveDaysLabel"
                          row="1"
                          column="1"
                          style="formLabel"
                          text="{Binding Path=Text.TreatmentLeaveDays}"/>
          <controls:input name="TreatmentLeaveDays"
                          row="1"
                          column="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.TreatmentLeaveDays}"/>
        </grid>
      </stackPanel>
      <grid>
        <controls:label name="TvoNameLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.TvoName}"/>
        <controls:input name="TvoName"
                        row="1"
                        column="2"
                        style="lookupKeyField"
                        value="{Binding Path=Form.TvoName}"
                        onChange="{Binding Path=Commands.TvoNameChanged}"/>
        <controls:button name="AddTvo"
                         row="1"
                         column="3"
                         style="tvoIconButton"
                         caption="{Binding Path=Text.AddTvo}"
                         command="{Binding Path=Commands.AddTvo}"/>
      </grid>
      <grid>
        <controls:label name="TvoIpnLabel"
                        row="1"
                        column="1"
                        style="{Binding Path=Form.TvoIpnLabelStyle}"
                        text="{Binding Path=Text.TvoIpn}"/>
        <controls:input name="TvoIpn"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="{Binding Path=Form.TvoIpnStyle}"
                        value="{Binding Path=Form.TvoIpn}"
                        readOnly="{Binding Path=Form.TvoIpnReadOnly}"/>
      </grid>
      <grid>
        <controls:label name="TvoPositionLabel"
                        row="1"
                        column="1"
                        style="{Binding Path=Form.TvoPositionLabelStyle}"
                        text="{Binding Path=Text.TvoPosition}"/>
        <controls:input name="TvoPosition"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="{Binding Path=Form.TvoPositionStyle}"
                        value="{Binding Path=Form.TvoPosition}"
                        readOnly="{Binding Path=Form.TvoPositionReadOnly}"/>
      </grid>
      <stackPanel name="TvoChainPanel"
                  orientation="vertical"
                  visibility="{Binding Path=Form.TvoChainVisibility}">
        <grid>
          <controls:label name="TvoChainTitle"
                          row="1"
                          column="1"
                          columnSpan="2"
                          style="sectionTitle"
                          text="{Binding Path=Text.TvoChainTitle}"/>
          <controls:button name="RemoveTvo"
                           row="1"
                           column="3"
                           style="tvoIconButton"
                           caption="{Binding Path=Text.RemoveTvo}"
                           command="{Binding Path=Commands.RemoveTvo}"/>
        </grid>
        <controls:table name="TvoList"
                        itemsSource="{Binding Path=Data.TvoChainView}"
                        style="statusText"
                        showHeaders="false"/>
      </stackPanel>
      <grid>
        <controls:label name="PurposeLabel"
                        row="1"
                        column="1"
                        rowSpan="2"
                        style="formLabel"
                        text="{Binding Path=Text.PurposeLabel}"/>
        <controls:input name="Purpose"
                        row="1"
                        column="2"
                        rowSpan="2"
                        columnSpan="2"
                        style="formField"
                        value="{Binding Path=Form.Purpose}"/>
      </grid>
      <stackPanel name="TripFields"
                  orientation="vertical"
                  visibility="{Binding Path=Form.TripVisibility}">
        <grid>
          <controls:label name="WeaponLineLabel"
                          row="1"
                          column="1"
                          rowSpan="2"
                          style="formLabel"
                          text="{Binding Path=Text.WeaponLine}"/>
          <controls:input name="WeaponLine"
                          row="1"
                          column="2"
                          rowSpan="2"
                          columnSpan="2"
                          style="formField"
                          value="{Binding Path=Form.WeaponLine}"/>
        </grid>
      </stackPanel>
      <grid visibility="{Binding Path=Form.ChangeReasonVisibility}">
        <controls:label name="ChangeReasonLabel"
                        row="1"
                        column="1"
                        style="formLabel"
                        text="{Binding Path=Text.ChangeReason}"/>
        <controls:input name="ChangeReason"
                        row="1"
                        column="2"
                        columnSpan="2"
                        style="formField"
                        value="{Binding Path=Form.ChangeReason}"/>
      </grid>
    </stackPanel>

    <controls:button name="SaveHistory"
                     row="2"
                     column="11"
                     columnSpan="2"
                     style="resetFormButton"
                     caption="{Binding Path=Text.SaveHistory}"
                     command="{Binding Path=Commands.SaveHistory}"/>

    <controls:button name="ExportWord"
                     row="4"
                     column="14"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ExportWord}"
                     command="{Binding Path=Commands.ExportWord}"/>

    <controls:button name="ClearForm"
                     row="2"
                     column="8"
                     columnSpan="2"
                     style="resetFormButton"
                     caption="{Binding Path=Text.ClearForm}"
                     command="{Binding Path=Commands.ClearForm}"/>

    <controls:label name="OrderQueryLabel"
                    row="6"
                    column="14"
                    style="formLabel"
                    text="{Binding Path=Text.OrderQueryLabel}"/>
    <controls:label name="OrderYearLabel"
                    row="6"
                    column="15"
                    style="formLabel"
                    text="{Binding Path=Text.OrderYearLabel}"/>
    <controls:select name="OrderQuery"
                     itemsSource="{Binding Path=Data.OrderOptions}"
                     row="7"
                     column="14"
                     style="lookupKeyField"
                     value="{Binding Path=Form.OrderQuery}"
                     editable="true"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"
                     onChange="{Binding Path=Commands.SearchOrders}"/>
    <controls:input name="OrderYear"
                    row="7"
                    column="15"
                    style="lookupKeyField"
                    value="{Binding Path=Form.OrderYear}"
                    onChange="{Binding Path=Commands.SearchOrders}"/>
    <controls:label name="HistoryEditMode"
                    row="14"
                    column="14"
                    rowSpan="2"
                    columnSpan="2"
                    style="statusHeading"
                    text="{Binding Path=Text.HistoryEditMode}"/>
    <controls:button name="LoadHistory"
                     row="3"
                     column="14"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.LoadHistory}"
                     command="{Binding Path=Commands.LoadHistory}"/>
    <controls:label name="LastStatusLabel"
                    row="9"
                    column="14"
                    columnSpan="2"
                    style="statusHeading"
                    text="{Binding Path=Text.LastStatus}"/>

    <controls:label name="GenerationStatus"
                    row="10"
                    column="14"
                    rowSpan="4"
                    columnSpan="2"
                    style="{Binding Path=Form.GenerationStatusStyle}"
                    text="{Binding Path=Form.GenerationStatus}"/>

    <controls:label name="SearchSection"
                    row="1"
                    column="5"
                    columnSpan="8"
                    style="sectionTitle"
                    text="{Binding Path=Text.SearchSection}"/>

    <controls:checkbox name="AutoFillPersonnel"
                       row="2"
                       column="5"
                       columnSpan="3"
                       style="personnelCheckbox"
                       value="{Binding Path=Form.AutoFillPersonnel}"
                         caption="{Binding Path=Text.AutoFillPersonnelLabel}"
                         checkedGlyph="{Binding Path=Text.CheckboxChecked}"
                         uncheckedGlyph="{Binding Path=Text.CheckboxUnchecked}"
                         onChange="{Binding Path=Commands.AutoFillChanged}"/>

    <controls:label name="ActionsSection"
                    row="1"
                    column="14"
                    columnSpan="2"
                    style="sectionTitle"
                    text="{Binding Path=Text.ActionsSection}"/>

    <controls:button name="RefreshPersonnel"
                     row="2"
                     column="14"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.RefreshPersonnel}"
                     command="{Binding Path=Commands.RefreshPersonnel}"/>

    <controls:table name="Candidates"
                    itemsSource="{Binding Path=Data.PersonnelCandidates}"
                    row="3"
                    column="5"
                    columnOffset="{Binding Path=Settings.CandidateColumnOffset}"
                    maxColumns="{Binding Path=Settings.CandidateMaxColumns}"
                    overflowMessage="{Binding Path=Text.CandidateOverflow}"
                    style="candidateTable"
                    visibility="{Binding Path=Form.CandidatesVisibility}"
                    selectedItem="{Binding Path=Data.SelectedPersonnel}"
                    selectionMode="{Binding Path=Settings.CandidateSelectionMode}"
                    onSelect="{Binding Path=Commands.SelectPersonnel}"
                    selectedStyle="candidateSelected"
                    showHeaders="true"/>
    <controls:table name="History"
                    itemsSource="{Binding Path=Data.HistoryCandidates}"
                    row="3"
                    column="5"
                    style="candidateTable"
                    visibility="{Binding Path=Form.HistoryVisibility}"
                    selectedItem="{Binding Path=Data.SelectedHistory}"
                    selectionMode="Confirm"
                    onSelect="{Binding Path=Commands.SelectHistory}"
                    selectedStyle="candidateSelected"
                    closeCommand="{Binding Path=Commands.CloseHistory}"
                    closeCaption="{Binding Path=Text.CloseHistory}"
                    showHeaders="true"/>
  </grid>

  <styles>
    <controlStyle name="personnelFormField"
                  cellType="text"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#F2F2F2"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="currentOrderField"
                  cellType="text"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#F2F2F2"
                  fontColor="#F2F2F2"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="lookupKeyField"
                  cellType="text"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#3A3A3A"
                  textColor="#F2F2F2"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="selectShapeBase"
                  backColor="#FFFFFF"
                  textColor="#111827"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#64748B"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="searchLabel"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="pageTitle"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="18"
                  fontBold="true"
                  borderColor="#262626"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="toolbarLabel"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#262626"
                  borderWeight="thin"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="sectionTitle"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formLabel"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="right"
                  vertical="center"/>
