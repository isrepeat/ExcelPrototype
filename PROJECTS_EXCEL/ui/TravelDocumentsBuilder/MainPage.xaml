                  vertical="center"
                  paddingLeft="10"
                  paddingRight="10"/>
    <controlStyle name="currentDateItem"
                  backColor="{ThemeResource TodayBackground}"
                  textColor="{ThemeResource Accent}"
                  fontBold="true"/>
    <controlStyle name="formSelectPlaceholder"
                  textColor="{ThemeResource PlaceholderText}"
                  fontItalic="true"/>
    <controlStyle name="formSelectValue"
                  textColor="{ThemeResource Accent}"
                  fontItalic="false"/>
    <controlStyle name="formSelectPanel"
                  shadow="true"
                  shadowColor="{ThemeResource Shadow}"
                  shadowBlur="6"
                  shadowTransparency="0.55"
                  shadowOffsetX="3"
                  shadowOffsetY="3"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="{ThemeResource PopupBackground}"
                  textColor="{ThemeResource PopupText}"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="{ThemeResource PopupBorder}"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="formSelectItem"
                  shadow="false"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="{ThemeResource PopupBackground}"
                  textColor="{ThemeResource PopupText}"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="{ThemeResource PopupBorder}"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{backColor:{ThemeResource PageBackground};fontColor:{ThemeResource TextPrimary};fontName:Calibri;fontSize:11;borderColor:{ThemeResource Border};borderWeight:thin;rowHeight:28.5;overflow:wrap;gridLines:true;zoom:90%;}"/>
        <rule target="row"
              selector="address=1:1"
              styles="{rowHeight:8;}"/>
        <rule target="column"
              selector="address=A:A"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=B:B"
              styles="{width:22;}"/>
        <rule target="column"
              selector="address=C:C"
              styles="{width:38;}"/>
        <rule target="column"
              selector="address=D:D"
              styles="{width:4;}"/>
        <rule target="column"
              selector="address=E:L"
              styles="{width:17.65;}"/>
        <rule target="column"
              selector="address=M:M"
              styles="{width:4;}"/>
        <rule target="column"
              selector="address=N:N"
              styles="{width:25;}"/>
        <rule target="column"
              selector="address=O:O"
              styles="{width:12;}"/>
        <rule target="column"
              selector="address=P:P"
              styles="{width:2;}"/>
      </layer>
      <layer name="table-parts">
        <rule target="control"
              selector="type=checkbox;tags=glyphOnly"
              styles="{paddingLeft:0;paddingRight:0;horizontal:center;vertical:center;}"/>
        <rule target="control"
              selector="type=input"
              styles="{cellType:text;horizontal:left;}"/>
        <rule target="control"
              selector="type=select"
              styles="{cellType:text;horizontal:left;fontColor:{ThemeResource Accent};}"/>
        <rule target="controlPart"
              selector="type=select;part=header"
              styles="{marginLeft:3;marginRight:3;marginTop:3;marginBottom:3;borderLineStyle:none;}"/>
        <rule target="controlPart"
              selector="type=select;part=header;tags=selectPlaceholder"
              styles="{fontColor:{ThemeResource PlaceholderText};fontItalic:true;}"/>
        <rule target="controlPart"
              selector="type=select;part=header;tags=formIconButton"
              styles="{marginLeft:0;marginRight:0;marginTop:0;marginBottom:0;paddingLeft:0;paddingRight:0;paddingTop:0;paddingBottom:0;backColor:{ThemeResource ButtonBackground};fontColor:{ThemeResource Accent};fontName:Calibri;fontSize:12;fontBold:true;horizontal:center;vertical:center;borderLineStyle:solid;borderColor:{ThemeResource Border};borderWeight:thin;}"/>
        <rule target="controlPart"
              selector="type=table;part=header"
              styles="{backColor:{ThemeResource LookupBackground};fontColor:{ThemeResource TextPrimary};fontBold:true;horizontal:center;vertical:center;}"/>
        <rule target="controlPart"
              selector="type=table;part=row;tags=even"
              styles="{backColor:{ThemeResource TableStripeBackground};}"/>
        <rule target="controlPart"
              selector="type=table;name=PlaceList;part=row"
              styles="{backColor:{ThemeResource PageBackground};}"/>
        <rule target="controlPart"
              selector="type=table;name=TvoList;part=row"
              styles="{backColor:{ThemeResource PageBackground};}"/>
        <rule target="controlPart"
              selector="type=table;name=BasisList;part=row"
              styles="{backColor:{ThemeResource PageBackground};}"/>
      </layer>
      <layer name="readonly-fields"
             enabled="true">
        <rule target="controlPart"
              selector="type=input;part=editor;tags=readOnly personnelFormField"
              styles="{fontColor:{ThemeResource ReadOnlyText};}"/>
        <rule target="controlPart"
              selector="type=input;part=editor;tags=readOnly currentOrderField"
              styles="{fontColor:{ThemeResource ReadOnlyOrderText};}"/>
        <rule target="controlPart"
              selector="type=input;part=editor;tags=readOnly formField"
              styles="{fontColor:{ThemeResource ReadOnlyFieldText};}"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>