<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1">
  <grid row="2"
        column="2">

    <controls:label name="PersonNameLabel"
                    row="5"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.PersonNameLabel}"/>

    <controls:input name="PersonName"
                    row="5"
                    column="2"
                    columnSpan="2"
                    style="lookupKeyField"
                    value="{Binding Path=Form.PersonName}"
                    onChange="{Binding Path=Commands.PersonNameChanged}"/>

    <controls:label name="PersonIdLabel"
                    row="6"
                    column="1"
                    style="{Binding Path=Form.PersonIdLabelStyle}"
                    text="{Binding Path=Text.PersonIdLabel}"/>

    <controls:input name="PersonId"
                    row="6"
                    column="2"
                    columnSpan="2"
                    style="{Binding Path=Form.PersonIdStyle}"
                    value="{Binding Path=Form.PersonId}"
                    readOnly="{Binding Path=Form.PersonIdReadOnly}"/>

    <controls:label name="PersonRankLabel"
                    row="4"
                    column="1"
                    style="{Binding Path=Form.PersonRankLabelStyle}"
                    text="{Binding Path=Text.PersonRankLabel}"/>

    <controls:input name="PersonRank"
                    row="4"
                    column="2"
                    columnSpan="2"
                    style="{Binding Path=Form.PersonRankStyle}"
                    value="{Binding Path=Form.PersonRank}"
                    readOnly="{Binding Path=Form.PersonRankReadOnly}"/>

    <controls:label name="PersonPositionCodeLabel"
                    row="7"
                    column="1"
                    style="{Binding Path=Form.PersonPositionCodeLabelStyle}"
                    text="{Binding Path=Text.PersonPositionCodeLabel}"/>

    <controls:input name="PersonPositionCode"
                    row="7"
                    column="2"
                    columnSpan="2"
                    style="{Binding Path=Form.PersonPositionCodeStyle}"
                    value="{Binding Path=Form.PersonPositionCode}"
                    readOnly="{Binding Path=Form.PersonPositionCodeReadOnly}"/>

    <controls:label name="PersonPositionLabel"
                    row="8"
                    column="1"
                    rowSpan="2"
                    style="{Binding Path=Form.PersonPositionLabelStyle}"
                    text="{Binding Path=Text.PersonPositionLabel}"/>

    <controls:input name="PersonPosition"
                    row="8"
                    column="2"
                    rowSpan="2"
                    columnSpan="2"
                    style="{Binding Path=Form.PersonPositionStyle}"
                    value="{Binding Path=Form.PersonPosition}"
                    readOnly="{Binding Path=Form.PersonPositionReadOnly}"/>

    <controls:label name="VacationKindLabel"
                    row="2"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.VacationKind}"/>

    <controls:select name="VacationKind"
                     itemsSource="{Binding Path=Data.VacationKinds}"
                     row="2"
                     column="2"
                     columnSpan="2"
                     style="formField"
                     value="{Binding Path=Form.VacationKind}"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"/>

    <controls:label name="VacationStatusLabel"
                    row="3"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.VacationStatus}"/>

    <controls:select name="VacationStatus"
                     itemsSource="{Binding Path=Data.StatusOptions}"
                     row="3"
                     column="2"
                     columnSpan="2"
                     style="formField"
                     value="{Binding Path=Form.VacationStatus}"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"/>

    <controls:label name="DocumentTargetLabel"
                    row="10"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.DocumentTargetLabel}"/>

    <controls:input name="DocumentTarget"
                    row="10"
                    column="2"
                    columnSpan="2"
                    style="formField"
                    value="{Binding Path=Form.DocumentTarget}"/>

    <controls:label name="DepartureDateLabel"
                    row="11"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.DepartureDateLabel}"/>

    <controls:select name="DepartureDate"
                    itemsSource="{Binding Path=Data.DepartureDates}"
                    row="11"
                    column="2"
                    columnSpan="2"
                    style="formField"
                    value="{Binding Path=Form.DepartureDate}"
                    editable="true"
                    highlightValue="{Binding Path=Data.CurrentDate}"
                    highlightStyle="currentDateItem"
                    itemHeight="20"
                    panelStyle="formSelectPanel"
                    itemStyle="formSelectItem"
                    onChange="{Binding Path=Commands.VacationDatesChanged}"/>

    <controls:label name="VacationDaysLabel"
                    row="12"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.VacationDays}"/>

    <controls:input name="VacationDays"
                     row="12"
                     column="2"
                    columnSpan="2"
                     style="formField"
                     value="{Binding Path=Form.VacationDays}"
                     onChange="{Binding Path=Commands.VacationDatesChanged}"/>

    <controls:label name="RoadDaysLabel"
                    row="13"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.RoadDays}"/>

    <controls:input name="RoadDays"
                     row="13"
                     column="2"
                    columnSpan="2"
                     style="formField"
                     value="{Binding Path=Form.RoadDays}"
                     onChange="{Binding Path=Commands.VacationDatesChanged}"/>

    <controls:label name="DonationDaysLabel"
                    row="14"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.DonationDays}"/>

    <controls:input name="DonationDays"
                     row="14"
                     column="2"
                    columnSpan="2"
                     style="formField"
                     value="{Binding Path=Form.DonationDays}"
                     onChange="{Binding Path=Commands.VacationDatesChanged}"/>

    <controls:label name="VacationAbroadLabel"
                    row="15"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.VacationAbroad}"/>

    <controls:select name="VacationAbroad"
                     itemsSource="{Binding Path=Data.AbroadOptions}"
                     row="15"
                     column="2"
                     columnSpan="2"
                     style="formField"
                     value="{Binding Path=Form.VacationAbroad}"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"/>

    <controls:label name="TvoNameLabel"
                    row="16"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.TvoName}"/>

    <controls:input name="TvoName"
                    row="16"
                    column="2"
                    style="lookupKeyField"
                    value="{Binding Path=Form.TvoName}"
                    onChange="{Binding Path=Commands.TvoNameChanged}"/>

    <controls:label name="TvoIpnLabel"
                    row="17"
                    column="1"
                    style="{Binding Path=Form.TvoIpnLabelStyle}"
                    text="{Binding Path=Text.TvoIpn}"/>

    <controls:input name="TvoIpn"
                    row="17"
                    column="2"
                    columnSpan="2"
                    style="{Binding Path=Form.TvoIpnStyle}"
                    value="{Binding Path=Form.TvoIpn}"
                    readOnly="{Binding Path=Form.TvoIpnReadOnly}"/>

    <controls:label name="TvoPositionLabel"
                    row="18"
                    column="1"
                    style="{Binding Path=Form.TvoPositionLabelStyle}"
                    text="{Binding Path=Text.TvoPosition}"/>

    <controls:input name="TvoPosition"
                    row="18"
                    column="2"
                    columnSpan="2"
                    style="{Binding Path=Form.TvoPositionStyle}"
                    value="{Binding Path=Form.TvoPosition}"
                    readOnly="{Binding Path=Form.TvoPositionReadOnly}"/>

    <controls:label name="ReportNoLabel"
                    row="19"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.ReportNo}"/>

    <controls:input name="ReportNo"
                    row="19"
                    column="2"
                    columnSpan="2"
                    style="formField"
                    value="{Binding Path=Form.ReportNo}"/>

    <controls:label name="PurposeLabel"
                    row="20"
                    column="1"
                    rowSpan="2"
                    style="formLabel"
                    text="{Binding Path=Text.PurposeLabel}"/>

    <controls:input name="Purpose"
                    row="20"
                    column="2"
                    rowSpan="2"
                    columnSpan="2"
                    style="formField"
                    value="{Binding Path=Form.Purpose}"/>

    <controls:label name="ChangeReasonLabel"
                    row="22"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.ChangeReason}"/>
    <controls:input name="ChangeReason"
                    row="22"
                    column="2"
                    columnSpan="2"
                    style="formField"
                    value="{Binding Path=Form.ChangeReason}"/>
    <controls:label name="TvoChainTitle"
                    row="24"
                    column="1"
                    columnSpan="2"
                    style="sectionTitle"
                    text="{Binding Path=Text.TvoChainTitle}"/>
    <controls:button name="AddTvo"
                     row="16"
                     column="3"
                     style="tvoIconButton"
                     caption="{Binding Path=Text.AddTvo}"
                     command="{Binding Path=Commands.AddTvo}"/>
    <controls:button name="RemoveTvo"
                     row="24"
                     column="3"
                     style="tvoIconButton"
                     caption="{Binding Path=Text.RemoveTvo}"
                     command="{Binding Path=Commands.RemoveTvo}"/>
    <controls:label name="TvoChainSummary"
                    row="25"
                    column="1"
                    rowSpan="3"
                    columnSpan="3"
                    style="statusText"
                    text="{Binding Path=Text.TvoChainSummary}"/>
    <controls:label name="DocumentTypeLabel"
                    row="1"
                    column="1"
                    style="formLabel"
                    text="{Binding Path=Text.DocumentTypeLabel}"/>

    <controls:select name="DocumentType"
                     itemsSource="{Binding Path=Data.DocumentTypes}"
                     row="1"
                     column="2"
                     columnSpan="2"
                     style="formField"
                     value="{Binding Path=Form.DocumentType}"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"
                     onChange="{Binding Path=Commands.DocumentTypeChanged}"/>

    <controls:button name="SaveHistory"
                     row="2"
                     column="10"
                     style="resetFormButton"
                     caption="{Binding Path=Text.SaveHistory}"
                     command="{Binding Path=Commands.SaveHistory}"/>

    <controls:button name="ExportWord"
                     row="4"
                     column="12"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.ExportWord}"
                     command="{Binding Path=Commands.ExportWord}"/>

    <controls:button name="ClearForm"
                     row="2"
                     column="7"
                     columnSpan="2"
                     style="resetFormButton"
                     caption="{Binding Path=Text.ClearForm}"
                     command="{Binding Path=Commands.ClearForm}"/>

    <controls:label name="OrderQueryLabel"
                    row="6"
                    column="12"
                    style="formLabel"
                    text="{Binding Path=Text.OrderQueryLabel}"/>
    <controls:label name="OrderYearLabel"
                    row="6"
                    column="13"
                    style="formLabel"
                    text="{Binding Path=Text.OrderYearLabel}"/>
    <controls:select name="OrderQuery"
                     itemsSource="{Binding Path=Data.OrderOptions}"
                     row="7"
                     column="12"
                     style="lookupKeyField"
                     value="{Binding Path=Form.OrderQuery}"
                     editable="true"
                     panelStyle="formSelectPanel"
                     itemStyle="formSelectItem"
                     onChange="{Binding Path=Commands.SearchOrders}"/>
    <controls:input name="OrderYear"
                    row="7"
                    column="13"
                    style="lookupKeyField"
                    value="{Binding Path=Form.OrderYear}"
                    onChange="{Binding Path=Commands.SearchOrders}"/>
    <controls:label name="HistoryEditMode"
                    row="14"
                    column="12"
                    rowSpan="2"
                    columnSpan="2"
                    style="statusHeading"
                    text="{Binding Path=Text.HistoryEditMode}"/>
    <controls:button name="LoadHistory"
                     row="3"
                     column="12"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.LoadHistory}"
                     command="{Binding Path=Commands.LoadHistory}"/>
    <controls:label name="LastStatusLabel"
                    row="9"
                    column="12"
                    columnSpan="2"
                    style="statusHeading"
                    text="{Binding Path=Text.LastStatus}"/>

    <controls:label name="GenerationStatus"
                    row="10"
                    column="12"
                    rowSpan="4"
                    columnSpan="2"
                    style="{Binding Path=Form.GenerationStatusStyle}"
                    text="{Binding Path=Form.GenerationStatus}"/>

    <controls:label name="SearchSection"
                    row="1"
                    column="5"
                    columnSpan="6"
                    style="sectionTitle"
                    text="{Binding Path=Text.SearchSection}"/>

    <controls:checkbox name="AutoFillPersonnel"
                       row="2"
                       column="5"
                       columnSpan="2"
                       style="personnelCheckbox"
                       value="{Binding Path=Form.AutoFillPersonnel}"
                         caption="{Binding Path=Text.AutoFillPersonnelLabel}"
                         checkedGlyph="{Binding Path=Text.CheckboxChecked}"
                         uncheckedGlyph="{Binding Path=Text.CheckboxUnchecked}"
                         onChange="{Binding Path=Commands.AutoFillChanged}"/>

    <controls:label name="ActionsSection"
                    row="1"
                    column="12"
                    columnSpan="2"
                    style="sectionTitle"
                    text="{Binding Path=Text.ActionsSection}"/>

    <controls:button name="RefreshPersonnel"
                     row="2"
                     column="12"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.RefreshPersonnel}"
                     command="{Binding Path=Commands.RefreshPersonnel}"/>

    <controls:table name="Candidates"
                    itemsSource="{Binding Path=Data.PersonnelCandidates}"
                    row="3"
                    column="5"
                    style="candidateTable"
                    visibility="{Binding Path=Form.CandidatesVisibility}"
                    selectedItem="{Binding Path=Data.SelectedPersonnel}"
                    selectionMode="{Binding Path=Settings.CandidateSelectionMode}"
                    onSelect="{Binding Path=Commands.SelectPersonnel}"
                    selectedStyle="candidateSelected"
                    showHeaders="true"/>
    <controls:table name="History"
                    itemsSource="{Binding Path=Data.HistoryCandidates}"
                    row="3"
                    column="5"
                    style="candidateTable"
                    visibility="{Binding Path=Form.HistoryVisibility}"
                    selectedItem="{Binding Path=Data.SelectedHistory}"
                    selectionMode="Confirm"
                    onSelect="{Binding Path=Commands.SelectHistory}"
                    selectedStyle="candidateSelected"
                    closeCommand="{Binding Path=Commands.CloseHistory}"
                    closeCaption="{Binding Path=Text.CloseHistory}"
                    showHeaders="true"/>
  </grid>

  <styles>
    <controlStyle name="personnelFormField"
                  cellType="text"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="currentOrderField"
                  cellType="text"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#87CEFA"
                  fontColor="#87CEFA"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="lookupKeyField"
                  cellType="text"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#3A3A3A"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="selectShapeBase"
                  backColor="#FFFFFF"
                  textColor="#111827"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#64748B"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="searchLabel"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="pageTitle"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="18"
                  fontBold="true"
                  borderColor="#262626"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="toolbarLabel"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#262626"
                  borderWeight="thin"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="sectionTitle"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="formLabel"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="readOnlyFormLabel"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#909090"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="formField"
                  cellType="text"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="statusHeading"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#999999"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="statusText"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="personnelCheckbox"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="false"
                  borderColor="#262626"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="candidateTable"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="10"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="candidateSelected"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#505050"
                  fontName="Calibri"
                  fontSize="10"
                  fontBold="false"
                  borderColor="#808080"
                  borderWeight="thin"
                  borderScope="outline"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="resetFormButton"
                  marginLeft="3"
                  marginRight="3"
                  marginTop="3"
                  marginBottom="3"
                  paddingLeft="2"
                  paddingRight="2"
                  paddingTop="0"
                  paddingBottom="0"
                  backColor="#303030"
                  textColor="#C3C3C3"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="false"
                  borderLineStyle="none"
                  horizontal="center"
                  vertical="center"
                  overflow="wrap"/>
    <controlStyle name="tvoIconButton"
                  paddingLeft="0"
                  paddingRight="0"
                  backColor="#3B3B3B"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="secondaryButton"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#3B3B3B"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="generationError"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#FFD966"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"/>
    <controlStyle name="generationSuccess"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#262626"
                  textColor="#909090"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"/>
    <controlStyle name="lookupToggle"
                  backColor="#3B3B3B"
                  textColor="#909090"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"
                  paddingLeft="10"
                  paddingRight="10"/>
    <controlStyle name="currentDateItem"
                  backColor="#375D7A"
                  textColor="#F4A46B"
                  fontBold="true"/>
    <controlStyle name="formSelectPanel"
                  shadow="true"
                  shadowColor="#000000"
                  shadowBlur="6"
                  shadowTransparency="0.55"
                  shadowOffsetX="3"
                  shadowOffsetY="3"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#383838"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="formSelectItem"
                  shadow="false"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#383838"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="false"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{backColor:#262626;fontColor:#FFFFFF;fontName:Calibri;fontSize:11;borderColor:#000000;borderWeight:thin;rowHeight:30;overflow:wrap;gridLines:true;zoom:90%;}"/>
        <rule target="row"
              selector="address=1:1"
              styles="{rowHeight:8;}"/>
        <rule target="column"
              selector="address=A:A"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=B:B"
              styles="{width:22;}"/>
        <rule target="column"
              selector="address=C:C"
              styles="{width:38;}"/>
        <rule target="column"
              selector="address=D:D"
              styles="{width:4;}"/>
        <rule target="column"
              selector="address=E:E"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=F:F"
              styles="{width:13;}"/>
        <rule target="column"
              selector="address=G:G"
              styles="{width:32;}"/>
        <rule target="column"
              selector="address=H:H"
              styles="{width:13;}"/>
        <rule target="column"
              selector="address=I:I"
              styles="{width:13;}"/>
        <rule target="column"
              selector="address=J:J"
              styles="{width:29;}"/>
        <rule target="column"
              selector="address=K:K"
              styles="{width:20;}"/>
        <rule target="column"
              selector="address=L:L"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=M:M"
              styles="{width:25;}"/>
        <rule target="column"
              selector="address=N:N"
              styles="{width:12;}"/>
      </layer>
      <layer name="table-parts">
        <rule target="control"
              selector="type=input"
              styles="{cellType:text;horizontal:left;}"/>
        <rule target="control"
              selector="type=select"
              styles="{cellType:text;horizontal:left;}"/>
        <rule target="controlPart"
              selector="type=select;name=DepartureDate;part=header"
              styles="{horizontal:center;vertical:center;paddingLeft:0;paddingRight:0;}"/>
        <rule target="controlPart"
              selector="type=select;name=OrderQuery;part=header"
              styles="{horizontal:center;vertical:center;paddingLeft:0;paddingRight:0;}"/>
        <rule target="controlPart"
              selector="type=table;part=header"
              styles="{backColor:#3A3A3A;fontColor:#FFFFFF;fontBold:true;horizontal:center;vertical:center;}"/>
        <rule target="controlPart"
              selector="type=table;part=row;tags=even"
              styles="{backColor:#383838;}"/>
      </layer>
      <layer name="readonly-fields"
             enabled="true">
        <rule target="controlPart"
              selector="type=input;part=editor;tags=readOnly personnelFormField"
              styles="{fontColor:#B6B6B6;}"/>
        <rule target="controlPart"
              selector="type=input;part=editor;tags=readOnly currentOrderField"
              styles="{fontColor:#6896B2;}"/>
        <rule target="controlPart"
              selector="type=input;part=editor;tags=readOnly formField"
              styles="{fontColor:#AE7A55;}"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>