<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1"
      zoom="90%">
  <grid anchorCell="A1">
    <controls:label name="InputTitle"
                    row="2"
                    column="2"
                    columnSpan="5"
                    style="sectionTitle"
                    text="{Binding Path=Text.InputTitle}"/>
    <controls:label name="InputHelp"
                    row="3"
                    column="2"
                    columnSpan="5"
                    style="helpText"
                    text="{Binding Path=Text.InputHelp}"/>
    <controls:form name="Registration"
                   dataContext="{Binding Path=Form}"
                   row="5"
                   column="2"
                   columnSpan="3"
                   orientation="vertical"
                   labelPosition="left"
                   labelStyle="fieldLabel"
                   fieldStyle="inputField">
      <field name="PersonName"
             type="text"
             columnSpan="3"
             value="{Binding Path=PersonName}"
             label="{Binding Path=Text.PersonName}"
             numberFormat="@"/>
    </controls:form>
    <controls:form name="OriginForm"
                   dataContext="{Binding Path=Form}"
                   row="7"
                   column="2"
                   columnSpan="3"
                   orientation="vertical"
                   labelPosition="left"
                   labelStyle="fieldLabel"
                   fieldStyle="inputField">
      <field name="Origin"
             type="text"
             columnSpan="3"
             value="{Binding Path=Origin}"
             label="{Binding Path=Text.Origin}"
             numberFormat="@"/>
    </controls:form>
    <controls:button name="Register"
                     row="5"
                     column="6"
                     style="actionButton"
                     caption="{Binding Path=Text.Register}"
                     command="{Binding Path=Commands.Register}"/>
    <controls:label name="ReplaceTitle"
                    row="10"
                    column="2"
                    columnSpan="5"
                    style="sectionTitle"
                    text="{Binding Path=Text.ReplaceTitle}"/>
    <controls:label name="ReplaceHelp"
                    row="11"
                    column="2"
                    columnSpan="5"
                    style="helpText"
                    text="{Binding Path=Text.ReplaceHelp}"/>
    <controls:form name="PreviousIdForm"
                   dataContext="{Binding Path=Form}"
                   row="13"
                   column="2"
                   columnSpan="3"
                   orientation="vertical"
                   labelPosition="left"
                   labelStyle="fieldLabel"
                   fieldStyle="inputField">
      <field name="PreviousId"
             type="text"
             columnSpan="3"
             value="{Binding Path=PreviousId}"
             label="{Binding Path=Text.PreviousId}"
             numberFormat="@"/>
    </controls:form>
    <controls:form name="NewIdForm"
                   dataContext="{Binding Path=Form}"
                   row="15"
                   column="2"
                   columnSpan="3"
                   orientation="vertical"
                   labelPosition="left"
                   labelStyle="fieldLabel"
                   fieldStyle="inputField">
      <field name="NewId"
             type="text"
             columnSpan="3"
             value="{Binding Path=NewId}"
             label="{Binding Path=Text.NewId}"
             numberFormat="@"/>
    </controls:form>
    <controls:button name="ReplaceId"
                     row="13"
                     column="6"
                     style="actionButton"
                     caption="{Binding Path=Text.ReplaceId}"
                     command="{Binding Path=Commands.ReplaceId}"/>
    <controls:label name="ResultTitle"
                    row="2"
                    column="8"
                    columnSpan="3"
                    style="sectionTitle"
                    text="{Binding Path=Text.ResultTitle}"/>
    <controls:label name="ResultHelp"
                    row="3"
                    column="8"
                    columnSpan="3"
                    style="helpText"
                    text="{Binding Path=Text.ResultHelp}"/>
    <controls:label name="Result"
                    row="5"
                    column="8"
                    rowSpan="5"
                    columnSpan="3"
                    style="resultPanel"
                    text="{Binding Path=Form.Result}"/>
    <controls:label name="RegistryPath"
                    row="18"
                    column="2"
                    columnSpan="9"
                    style="helpText"
                    text="{Binding Path=Text.RegistryPath}"/>
  </grid>
  <styles>
    <controlStyle name="sectionTitle"
                  backColor="#262626"
                  textColor="#FFA45C"
                  fontName="Calibri"
                  fontSize="16"
                  fontBold="true"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="helpText"
                  backColor="#262626"
                  textColor="#A0A0A0"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="center"
                  overflow="wrap"/>
    <controlStyle name="fieldLabel"
                  backColor="#262626"
                  textColor="#F2F2F2"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  horizontal="right"
                  vertical="center"/>
    <controlStyle name="inputField"
                  backColor="#3A3A3A"
                  textColor="#F2F2F2"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="center"/>
    <controlStyle name="actionButton"
                  backColor="#3A3A3A"
                  textColor="#FFA45C"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="resultPanel"
                  backColor="#333333"
                  textColor="#F2F2F2"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="left"
                  vertical="top"
                  overflow="wrap"/>
    <stylePipelineStage name="default">
      <layer name="sheet">
        <rule target="sheet"
              styles="{backColor:#262626;fontColor:#F2F2F2;fontName:Calibri;fontSize:11;borderColor:#000000;borderWeight:thin;borderScope:all;rowHeight:16;gridLines:false;zoom:90%;}"/>
        <rule target="column"
              selector="address=A:A"
              styles="{width:3;}"/>
        <rule target="column"
              selector="address=B:B"
              styles="{width:20;}"/>
        <rule target="column"
              selector="address=C:D"
              styles="{width:24;}"/>
        <rule target="column"
              selector="address=E:E"
              styles="{width:3;}"/>
        <rule target="column"
              selector="address=F:F"
              styles="{width:23;}"/>
        <rule target="column"
              selector="address=G:G"
              styles="{width:6;}"/>
        <rule target="column"
              selector="address=H:J"
              styles="{width:20;}"/>
        <rule target="column"
              selector="address=K:K"
              styles="{width:3;}"/>
        <rule target="row"
              selector="address=2:2"
              styles="{rowHeight:32;}"/>
        <rule target="row"
              selector="address=3:3"
              styles="{rowHeight:42;}"/>
        <rule target="row"
              selector="address=5:5"
              styles="{rowHeight:44;}"/>
        <rule target="row"
              selector="address=7:7"
              styles="{rowHeight:44;}"/>
        <rule target="row"
              selector="address=10:10"
              styles="{rowHeight:32;}"/>
        <rule target="row"
              selector="address=11:11"
              styles="{rowHeight:42;}"/>
        <rule target="row"
              selector="address=13:13"
              styles="{rowHeight:44;}"/>
        <rule target="row"
              selector="address=15:15"
              styles="{rowHeight:44;}"/>
        <rule target="row"
              selector="address=18:18"
              styles="{rowHeight:32;}"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>