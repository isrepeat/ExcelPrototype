<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1"
      zoom="80%">
  <grid row="2"
        column="2">
    <controls:button name="EnvironmentSwitch"
                     row="1"
                     column="17"
                     style="secondaryButton"
                     caption="{Binding Path=Text.EnvironmentSwitch}"
                     command="{Binding Path=Commands.EnvironmentSwitch}"
                     shapePlacement="moveAndSize"/>
    <controls:button name="OpenTests"
                     row="1"
                     column="9"
                     columnSpan="2"
                     style="secondaryButton"
                     caption="{Binding Path=Text.TestsRefresh}"
                     command="{Binding Path=Commands.OpenTests}"/>
    <controls:label name="TestStatus"
                    row="2"
                    column="1"
                    columnSpan="16"
                    text="{Binding Path=Form.ActionStatus}"/>
    <controls:table name="TestCatalog"
                  itemsSource="{Binding Path=Data.TestCatalog}"
                  row="4"
                  column="1"
                  style="testCatalog"
                  representation="Smart"
                  excelTableName="tbPebTestCatalog"
                  showHeaders="true"/>
  </grid>
  <styles>
    <controlStyle name="testCatalog"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"
                  overflow="wrap"/>
    <controlStyle name="testCheckbox"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="sectionTitle"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="secondaryButton"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#3B3B3B"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{
                backColor:#262626;
                fontColor:#FFFFFF;
                fontName:Calibri;
                fontSize:11;
                borderColor:#000000;
                borderWeight:thin;
                rowHeight:30;
                overflow:wrap;
                gridLines:true;
              }"/>
        <rule target="column"
              selector="address=A:A"
              styles="{width:2;}"/>
        <rule target="column"
              selector="address=B:Q"
              styles="{width:15;}"/>
        <rule target="column"
              selector="address=E:E"
              styles="{width:35;}"/>
        <rule target="column"
              selector="address=R:R"
              styles="{width:17;}"/>
        <rule target="column"
              selector="address=S:S"
              styles="{width:15;}"/>
        <rule target="column"
              selector="address=T:T"
              styles="{width:3;}"/>
        <rule target="column"
              selector="address=U:U"
              styles="{width:15;}"/>
      </layer>
      <layer name="table-parts">
        <rule target="controlPart"
              selector="type=table;name=TestCatalog;part=rows;columnAlias=Подія / сценарій"
              styles="{horizontal:left;}"/>
        <rule target="controlPart"
              selector="type=table;name=TestCatalog;part=header;columnAlias=Подія / сценарій"
              styles="{horizontal:left;}"/>
        <rule target="controlPart"
              selector="type=table;part=header"
              styles="{backColor:#3A3A3A;fontColor:#FFFFFF;fontBold:true;}"/>
        <rule target="controlPart"
              selector="type=table;part=row;tags=even"
              styles="{backColor:#383838;}"/>
        <rule target="usedRange"
              selector="row=1"
              styles="{rowHeight:10;}"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>