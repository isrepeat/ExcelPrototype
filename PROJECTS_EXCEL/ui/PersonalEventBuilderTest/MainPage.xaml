<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles"
      xmlns:controls="urn:excelprototype:controls"
      version="1"
      zoom="80%"
      styleSources="../PersonalEventBuilder/CommonControlStyles.xaml">
  <grid row="2"
        column="2">
    <controls:button name="TestSelectAll"
                     row="1"
                     column="1"
                     columnSpan="4"
                     style="secondaryButton"
                     caption="{Binding Path=Text.TestsSelectAll}"
                     command="{Binding Path=Commands.TestSelectAll}"/>
    <controls:button name="TestRun"
                     row="1"
                     column="5"
                     columnSpan="4"
                     style="secondaryButton"
                     caption="{Binding Path=Text.TestsRun}"
                     command="{Binding Path=Commands.TestRun}"/>
    <controls:button name="TestSelectNone"
                     row="2"
                     column="1"
                     columnSpan="4"
                     style="secondaryButton"
                     caption="{Binding Path=Text.TestsSelectNone}"
                     command="{Binding Path=Commands.TestSelectNone}"/>
    <controls:button name="TestStop"
                     row="2"
                     column="5"
                     columnSpan="4"
                     style="testStopButton"
                     caption="{Binding Path=Text.TestsStop}"
                     command="{Binding Path=Commands.CancelTests}"/>
    <controls:button name="EnvironmentSwitch"
                     row="1"
                     column="17"
                     style="secondaryButton"
                     caption="{Binding Path=Text.EnvironmentSwitch}"
                     command="{Binding Path=Commands.EnvironmentSwitch}"
                     shapePlacement="moveAndSize"/>
    <controls:label name="TestStatus"
                    row="3"
                    column="1"
                    columnSpan="16"
                    text="{Binding Path=Form.ActionStatus}"/>
    <stackPanel row="5"
                column="1"
                orientation="vertical">
      <controls:table name="TestCatalog"
                      itemsSource="{Binding Path=Data.TestCatalog}"
                      style="testCatalog"
                      representation="Smart"
                      excelTableName="tbPebTestCatalog"
                      showAutoFilter="false"
                      showHeaders="true"/>
      <controls:label name="TestResultsTitle"
                      columnSpan="16"
                      text="{Binding Path=Text.TestsResults}"/>
      <controls:table name="TestResults"
                      itemsSource="{Binding Path=Data.TestResults}"
                      style="testCatalog"
                      representation="Smart"
                      excelTableName="tbPebTestResults"
                      showAutoFilter="false"
                      showHeaders="true">
        <controls:table.cellTemplates>
          <controls:cellTemplate columnAlias="PreviewLink"
                                 mode="replace">
            <controls:button name="PreviewLink"
                             style="secondaryButton"
                             caption="{Binding Path=Cell.Value}"
                             command="{Binding Path=Commands.TestPreview}"/>
          </controls:cellTemplate>
        </controls:table.cellTemplates>
      </controls:table>
      <controls:items name="TestDocuments"
                      itemsSource="{Binding Path=Data.TestPreviews}"
                      gapRows="1">
        <controls:label name="TestDocument"
                        rowSpan="7"
                        columnSpan="6"
                        style="testDocument"
                        text="{Binding Path=Item.Text}"/>
      </controls:items>
    </stackPanel>
  </grid>
  <styles>
    <controlStyle name="testDocument"
                  backColor="#3B3B3B"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  horizontal="left"
                  vertical="top"
                  overflow="wrap"/>
    <controlStyle name="testCatalog"
                  backColor="#2D2D2D"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"
                  overflow="wrap"/>
    <controlStyle name="testCheckbox"
                  backColor="#2D2D2D"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  borderColor="#2D2D2D"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="sectionTitle"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#333333"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="12"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="testStopButton"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#B03535"
                  textColor="#FFFFFF"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <controlStyle name="secondaryButton"
                  indent="0"
                  paddingLeft="10"
                  paddingRight="10"
                  backColor="#3B3B3B"
                  textColor="#F4A46B"
                  fontName="Calibri"
                  fontSize="11"
                  fontBold="true"
                  borderColor="#000000"
                  borderWeight="thin"
                  horizontal="center"
                  vertical="center"/>
    <stylePipelineStage name="default">
      <layer name="sheet-base">
        <rule target="sheet"
              styles="{
                backColor:#262626;
                fontColor:#FFFFFF;
                fontName:Calibri;
                fontSize:11;
                borderColor:#000000;
                borderWeight:thin;
                rowHeight:30;
                overflow:wrap;
                gridLines:true;
              }"/>
        <rule target="column"
              selector="address=A:A"
              styles="{
                width:2;
              }"/>
        <rule target="column"
              selector="address=B:Q"
              styles="{
                width:15;
              }"/>
        <rule target="column"
              selector="address=E:E"
              styles="{
                width:35;
              }"/>
        <rule target="column"
              selector="address=R:R"
              styles="{
                width:17;
              }"/>
        <rule target="column"
              selector="address=S:S"
              styles="{
                width:15;
              }"/>
        <rule target="column"
              selector="address=T:T"
              styles="{
                width:3;
              }"/>
        <rule target="column"
              selector="address=U:U"
              styles="{
                width:15;
              }"/>
      </layer>
      <layer name="table-parts">
        <rule target="controlPart"
              selector="type=table;name=TestCatalog;part=rows;columnAlias=Подія / сценарій"
              styles="{
                horizontal:left;
              }"/>
        <rule target="controlPart"
              selector="type=table;name=TestCatalog;part=header;columnAlias=Подія / сценарій"
              styles="{
                horizontal:left;
              }"/>
        <rule target="controlPart"
              selector="type=table;part=header"
              styles="{
                backColor:#3A3A3A;
                fontColor:#FFFFFF;
                fontBold:true;
              }"/>
        <rule target="controlPart"
              selector="type=table;part=row;tags=even"
              styles="{
                backColor:#383838;
              }"/>
        <rule target="controlPart"
              selector="type=table;part=header"
              styles="{
                borderColor:#000000;
                borderWeight:thin;
                borderLineStyle:continuous;
                borderScope:all;
              }"/>
        <rule target="controlPart"
              selector="type=table;part=rows"
              styles="{
                borderColor:#000000;
                borderWeight:thin;
                borderLineStyle:continuous;
                borderScope:all;
              }"/>
        <rule target="usedRange"
              selector="row=1"
              styles="{
                rowHeight:10;
              }"/>
        <rule target="usedRange"
              selector="row=2"
              styles="{
                rowHeight:36;
              }"/>
        <rule target="usedRange"
              selector="row=3"
              styles="{
                rowHeight:36;
              }"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>