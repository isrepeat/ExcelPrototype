<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles" version="1">
  <grid anchorCell="A1">
    <stackPanel at="r2c2" orientation="vertical">
      <stackPanel orientation="horizontal">
        <control
          type="Hotkeys"
          name="SheetHotkeys"
          dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder.Controller'}"
          itemsSource="{PageRuntimeSource='RuntimeItems.PrsnlEvntBuilder.Hotkeys'}"
          actionMethod="RuntimeHandleHotkeyAction"
          tableName="tblPrsnlEvntBuilderHotkeys"
          spanColls="2"/>
      </stackPanel>

      <stackPanel spanColls="22" spanRows="1"/>

      <control
        type="Select"
        name="EventDraftSectionType"
        itemsSource="{PageRuntimeSource='RuntimeItems.PrsnlEvntBuilder.SectionTypes'}"
        placeholder="Тип події"
        style="configSelectHeader"
        panelStyle="configSelectPanel"
        itemStyle="configSelectItem"
        itemHeight="25"
        itemMargin="2"
        spanColls="2"
        spanRows="3"/>

      <stackPanel name="EventDraftForm" orientation="vertical" spanColls="22" spanRows="2">
        <stackPanel name="EventDraftHeaders" orientation="horizontal" spanColls="22" spanRows="1">
          <control
            type="Label"
            name="HospitalHeader"
            text="Лікарня"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="HospitalShortHeader"
            text="Лікарня скорочена назва"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="VacationHeader"
            text="Відпустка"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="RankHeader"
            text="Звання"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="FioHeader"
            text="ПІБ"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="IpnHeader"
            text="ІПН"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="PositionCodeHeader"
            text="Код посади"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="PositionNameHeader"
            text="Посада"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="ReportTvoHeader"
            text="Рапорт ТВО"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="ReportPersonHeader"
            text="Рапорт кого"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="IncomingNoHeader"
            text="Вх. №"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="IncomingDateHeader"
            text="Вх. дата"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="DocumentNoteHeader"
            text="Документ / Замітки"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="DocNoHeader"
            text="Док. №"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="DocDateHeader"
            text="Док. дата"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="DurationDaysHeader"
            text="На скільки"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="DateFromHeader"
            text="З"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="DateToHeader"
            text="По"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="VhNoHeader"
            text="В/к №"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="VhDateHeader"
            text="В/к дата"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="VlkNoHeader"
            text="ВЛК №"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="VlkDateHeader"
            text="ВЛК дата"
            style="tableHeaderCell"
            />
        </stackPanel>

        <stackPanel name="EventDraftValues" orientation="horizontal" spanColls="22" spanRows="1">
          <control
            type="Input"
            name="HospitalLookupInput"
            dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder'}"
            value="{Binding Path=LookupQueryValues.Hospital}"
            onChange="{Binding Method=OnLookupInputCellChangedCommand}"
            onChangeArg="Hospital"
            spanColls="1"
            spanRows="1"/>

          <control
            type="Label"
            name="HospitalShortDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="VacationDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="RankDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Input"
            name="FioLookupInput"
            dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder'}"
            value="{Binding Path=LookupQueryValues.FIO}"
            onChange="{Binding Method=OnLookupInputCellChangedCommand}"
            onChangeArg="FIO"
            spanColls="1"
            spanRows="1"/>

          <control
            type="Label"
            name="IpnDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="PositionCodeDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="PositionNameDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="ReportTvoDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Input"
            name="CommanderLookupInput"
            dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder'}"
            value="{Binding Path=LookupQueryValues.Commander}"
            onChange="{Binding Method=OnLookupInputCellChangedCommand}"
            onChangeArg="Commander"
            spanColls="1"
            spanRows="1"/>

          <control
            type="Label"
            name="IncomingNoDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="IncomingDateDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="DocumentNoteDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="DocNoDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="DocDateDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="DurationDaysDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="DateFromDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="DateToDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="VhNoDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="VhDateDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="VlkNoDraftCell"
            text=""
            style="tableDataCell"
            />

          <control
            type="Label"
            name="VlkDateDraftCell"
            text=""
            style="tableDataCell"
            />
        </stackPanel>
      </stackPanel>

      <stackPanel orientation="vertical" spanColls="50">
        <control
          type="LookupCandidates"
          name="LookupCandidatesTable"
          dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder.Controller'}"
          lookupFeature="{Binding Path=LookupFeature}"
          itemsSource="{PageRuntimeSource='RuntimeItems.PrsnlEvntBuilder.EntityLookup.CandidateTables'}"
          itemVisibility="{Binding Path=RowCount; Op=gt; Value=0; TrueAs=Visible; FalseAs=Collapsed}"
          spanColls="50"/>
        <!-- <control
          type="TableList"
          name="PrsnlEvntBuilderDummyTable"
          dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder.Controller'}"
          itemsSource="{PageRuntimeSource='RuntimeItems.PrsnlEvntBuilder.DummyTables'}"
          spanColls="6"/> -->
      </stackPanel>

    </stackPanel>
  </grid>

  <styles>
    <controlStyle
      name="configSelectHeader"
      backColor="#438E20"
      textColor="#0A0A0A"
      borderColor="#285D14"
      borderWeight="1"
      fontName="Calibri"
      fontSize="14"
      fontBold="false"/>

    <controlStyle
      name="configSelectPanel"
      backColor="#2B3138"
      textColor="#F1F5F9"
      borderColor="#1C2024"
      borderWeight="0.75"
      fontName="Calibri"
      fontSize="13"
      fontBold="false"/>

    <controlStyle
      name="configSelectItem"
      backColor="#3B424A"
      textColor="#F8FAFC"
      borderColor="#282D32"
      borderWeight="0.75"
      fontName="Calibri"
      fontSize="13"
      fontBold="false"/>

    <stylePipelineStage name="default">
      <layer name="entitylookup-base">
        <rule target="sheet"
              styles="{
                backColor:#1F2329;
                fontColor:#E5E7EB;
                borderColor:#111318;
                borderWeight:thin;
                width:15;
                rowHeight:21;
                cellType:text;
                zoom:80%;
              }"/>

        <rule target="column"
              selector="address=A:A"
              styles="{ width:2.38; }"/>
      </layer>

      <layer name="entitylookup-lookup-inputs">
        <rule target="controlPart"
              selector="type=input;part=cell"
              styles="{
                backColor:#2B3036;
                fontColor:#F8FAFC;
                borderColor:#6B7280;
                borderWeight:thin;
                horizontal:left;
                vertical:center;
                cellType:text;
              }"/>
      </layer>

      <layer name="event-draft-form">
        <rule target="layoutContainer"
              selector="name=EventDraftHeaders"
              styles="{
                horizontal:center;
                vertical:center;
                overflow:wrap;
                rowHeight:48;
              }"/>

        <rule target="layoutContainer"
              selector="name=EventDraftValues"
              styles="{
                horizontal:center;
                vertical:center;
                overflow:wrap;
                rowHeight:64;
              }"/>

        <!-- <rule target="controlPart"
              selector="type=input;part=cell"
              styles="{
                overflow:wrap;
                rowHeight:64;
                vertical:center;
              }"/> -->

        <rule target="controlPart" selector="type=label;name=HospitalHeader;part=cell" styles="{ width:24; }"/>
        <rule target="controlPart" selector="type=label;name=HospitalShortHeader;part=cell" styles="{ width:12; }"/>
        <rule target="controlPart" selector="type=label;name=VacationHeader;part=cell" styles="{ width:16; }"/>
        <rule target="controlPart" selector="type=label;name=RankHeader;part=cell" styles="{ width:16; }"/>
        <rule target="controlPart" selector="type=label;name=FioHeader;part=cell" styles="{ width:22; }"/>
        <rule target="controlPart" selector="type=label;name=IpnHeader;part=cell" styles="{ width:16; }"/>
        <rule target="controlPart" selector="type=label;name=PositionCodeHeader;part=cell" styles="{ width:12; }"/>
        <rule target="controlPart" selector="type=label;name=PositionNameHeader;part=cell" styles="{ width:18; }"/>
        <rule target="controlPart" selector="type=label;name=ReportTvoHeader;part=cell" styles="{ width:7.5; }"/>
        <rule target="controlPart" selector="type=label;name=ReportPersonHeader;part=cell" styles="{ width:23.5; }"/>
        <rule target="controlPart" selector="type=label;name=IncomingNoHeader;part=cell" styles="{ width:9; }"/>
        <rule target="controlPart" selector="type=label;name=IncomingDateHeader;part=cell" styles="{ width:7; }"/>
        <rule target="controlPart" selector="type=label;name=DocumentNoteHeader;part=cell" styles="{ width:13; }"/>
        <rule target="controlPart" selector="type=label;name=DocNoHeader;part=cell" styles="{ width:7; }"/>
        <rule target="controlPart" selector="type=label;name=DocDateHeader;part=cell" styles="{ width:8; }"/>
        <rule target="controlPart" selector="type=label;name=DurationDaysHeader;part=cell" styles="{ width:9; }"/>
        <rule target="controlPart" selector="type=label;name=DateFromHeader;part=cell" styles="{ width:7.5; }"/>
        <rule target="controlPart" selector="type=label;name=DateToHeader;part=cell" styles="{ width:7.5; }"/>
        <rule target="controlPart" selector="type=label;name=VhNoHeader;part=cell" styles="{ width:9; }"/>
        <rule target="controlPart" selector="type=label;name=VhDateHeader;part=cell" styles="{ width:9; }"/>
        <rule target="controlPart" selector="type=label;name=VlkNoHeader;part=cell" styles="{ width:12; }"/>
        <rule target="controlPart" selector="type=label;name=VlkDateHeader;part=cell" styles="{ width:9; }"/>
      </layer>

      <layer name="entitylookup-labels">
        <rule target="controlPart"
              selector="type=tablelist;part=section"
              styles="{
                backColor:#242424;
                fontColor:#00B0F0;
                borderColor:#111318;
                borderWeight:thin;
                fontBold:true;
                horizontal:center;
              }"/>

        <rule target="controlPart"
              selector="type=tablelist;part=header"
              styles="{
                backColor:#00370F;
                fontColor:#92D050;
                borderColor:#000000;
                borderWeight:thin;
                fontBold:false;
                horizontal:center;
                overflow:wrap;
              }"/>

        <rule target="controlPart"
              selector="type=tablelist;part=rows"
              styles="{
                backColor:#00370F;
                fontColor:#F8FAFC;
                borderColor:#000000;
                borderWeight:thin;
                vertical:center;
                overflow:wrap;
                rowHeight:34;
              }"/>
      </layer>

      <layer name="hotkey-panel">
        <rule target="controlPart"
              selector="type=hotkeys;part=action"
              styles="{
                backColor:#7E2479;
                fontColor:#FFFFFF;
                borderColor:#31112F;
                borderWeight:thin;
                horizontal:center;
                vertical:center;
                cellType:text;
              }"/>

        <rule target="controlPart"
              selector="type=hotkeys;part=hotkey"
              styles="{
                backColor:#7E2479;
                fontColor:#C58AC9;
                borderColor:#31112F;
                borderWeight:thin;
                horizontal:center;
                vertical:center;
                cellType:text;
              }"/>
      </layer>

      <layer name="layout-debug-bounds">
        <rule target="layoutBound"
              selector="tag=grid"
              styles="{
                borderColor:#8B5CF6;
                borderWeight:medium;
                borderLineStyle:solid;
              }"/>

        <rule target="layoutBound"
              selector="tag=control"
              styles="{
                borderColor:#FF0000;
                borderWeight:thin;
                borderLineStyle:solid;
              }"/>

        <rule target="layoutBound"
              selector="tag=stackpanel;tagDepth=0"
              styles="{
                borderColor:#444444;
                borderWeight:medium;
                borderLineStyle:dash;
              }"/>

        <rule target="layoutBound"
              selector="tag=stackpanel;tagDepth=1"
              styles="{
                borderColor:#5E5E5E;
                borderWeight:medium;
                borderLineStyle:dash;
              }"/>

        <rule target="layoutBound"
              selector="tag=stackpanel;tagDepth=2"
              styles="{
                borderColor:#777777;
                borderWeight:medium;
                borderLineStyle:dash;
              }"/>

       <rule target="layoutBound"
              selector="tag=stackpanel;tagDepth=3:10"
              styles="{
                borderColor:#999999;
                borderWeight:medium;
                borderLineStyle:dash;
              }"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>
