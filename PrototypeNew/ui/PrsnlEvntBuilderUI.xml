          <control
            type="Label"
            name="DocDateHeader"
            text="Док. дата"
            visibility="{Binding Path=DocDateFieldVisibilityState}"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="DurationDaysHeader"
            text="На скільки"
            visibility="{Binding Path=DurationDaysFieldVisibilityState}"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="DateFromHeader"
            text="З"
            visibility="{Binding Path=DateFromFieldVisibilityState}"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="DateToHeader"
            text="По"
