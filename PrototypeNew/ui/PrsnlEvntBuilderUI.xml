<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles" version="1">
  <grid anchorCell="A1">
    <stackPanel at="r2c2" orientation="vertical">
      <stackPanel orientation="horizontal">
        <control
          type="Hotkeys"
          name="SheetHotkeys"
          dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder.Controller'}"
          itemsSource="{PageRuntimeSource='RuntimeItems.PrsnlEvntBuilder.Hotkeys'}"
          actionMethod="RuntimeHandleHotkeyAction"
          tableName="tblPrsnlEvntBuilderHotkeys"
          spanColls="2"/>

        <control
          type="Button"
          name="UpdateSheet"
          caption="Update Sheet"
          style="actionWarning"
          dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder'}"
          onClick="{Binding Method=OnRenderCommand}"
          spanColls="5"
          spanRows="2"/>
      </stackPanel>

      <stackPanel spanColls="22" spanRows="1"/>

      <stackPanel name="EventDraftSectionTypeRow" orientation="horizontal">
        <control
          type="ButtonGroup"
          name="EventDraftSectionTypeButtonGroup"
          itemsSource="{PageRuntimeSource='RuntimeItems.PrsnlEvntBuilder.SectionTypes'}"
          captionPath="Caption"
          idPath="Id"
          stylePath="StyleName"
          shapePrefix="btn_STBar_"
          onClick="{Binding DataContext={PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder.Controller'}; Method=OnSectionTypeButtonClick}"
          columns="4"
          flow="column"
          itemSpanRows="2"
          spanColls="8"
          spanRows="11"/>
        
        <control
          type="Label"
          name="EventDraftOrderNoHeader"
          text="Номер наказу:"
          style="tableHeaderCell"
          spanColls="1"
          spanRows="1"/>

        <stackPanel name="EventDraftOrderNoValue" orientation="horizontal">
          <control
            type="Label"
            name="EventDraftOrderNoLabel"
            text=""
            style="tableDataCell"
            spanColls="1"
            spanRows="1"/>
        </stackPanel>
      </stackPanel>

      <stackPanel
        name="EventDraftForm"
        dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder.Controller'}"
