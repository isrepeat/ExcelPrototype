            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="VhNoHeader"
            text="В/к №"
            visibility="{Binding Path=VhNoFieldVisibilityState}"
            style="tableHeaderCell"
            />
          <control
            type="Label"
            name="VhDateHeader"
            text="В/к дата"
