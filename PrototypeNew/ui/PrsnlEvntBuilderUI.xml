      </stackPanel>

      <stackPanel orientation="vertical" spanColls="50">
        <control
          type="LookupCandidates"
          name="LookupCandidatesTable"
          dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder.Controller'}"
          lookupFeature="{Binding Path=LookupFeature}"
          itemsSource="{PageRuntimeSource='RuntimeItems.PrsnlEvntBuilder.EntityLookup.CandidateTables'}"
          itemVisibility="{Binding Path=RowCount; Op=gt; Value=0; TrueAs=Visible; FalseAs=Collapsed}"
          spanColls="50"/>
        <!-- <control
          type="TableList"
          name="PrsnlEvntBuilderDummyTable"
          dataContext="{PageRuntimeSource='RuntimeObjects.PrsnlEvntBuilder.Controller'}"
          itemsSource="{PageRuntimeSource='RuntimeItems.PrsnlEvntBuilder.DummyTables'}"
          spanColls="6"/> -->
