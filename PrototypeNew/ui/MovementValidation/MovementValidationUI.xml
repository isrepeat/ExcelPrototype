<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles" version="1">
  <grid anchorCell="A1">
    <stackPanel at="r3c6" orientation="horizontal">
      <control
        type="Label"
        name="OrderNoLabel"
        text="Номер наказу"/>
      <control
        type="Input"
        name="OrderNoInput"
        dataContext="{PageRuntimeSource='RuntimeObjects.MultiSourcesView.Controller'}"
        value="{Binding Path=OrderNoText}"
        style="validationInput"/>
    </stackPanel>

    <stackPanel at="r2c8" orientation="vertical">
      <control
        type="TableList"
        name="PreviousOrders"
        itemsSource="{PageRuntimeSource='RuntimeItems.MovementValidation.PreviousOrders'}"
        spanColls="2"/>
    </stackPanel>

    <stackPanel at="r5c6" orientation="vertical">
      <control
        type="Button"
        name="RunValidation"
        caption="Перевірити"
        style="modeAccent"
        dataContext="{PageRuntimeSource='RuntimeObjects.MultiSourcesView'}"
        onClick="{Binding Method=OnRunPipelineAndRenderCommand}"
        spanColls="2"
        spanRows="2"/>
    </stackPanel>

    <stackPanel at="r11c2" orientation="vertical">
      <control
        type="TableList"
        name="ValidationResults"
        itemsSource="{PageRuntimeSource='RuntimeItems.MultiSourcesView.Tables'}"
        spanColls="17"/>
    </stackPanel>
  </grid>

  <styles>
    <controlStyle
      name="modeAccent"
      backColor="#2563EB"
      textColor="#FFFFFF"
      borderColor="#1D4ED8"
      fontBold="true"/>
    <stylePipelineStage name="default">
      <layer name="base">
        <rule target="sheet"
              styles="{
                backColor:#20242A;
                fontColor:#E5E7EB;
                borderColor:#111318;
                borderWeight:thin;
                width:14.4;
                rowHeight:20;
                cellType:text;
              }"/>
      </layer>
      <layer name="results">
        <rule target="controlPart"
              selector="type=input;name=OrderNoInput;part=cell"
              styles="{
                backColor:#595959;
                fontColor:#FFFFFF;
                borderColor:#A6A6A6;
                borderWeight:medium;
                fontBold:true;
              }"/>

        <rule target="controlPart"
              selector="type=tablelist;name=PreviousOrders;part=header"
              styles="{
                backColor:#111111;
                fontColor:#FFFFFF;
                fontBold:true;
                horizontal:center;
              }"/>

        <rule target="controlPart"
              selector="type=tablelist;name=PreviousOrders;part=rows"
              styles="{
                backColor:#30343B;
                fontColor:#DDEEFF;
                horizontal:center;
              }"/>

        <rule target="controlPart"
              selector="type=tablelist;name=ValidationResults;part=section"
              styles="{
                backColor:#173A5E;
                fontColor:#EAF6FF;
                fontBold:true;
                rowHeight:25;
              }"/>
        <rule target="controlPart"
              selector="type=tablelist;name=ValidationResults;part=header"
              styles="{
                backColor:#111111;
                fontColor:#FFFFFF;
                fontBold:true;
                horizontal:center;
                rowHeight:25;
              }"/>
        <rule target="controlPart"
              selector="type=tablelist;name=ValidationResults;part=rows"
              styles="{
                backColor:#3A3A3A;
                fontColor:#F0F0F0;
                horizontal:center;
                overflow:wrap;
                rowHeight:22;
              }"/>

        <rule target="controlPart"
              selector="type=tablelist;name=ValidationResults;part=tag-validation-ok"
              styles="{
                backColor:#1F561B;
                fontColor:#F5F5F5;
                horizontal:center;
                overflow:wrap;
                rowHeight:22;
              }"/>

        <rule target="controlPart"
              selector="type=tablelist;name=ValidationResults;part=tag-validation-conflict"
              styles="{
                backColor:#9C0006;
                fontColor:#FFFFFF;
                horizontal:center;
                overflow:wrap;
                rowHeight:22;
              }"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>
