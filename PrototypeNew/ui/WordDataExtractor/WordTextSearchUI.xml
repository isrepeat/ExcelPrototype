<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles" version="1">
  <grid anchorCell="A1">
    <stackPanel at="r2c2" orientation="vertical">
      <stackPanel orientation="horizontal">
        <stackPanel orientation="vertical" spanColls="1" spanRows="2">
          <control
            type="Button"
            name="ToggleSearchEmpty"
            caption="{Binding Path=ShowEmptyTables;TrueAs=Отображение [[[color=#FFFF00]]все[[/color]]];FalseAs=Отображение [[[color=#FFFF00]]не пустые[[/color]]]}"
            dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
            onClick="{Binding Method=ToggleEmptyTables}"
            spanColls="1"
            spanRows="1"/>

          <control
            type="Button"
            name="ToggleRegexMode"
            caption="{Binding Path=IsRegexMode;TrueAs=Regex [[[ok]]ON[[/ok]]];FalseAs=Regex [[[color=#FF0000]]OFF[[/color]]]}"
            dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
            onClick="{Binding Method=ToggleRegexMode}"
            spanColls="1"
            spanRows="1"/>
        </stackPanel>

        <stackPanel orientation="vertical" spanColls="1" spanRows="3">
          <control
            type="Button"
            name="RunTextSearch"
            caption="Пошук у WORD"
            style="modeAccent"
            dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
            onClick="{Binding Method=SearchAndRender}"
            spanColls="1"
            spanRows="1"/>

          <control
            type="Input"
            name="SearchText"
            value="{Binding Path=SearchText}"
            dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
            onChange="{Binding Method=OnSearchTextChanged}"
            spanColls="1"
            spanRows="1"/>

          <control
            type="Button"
            name="CancelTextSearch"
            caption="Скасувати пошук"
            style="cancelAction"
            dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
            onClick="{Binding Method=CancelSearch}"
            spanColls="1"
            spanRows="1"/>
        </stackPanel>

        <stackPanel orientation="vertical" spanColls="4" spanRows="4">
          <stackPanel orientation="horizontal" spanColls="4" spanRows="1">
            <control
              type="Label"
              name="DateFromHeader"
              text="dateFrom"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateFromDayInput"
              value="{Binding Path=DateFromDay}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateFromDayChanged}"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateFromMonthInput"
              value="{Binding Path=DateFromMonth}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateFromMonthChanged}"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateFromYearInput"
              value="{Binding Path=DateFromYear}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateFromYearChanged}"
              spanColls="1"
              spanRows="1"/>
          </stackPanel>

          <stackPanel orientation="horizontal" spanColls="4" spanRows="1">
            <control
              type="Label"
              name="DateToHeader"
              text="dateTo"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateToDayInput"
              value="{Binding Path=DateToDay}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateToDayChanged}"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateToMonthInput"
              value="{Binding Path=DateToMonth}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateToMonthChanged}"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateToYearInput"
              value="{Binding Path=DateToYear}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateToYearChanged}"
              spanColls="1"
              spanRows="1"/>
          </stackPanel>

          <stackPanel orientation="horizontal" spanColls="4" spanRows="1">
            <control
              type="Label"
              name="ContextBeforeHeader"
              text="Строк выше"
              spanColls="2"
              spanRows="1"/>
            <control
              type="Input"
              name="ContextLinesBeforeInput"
              value="{Binding Path=ContextLinesBefore}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnContextLinesBeforeChanged}"
              spanColls="2"
              spanRows="1"/>
          </stackPanel>

          <stackPanel orientation="horizontal" spanColls="4" spanRows="1">
            <control
              type="Label"
              name="ContextAfterHeader"
              text="Строк ниже"
              spanColls="2"
              spanRows="1"/>
            <control
              type="Input"
              name="ContextLinesAfterInput"
              value="{Binding Path=ContextLinesAfter}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnContextLinesAfterChanged}"
              spanColls="2"
              spanRows="1"/>
          </stackPanel>
        </stackPanel>

        <control
          type="Button"
          name="UpdateSearchSheet"
          caption="Update Sheet"
          dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
          onClick="{Binding Method=Rerender}"
          spanColls="1"
          spanRows="1"/>

        <control
          type="Label"
          name="ToolbarHeightAnchor"
          text=""
          spanColls="1"
          spanRows="1"/>

        <control
          type="ButtonGroup"
          name="DocumentSources"
          itemsSource="{PageRuntimeSource='RuntimeItems.WordDataExtractor.Sources'}"
          style="documentSourceButton"
          onClick="{Binding DataContext={PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}; Method=ToggleDocumentSource}"
          columns="1"
          flow="column"
          itemSpanRows="1"
          shapePrefix="btn_WDESrc_"
          spanColls="5"
          spanRows="7"/>
      </stackPanel>

      <stackPanel spanColls="40" spanRows="1"/>

      <!-- Высота общей области и списка результатов измеряется по фактическому
           числу таблиц: фиксированный spanRows обрезал результат после 18 строк. -->
      <stackPanel orientation="horizontal" spanColls="12">
        <stackPanel
          name="SearchResultsPanel"
          orientation="vertical"
          spanColls="4">
          <control
            type="TableList"
            name="SearchResultTables"
            itemsSource="{PageRuntimeSource='RuntimeItems.WordDataExtractor.Tables'}"
            spanColls="4"/>
        </stackPanel>

        <stackPanel
          name="SearchPreviewPanel"
          orientation="vertical"
          spanColls="8"
          spanRows="18">
          <control
            type="Label"
            name="SearchPreviewHeader"
            text="Просмотр контекста"
            mergeCells="true"
            spanColls="8"
            spanRows="1"/>
          <control
            type="Label"
            name="SearchPreviewText"
            text="{Binding Path=SelectedPreviewText}"
            mergeCells="true"
            dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
            spanColls="8"
            spanRows="17"/>
        </stackPanel>
      </stackPanel>
    </stackPanel>
  </grid>

  <styles>
    <controlStyle
      name="modeAccent"
      backColor="#2563EB"
      textColor="#FFFFFF"
      borderColor="#1D4ED8"
      fontBold="true"/>

    <controlStyle
      name="documentSourceButton"
      backColor="#176B8A"
      textColor="#EAF6FF"
      borderColor="#0E4F69"
      horizontal="left"
      fontBold="true"/>

    <controlStyle
      name="cancelAction"
      backColor="#991B1B"
      textColor="#FFFFFF"
      borderColor="#7F1D1D"
      fontBold="true"/>

    <stylePipelineStage name="default">
      <layer name="base">
        <rule
          target="sheet"
          styles="{
            backColor:#20242A;
            fontColor:#E5E7EB;
            borderColor:#111318;
            borderWeight:thin;
            width:18;
            rowHeight:20;
            cellType:text;
          }"/>
      </layer>

      <layer name="search-input">
        <rule
          target="controlPart"
          selector="type=buttongroup;name=DocumentSources;part=state-selected"
          styles="{
            backColor:#14532D;
            fontColor:#DCFCE7;
            borderColor:#22C55E;
            fontBold:true;
          }"/>

        <rule
          target="controlPart"
          selector="type=label;name=ToolbarHeightAnchor;part=cell"
          styles="{
            rowHeight:40;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=SearchText;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            fontBold:true;
            horizontal:left;
            vertical:center;
            overflow:wrap;
            width:28;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=label;name=DateFromHeader;part=cell"
          styles="{
            backColor:#263445;
            fontColor:#CBD5E1;
            fontBold:true;
            horizontal:center;
            vertical:center;
            width:12;
            rowHeight:40;
          }"/>

        <rule
          target="controlPart"
          selector="type=label;name=DateToHeader;part=cell"
          styles="{
            backColor:#263445;
            fontColor:#CBD5E1;
            fontBold:true;
            horizontal:center;
            vertical:center;
            width:12;
            rowHeight:40;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateFromDayInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:7;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateFromMonthInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:7;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateFromYearInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:12;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateToDayInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:7;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateToMonthInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:7;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateToYearInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:12;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=label;name=ContextBeforeHeader;part=cell"
          styles="{
            backColor:#263445;
            fontColor:#CBD5E1;
            fontBold:true;
            horizontal:center;
            vertical:center;
            rowHeight:32;
          }"/>

        <rule
          target="controlPart"
          selector="type=label;name=ContextAfterHeader;part=cell"
          styles="{
            backColor:#263445;
            fontColor:#CBD5E1;
            fontBold:true;
            horizontal:center;
            vertical:center;
            rowHeight:32;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=ContextLinesBeforeInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            rowHeight:32;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=ContextLinesAfterInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            rowHeight:32;
            cellType:text;
          }"/>
      </layer>

      <layer name="tables">
        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=section"
          styles="{
            backColor:#173A5E;
            fontColor:#EAF6FF;
            fontBold:true;
            rowHeight:25;
          }"/>

        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=header"
          styles="{
            backColor:#2B4A6B;
            fontColor:#DDEEFF;
            fontBold:true;
            overflow:wrap;
            rowHeight:25;
          }"/>

        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=rows"
          styles="{
            backColor:#3A3A3A;
            fontColor:#F0F0F0;
            fontSize:8;
            overflow:wrap;
          }"/>

        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=rows;columnAlias=context"
          styles="{
            width:55;
            rowHeight:75;
          }"/>

        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=header;columnAlias=context"
          styles="{
            width:55;
          }"/>

        <rule
          target="controlPart"
          selector="type=label;name=SearchPreviewHeader;part=cell"
          styles="{
            backColor:#173A5E;
            fontColor:#EAF6FF;
            borderColor:#2B4A6B;
            fontBold:true;
            horizontal:left;
            vertical:center;
            rowHeight:28;
          }"/>

        <!-- Не задаём rowHeight для объединённого превью: Excel применяет высоту
             ко всей строке листа и иначе растягивает заголовки таблицы слева. -->
        <rule
          target="controlPart"
          selector="type=label;name=SearchPreviewText;part=cell"
          styles="{
            backColor:#30343A;
            fontColor:#F8FAFC;
            borderColor:#4B5563;
            horizontal:left;
            vertical:top;
            overflow:wrap;
          }"/>

        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=rows;columnAlias=matchIndex"
          styles="{
            horizontal:center;
            vertical:center;
          }"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>
