<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:excelprototype:profiles" version="1">
  <grid anchorCell="A1">
    <stackPanel at="r2c2" orientation="vertical">
      <stackPanel orientation="horizontal">
        <stackPanel orientation="vertical" spanColls="1" spanRows="2">
          <control
            type="Button"
            name="ToggleSearchEmpty"
            caption="{Binding Path=ShowEmptyTables;TrueAs=Отображение [[[color=#FFFF00]]все[[/color]]];FalseAs=Отображение [[[color=#FFFF00]]не пустые[[/color]]]}"
            dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
            onClick="{Binding Method=ToggleEmptyTables}"
            spanColls="1"
            spanRows="1"/>

          <control
            type="Button"
            name="ToggleRegexMode"
            caption="{Binding Path=IsRegexMode;TrueAs=Regex [[[ok]]ON[[/ok]]];FalseAs=Regex [[[color=#FF0000]]OFF[[/color]]]}"
            dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
            onClick="{Binding Method=ToggleRegexMode}"
            spanColls="1"
            spanRows="1"/>
        </stackPanel>

        <stackPanel orientation="vertical" spanColls="1" spanRows="2">
          <control
            type="Button"
            name="RunTextSearch"
            caption="Пошук у WORD"
            style="modeAccent"
            dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
            onClick="{Binding Method=SearchAndRender}"
            spanColls="1"
            spanRows="1"/>

          <control
            type="Input"
            name="SearchText"
            value="{Binding Path=SearchText}"
            dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
            onChange="{Binding Method=OnSearchTextChanged}"
            spanColls="1"
            spanRows="1"/>
        </stackPanel>

        <stackPanel orientation="vertical" spanColls="4" spanRows="2">
          <stackPanel orientation="horizontal" spanColls="4" spanRows="1">
            <control
              type="Label"
              name="DateFromHeader"
              text="dateFrom"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateFromDayInput"
              value="{Binding Path=DateFromDay}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateFromDayChanged}"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateFromMonthInput"
              value="{Binding Path=DateFromMonth}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateFromMonthChanged}"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateFromYearInput"
              value="{Binding Path=DateFromYear}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateFromYearChanged}"
              spanColls="1"
              spanRows="1"/>
          </stackPanel>

          <stackPanel orientation="horizontal" spanColls="4" spanRows="1">
            <control
              type="Label"
              name="DateToHeader"
              text="dateTo"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateToDayInput"
              value="{Binding Path=DateToDay}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateToDayChanged}"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateToMonthInput"
              value="{Binding Path=DateToMonth}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateToMonthChanged}"
              spanColls="1"
              spanRows="1"/>
            <control
              type="Input"
              name="DateToYearInput"
              value="{Binding Path=DateToYear}"
              dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
              onChange="{Binding Method=OnDateToYearChanged}"
              spanColls="1"
              spanRows="1"/>
          </stackPanel>
        </stackPanel>

        <control
          type="Button"
          name="UpdateSearchSheet"
          caption="Update Sheet"
          dataContext="{PageRuntimeSource='RuntimeObjects.WordDataExtractor.Controller'}"
          onClick="{Binding Method=Rerender}"
          spanColls="1"
          spanRows="1"/>

        <control
          type="Label"
          name="ToolbarHeightAnchor"
          text=""
          spanColls="1"
          spanRows="1"/>
      </stackPanel>

      <stackPanel spanColls="40" spanRows="1"/>

      <control
        type="TableList"
        name="SearchResultTables"
        itemsSource="{PageRuntimeSource='RuntimeItems.WordDataExtractor.Tables'}"/>
    </stackPanel>
  </grid>

  <styles>
    <controlStyle
      name="modeAccent"
      backColor="#2563EB"
      textColor="#FFFFFF"
      borderColor="#1D4ED8"
      fontBold="true"/>

    <stylePipelineStage name="default">
      <layer name="base">
        <rule
          target="sheet"
          styles="{
            backColor:#20242A;
            fontColor:#E5E7EB;
            borderColor:#111318;
            borderWeight:thin;
            width:18;
            rowHeight:20;
            cellType:text;
          }"/>
      </layer>

      <layer name="search-input">
        <rule
          target="controlPart"
          selector="type=label;name=ToolbarHeightAnchor;part=cell"
          styles="{
            rowHeight:40;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=SearchText;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            fontBold:true;
            horizontal:left;
            vertical:center;
            overflow:wrap;
            width:28;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=label;name=DateFromHeader;part=cell"
          styles="{
            backColor:#263445;
            fontColor:#CBD5E1;
            fontBold:true;
            horizontal:center;
            vertical:center;
            width:12;
            rowHeight:40;
          }"/>

        <rule
          target="controlPart"
          selector="type=label;name=DateToHeader;part=cell"
          styles="{
            backColor:#263445;
            fontColor:#CBD5E1;
            fontBold:true;
            horizontal:center;
            vertical:center;
            width:12;
            rowHeight:40;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateFromDayInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:7;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateFromMonthInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:7;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateFromYearInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:12;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateToDayInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:7;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateToMonthInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:7;
            rowHeight:40;
            cellType:text;
          }"/>

        <rule
          target="controlPart"
          selector="type=input;name=DateToYearInput;part=cell"
          styles="{
            backColor:#3A3F46;
            fontColor:#F8FAFC;
            horizontal:center;
            vertical:center;
            width:12;
            rowHeight:40;
            cellType:text;
          }"/>
      </layer>

      <layer name="tables">
        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=section"
          styles="{
            backColor:#173A5E;
            fontColor:#EAF6FF;
            fontBold:true;
            rowHeight:25;
          }"/>

        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=header"
          styles="{
            backColor:#2B4A6B;
            fontColor:#DDEEFF;
            fontBold:true;
            overflow:wrap;
            rowHeight:25;
          }"/>

        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=rows"
          styles="{
            backColor:#3A3A3A;
            fontColor:#F0F0F0;
            fontSize:8;
            overflow:wrap;
            rowHeight:auto;
          }"/>

        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=rows;columnAlias=context"
          styles="{
            width:100;
          }"/>

        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=header;columnAlias=context"
          styles="{
            width:100;
          }"/>

        <rule
          target="controlPart"
          selector="type=tablelist;name=SearchResultTables;part=rows;columnAlias=matchIndex"
          styles="{
            horizontal:center;
            vertical:center;
          }"/>
      </layer>
    </stylePipelineStage>
  </styles>
</page>
