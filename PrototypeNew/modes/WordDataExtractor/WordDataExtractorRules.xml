          <field id="eventDate" from="$match" regex="як(?:ий|а|і)\s+з\s+(\d{1,2}\s+[а-яіїєґ]+\s+\d{4}\s+року)\s+самовільно" group="1" default=""><transform type="dateFormat" format="dd.mm.yyyy"/></field><field id="basis" from="$match" regex="Підстава:\s*([^\r]+)" group="1" default=""><transform type="trim"/></field>
        </fields>
        <table><column id="fio" caption="ПІБ" value="$fio"/><column id="ipn" caption="ІПН" value="$ipn"/><column id="eventDate" caption="Вибуття" value="$eventDate"/><column id="basis" caption="Підстава" value="$basis"/></table>
      </dataset>

      <!-- Пункты, в которых человек переводится из одного состояния
           отсутствия в другое: лечение -> отпуск, лечение -> лечение и т. п. -->
      <dataset id="status-changes" caption="Зміна статусів">
        <match ignoreCase="false" multiline="false"><![CDATA[(?:^|\r)\s*[^\r]*[А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]{2,}\s+[^\r,]+,(?:(?!Підстава:)[\s\S])*?як(?:ий|а)\s+перебува(?:в|ла)(?:(?!Підстава:)[\s\S])*?вважати\s+та(?:ким|кою),\s*що\s+вибу(?:в|ла)(?:(?!Підстава:)[\s\S])*?Підстава:\s*[^\r]*(?=\r|$)]]></match>
        <fields>
          <field id="fio" from="$match" ignoreCase="false" regex="\s([А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]{2,}\s+[А-ЯІЇЄҐ][А-Яа-яІіЇїЄєҐґ'’\-]+\s+[А-ЯІЇЄҐ][А-Яа-яІіЇїЄєҐґ'’\-]+)\s*," group="1" default=""><transform type="trim"/></field>
          <field id="ipn" from="$match" regex=",\s*(\d{10})\s*," group="1" default=""><transform type="trim"/></field>
          <field id="previousStatus" from="$match" regex="як(?:ий|а)\s+перебува(?:в|ла)\s+([^,\r]+)" group="1" default=""><transform type="trim"/></field>
          <!-- Берём только тип нового отсутствия. Учреждение или место
               назначения после него не является частью статуса. -->
          <field id="newStatus" from="$match" regex="вважати\s+та(?:ким|кою),\s*що\s+вибу(?:в|ла)\s+((?:на|у)\s+(?:лікування|відпустку\s+для\s+лікування|відпустку|відрядження))" group="1" default=""><transform type="trim"/></field>
          <field id="eventDate" from="$match" regex="вважати\s+та(?:ким|кою),\s*що\s+вибу(?:в|ла)[\s\S]*?з\s+(\d{1,2}\s+[а-яіїєґ]+\s+\d{4}\s+року)" group="1" default=""><transform type="dateFormat" format="dd.mm.yyyy"/></field>
          <field id="durationDays" from="$match" regex="(?:терміном\s+)?на\s+(\d+)\s+календарн(?:их|і)\s+(?:діб|днів)" group="1" default=""><transform type="trim"/></field>
          <field id="eventTo" from="$match" regex="\sпо\s+(\d{1,2}\s+[а-яіїєґ]+\s+\d{4}\s+року)" group="1" default=""><transform type="dateFormat" format="dd.mm.yyyy"/></field>
          <field id="basis" from="$match" regex="Підстава:\s*([^\r]+)" group="1" default=""><transform type="trim"/></field>
        </fields>
        <table><column id="fio" caption="ПІБ" value="$fio"/><column id="ipn" caption="ІПН" value="$ipn"/><column id="previousStatus" caption="Попередній статус" value="$previousStatus"/><column id="newStatus" caption="Новий статус" value="$newStatus"/><column id="eventDate" caption="Вибуття" value="$eventDate"/><column id="durationDays" caption="На скільки" value="$durationDays"/><column id="eventTo" caption="По" value="$eventTo"/><column id="basis" caption="Підстава" value="$basis"/></table>
      </dataset>

      <!-- СЗЧ вследствие неприбытия из любого события: лечения, отпуска,
           командировки и т. п. Конкретный источник отсутствия не фиксируем. -->
      <dataset id="awol-non-return" caption="СЗЧ" includeCommonColumns="false">
        <match ignoreCase="false" multiline="false"><![CDATA[(?:^|\r)\s*[^\r]*[А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]{2,}\s+[^\r,]+,(?:(?!Підстава:)[\s\S])*?як(?:ий|а)\s+\d{1,2}\s+[а-яіїєґ]+\s+\d{4}\s+року\s+не\s+поверну(?:вся|лася)(?:(?!Підстава:)[\s\S])*?до\s+військової\s+частини(?:(?!Підстава:)[\s\S])*?Підстава:\s*[^\r]*(?=\r|$)]]></match>
        <fields>
          <field id="fio" from="$match" ignoreCase="false" regex="\s([А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]{2,}\s+[А-ЯІЇЄҐ][А-Яа-яІіЇїЄєҐґ'’\-]+\s+[А-ЯІЇЄҐ][А-Яа-яІіЇїЄєҐґ'’\-]+)\s*," group="1" default=""><transform type="trim"/></field>
          <field id="ipn" from="$match" regex=",\s*(\d{10})\s*," group="1" default=""><transform type="trim"/></field>
          <field id="eventDate" from="$match" regex="як(?:ий|а)\s+(\d{1,2}\s+[а-яіїєґ]+\s+\d{4}\s+року)\s+не\s+поверну" group="1" default=""><transform type="dateFormat" format="dd.mm.yyyy"/></field>
          <field id="basis" from="$match" regex="Підстава:\s*([^\r]+)" group="1" default=""><transform type="trim"/></field>
        </fields>
        <table><column id="fio" caption="ПІБ" value="$fio"/><column id="ipn" caption="ІПН" value="$ipn"/><column id="eventDate" caption="Вибуття" value="$eventDate"/><column id="basis" caption="Підстава" value="$basis"/></table>
      </dataset>

      <!-- Возвращение из СЗЧ с последующим направлением по алгоритму. -->
      <dataset id="algorithm-assignment" caption="Командирування за алгоритмом" includeCommonColumns="false">
        <match ignoreCase="false" multiline="false"><![CDATA[(?:^|\r)\s*[^\r]*[А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]{2,}\s+[^\r,]+,(?:(?!Підстава:)[\s\S])*?самовільно\s+залиш(?:ив|ила)(?:(?!Підстава:)[\s\S])*?поверну(?:вся|лася)\s+до\s+військової\s+частини(?:(?!Підстава:)[\s\S])*?Направити\s+у\s+відрядження(?:(?!Підстава:)[\s\S])*?алгоритм(?:у|ом)(?:(?!Підстава:)[\s\S])*?Підстава:\s*[^\r]*(?=\r|$)]]></match>
        <fields>
          <field id="fio" from="$match" ignoreCase="false" regex="\s([А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]{2,}\s+[А-ЯІЇЄҐ][А-Яа-яІіЇїЄєҐґ'’\-]+\s+[А-ЯІЇЄҐ][А-Яа-яІіЇїЄєҐґ'’\-]+)\s*," group="1" default=""><transform type="trim"/></field>
          <field id="ipn" from="$match" regex=",\s*(\d{10})\s*," group="1" default=""><transform type="trim"/></field>
          <field id="returnFrom" from="$match" regex="що\s+з\s+(\d{1,2}\s+[а-яіїєґ]+\s+\d{4}\s+року)\s+поверну" group="1" default=""><transform type="dateFormat" format="dd.mm.yyyy"/></field>
          <field id="returnTo" from="$match" regex="поверну(?:вся|лася)\s+до\s+військової\s+частини\s+([А-ЯA-Z]\d+)" group="1" default=""><transform type="upper"/></field>
          <field id="assignmentFrom" from="$match" regex="Направити\s+у\s+відрядження[\s\S]*?з\s+(\d{1,2}\s+[а-яіїєґ]+\s+\d{4}\s+року)" group="1" default=""><transform type="dateFormat" format="dd.mm.yyyy"/></field>
          <field id="assignmentTo" from="$match" regex="Направити\s+у\s+відрядження\s+у\s+військову\s+частину\s+([А-ЯA-Z]\d+)" group="1" default=""><transform type="upper"/></field>
        </fields>
        <table><column id="fio" caption="ПІБ" value="$fio"/><column id="ipn" caption="ІПН" value="$ipn"/><column id="returnFrom" caption="Повернення з" value="$returnFrom"/><column id="returnTo" caption="Повернення до" value="$returnTo"/><column id="assignmentFrom" caption="Відрядження з" value="$assignmentFrom"/><column id="assignmentTo" caption="Відрядження до" value="$assignmentTo"/></table>
      </dataset>

    </pipeline>
  </pipelines>
</wordDataExtractor>
