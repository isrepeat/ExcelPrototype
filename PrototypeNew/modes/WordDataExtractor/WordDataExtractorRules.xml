<?xml version="1.0" encoding="UTF-8"?>
<wordDataExtractor xmlns="urn:excelprototype:word-data-extractor:v1" version="1">
  <!--
    Иерархия обработки:
      pipeline -> dataset -> scope (область секции) -> match (пункт человека)
               -> fields -> колонки результирующей таблицы.

    scope не привязан к нумерации: это произвольный regex, который вырезает
    логическую область документа по устойчивым начальным словам заголовка.
    Номера секций намеренно не участвуют в правилах.

    Word разделяет абзацы символом CR (\r). Конструкция [\s\S] используется,
    когда выражение должно проходить через несколько абзацев.
  -->
  <pipelines>
    <pipeline id="personnel-order">

      <!-- Поля, одинаковые для всех кадровых событий. Они извлекаются из
           полного текста пункта и автоматически добавляются в каждую таблицу. -->
      <commonFields>
        <field id="foodEnrollmentDate" from="$match" ignoreCase="true"
          regex="на\s+продовольче\s+забезпечення\s+з\s+(\d{1,2}(?:[.\-/]\d{1,2}[.\-/]\d{2,4}|\s+[а-яіїєґ]+\s+\d{4}\s+року))"
          group="1" default=""><transform type="dateFormat" format="dd.mm.yyyy"/></field>
        <field id="foodRemovalDate" from="$match" ignoreCase="true"
          regex="Зняти[^\r]*?з\s+(\d{1,2}(?:[.\-/]\d{1,2}[.\-/]\d{2,4}|\s+[а-яіїєґ]+\s+\d{4}\s+року))"
          group="1" default=""><transform type="dateFormat" format="dd.mm.yyyy"/></field>
        <field id="tvoAssignments" from="$match" ignoreCase="true"
          regex="((?:Тимчасове\s+виконання\s+обов['’]язків[^\r]*(?:\r|$)\s*)+)"
          group="1" default=""><transform type="trim"/></field>
        <field id="tvoReturns" from="$match" ignoreCase="true"
          regex="((?:[^\r]*повернутись\s+до\s+виконання\s+обов['’]язків[^\r]*(?:\r|$)\s*)+)"
          group="1" default=""><transform type="trim"/></field>
      </commonFields>
      <commonColumns>
        <column id="foodEnrollmentDate" caption="На продовольче" value="$foodEnrollmentDate" flows="arrival;other"/>
        <column id="foodRemovalDate" caption="З продовольчого" value="$foodRemovalDate" flows="departure;other"/>
        <column id="tvoAssignments" caption="ТВО покласти на" value="$tvoAssignments" flows="departure"/>
        <column id="tvoReturns" caption="Повернутись до виконання обов'язків" value="$tvoReturns" flows="arrival"/>
      </commonColumns>

      <!-- Секция 1: военнослужащие, прибывшие в воинскую часть А7383. -->
      <dataset id="arrived-to-unit" caption="Прибули до військової частини А7383" flow="arrival" commonColumnIds="foodEnrollmentDate">
        <scope>
          <match ignoreCase="true" multiline="false" group="0"><![CDATA[Вважати\s+такими,\s*що\s+прибули\s+до\s+військової\s+частини\s+А7383[\s\S]*?(?=\r[^\r]{0,80}Вважати\s+такими,\s*що\s+прибули\s+до\s+складу\s+сил\s+і\s+засобів\s+2\s+корпусу|\s*$)]]></match>
        </scope>

        <!-- Один match становится одной строкой: от звания до абзаца «Підстава:». -->
        <match ignoreCase="true" multiline="false"><![CDATA[(?:^|\r)\s*(?:\d+(?:\.\d+)*\.?\s*)?(?:рядовий|рядового|солдат|солдата|старший\s+солдат|старшого\s+солдата|молодший\s+сержант|молодшого\s+сержанта|сержант|сержанта|старший\s+сержант|старшого\s+сержанта|штаб-сержант|штаб-сержанта|майстер-сержант|майстер-сержанта|лейтенант|лейтенанта|старший\s+лейтенант|старшого\s+лейтенанта|капітан|капітана|майор|майора|підполковник|підполковника|полковник|полковника)\s+[\s\S]*?колишнього\s+військовослужбовця(?:\s+військової\s+служби\s+за\s+контрактом)?\s+військової\s+частини\s+[А-ЯA-Z]\d+[\s\S]*?Підстава:\s*[^\r]*(?=\r|$)]]></match>

        <fields>
          <field id="fio" from="$match" ignoreCase="true"
            regex="(?:рядовий|рядового|солдат|солдата|старший\s+солдат|старшого\s+солдата|молодший\s+сержант|молодшого\s+сержанта|сержант|сержанта|старший\s+сержант|старшого\s+сержанта|штаб-сержант|штаб-сержанта|майстер-сержант|майстер-сержанта|лейтенант|лейтенанта|старший\s+лейтенант|старшого\s+лейтенанта|капітан|капітана|майор|майора|підполковник|підполковника|полковник|полковника)\s+([А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]+\s+[^,\r]+)\s*,"
            group="1" default="">
            <transform type="trim"/>
          </field>

          <field id="ipn" from="$match" ignoreCase="true"
            regex=",\s*(\d{10})\s*," group="1" default="">
            <transform type="trim"/>
          </field>

          <field id="formerUnit" from="$match" ignoreCase="true"
            regex="колишнього\s+військовослужбовця(?:\s+військової\s+служби\s+за\s+контрактом)?\s+військової\s+частини\s+([А-ЯA-Z]\d+)"
            group="1" default="">
            <transform type="upper"/>
          </field>

          <field id="basis" from="$match" ignoreCase="true"
            regex="Підстава:\s*([^\r]+)" group="1" default="">
            <transform type="trim"/>
          </field>
        </fields>

        <table>
          <column id="fio" caption="ПІБ" value="$fio"/>
          <column id="ipn" caption="ІПН" value="$ipn"/>
          <column id="formerUnit" caption="Колишня військова частина" value="$formerUnit"/>
          <column id="basis" caption="Підстава" value="$basis"/>
        </table>

      </dataset>

      <!-- Секция 2: военнослужащие, прибывшие в состав сил и средств корпуса. -->
      <dataset id="arrived-to-corps" caption="Прибули до складу сил і засобів 2 корпусу" flow="arrival" commonColumnIds="foodEnrollmentDate">
        <scope>
          <match ignoreCase="true" multiline="false" group="0"><![CDATA[Вважати\s+такими,\s*що\s+прибули\s+до\s+складу\s+сил\s+і\s+засобів\s+2\s+корпусу[\s\S]*$]]></match>
        </scope>

        <match ignoreCase="true" multiline="false"><![CDATA[(?:^|\r)\s*(?:\d+(?:\.\d+)*\.?\s*)?(?:рядовий|рядового|солдат|солдата|старший\s+солдат|старшого\s+солдата|молодший\s+сержант|молодшого\s+сержанта|сержант|сержанта|старший\s+сержант|старшого\s+сержанта|штаб-сержант|штаб-сержанта|майстер-сержант|майстер-сержанта|лейтенант|лейтенанта|старший\s+лейтенант|старшого\s+лейтенанта|капітан|капітана|майор|майора|підполковник|підполковника|полковник|полковника)\s+[\s\S]*?з\s+\d{1,2}\s+[а-яіїєґ]+\s+\d{4}\s+року\s+зарахувати\s+до\s+списк(?:ів|у)\s+особового\s+складу[\s\S]*?Підстава:\s*[^\r]*(?=\r|$)]]></match>

        <fields>
          <field id="fio" from="$match" ignoreCase="true"
            regex="(?:рядовий|рядового|солдат|солдата|старший\s+солдат|старшого\s+солдата|молодший\s+сержант|молодшого\s+сержанта|сержант|сержанта|старший\s+сержант|старшого\s+сержанта|штаб-сержант|штаб-сержанта|майстер-сержант|майстер-сержанта|лейтенант|лейтенанта|старший\s+лейтенант|старшого\s+лейтенанта|капітан|капітана|майор|майора|підполковник|підполковника|полковник|полковника)\s+([А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]+\s+[^,\r]+)\s*,"
            group="1" default="">
            <transform type="trim"/>
          </field>

          <field id="ipn" from="$match" ignoreCase="true"
            regex=",\s*(\d{10})\s*," group="1" default="">
            <transform type="trim"/>
          </field>

          <!-- Опциональная формулировка преобразуется в строковый boolean. -->
          <field id="temporaryPersonnel" from="$match" ignoreCase="true"
            regex="((?:який|яка)\s+(?:зарахований|зарахована|перебуває)[\s\S]{0,120}?тимчасово\s+прибулого\s+особового\s+складу)"
            group="1" default="">
            <transform type="boolean" trueValue="true" falseValue="false"/>
          </field>

          <field id="enrollmentDate" from="$match" ignoreCase="true"
            regex="з\s+(\d{1,2}\s+[а-яіїєґ]+\s+\d{4}\s+року)\s+зарахувати\s+до\s+списк(?:ів|у)\s+особового\s+складу"
            group="1" default="">
            <transform type="dateFormat" format="dd.mm.yyyy"/>
          </field>
        </fields>

        <table>
          <column id="fio" caption="ПІБ" value="$fio"/>
          <column id="ipn" caption="ІПН" value="$ipn"/>
          <column id="temporaryPersonnel" caption="Тимчасово прибулий склад" value="$temporaryPersonnel"/>
          <column id="enrollmentDate" caption="Прибуття" value="$enrollmentDate"/>
        </table>
      </dataset>

      <!-- Возвращение из лечебного учреждения. Дата может находиться в
           отдельном абзаце перед пунктом, поэтому наследуется из context. -->
      <dataset id="returned-from-hospital" caption="З лікувального закладу" flow="arrival">
        <scope>
          <match ignoreCase="true" multiline="false" group="0"><![CDATA[(?:^|\r)\s*(?:\d+(?:\.\d+)*\.?\s*)?З\s+лікувального\s+закладу\s*[:.]?\s*[\s\S]*?(?=\r\s*\d+(?:\.\d+)+\.?\s*З\s+|\s*$)]]></match>
          <context id="returnDate">
            <match ignoreCase="true" multiline="false"><![CDATA[(?:^|\r)\s*з\s+(?:[^\r]*?\s+з\s+)?(\d{1,2}(?:[.\-/]\d{1,2}[.\-/]\d{2,4}|\s+[а-яіїєґ]+\s+\d{4}\s+року))[^\r]*(?:\r[\s\S]*?)(?=\r\s*з\s+(?:[^\r]*?\s+з\s+)?\d{1,2}(?:[.\-/]\d{1,2}[.\-/]\d{2,4}|\s+[а-яіїєґ]+\s+\d{4}\s+року)|\s*$)]]></match>
          </context>
        </scope>

        <match ignoreCase="true" multiline="false"><![CDATA[(?:^|\r)\s*(?:рядовий|рядового|солдат|солдата|старший\s+солдат|старшого\s+солдата|молодший\s+сержант|молодшого\s+сержанта|сержант|сержанта|старший\s+сержант|старшого\s+сержанта|штаб-сержант|штаб-сержанта|майстер-сержант|майстер-сержанта|лейтенант|лейтенанта|старший\s+лейтенант|старшого\s+лейтенанта|капітан|капітана|майор|майора|підполковник|підполковника|полковник|полковника)\s+[\s\S]*?Підстава:\s*[^\r]*(?=\r|$)]]></match>

        <fields>
          <field id="fio" from="$match" ignoreCase="true"
            regex="(?:рядовий|рядового|солдат|солдата|старший\s+солдат|старшого\s+солдата|молодший\s+сержант|молодшого\s+сержанта|сержант|сержанта|старший\s+сержант|старшого\s+сержанта|штаб-сержант|штаб-сержанта|майстер-сержант|майстер-сержанта|лейтенант|лейтенанта|старший\s+лейтенант|старшого\s+лейтенанта|капітан|капітана|майор|майора|підполковник|підполковника|полковник|полковника)\s+([А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]+\s+[^,\r]+)\s*,"
            group="1" default=""><transform type="trim"/></field>
          <field id="ipn" from="$match" ignoreCase="true"
            regex=",\s*(\d{10})\s*," group="1" default=""><transform type="trim"/></field>
          <field id="returnDate" from="$returnDate.1"><transform type="dateFormat" format="dd.mm.yyyy"/></field>
          <field id="basis" from="$match" ignoreCase="true"
            regex="Підстава:\s*([^\r]+)" group="1" default=""><transform type="trim"/></field>
        </fields>

        <table>
          <column id="fio" caption="ПІБ" value="$fio"/>
          <column id="ipn" caption="ІПН" value="$ipn"/>
          <column id="returnDate" caption="Прибуття" value="$returnDate"/>
          <column id="basis" caption="Підстава" value="$basis"/>
        </table>
      </dataset>

      <!-- Одна датированная подсекция отпуска может содержать несколько
           пунктов; каждый из них получает одну и ту же дату context-блока. -->
      <dataset id="returned-from-annual-leave" caption="З щорічної основної відпустки" flow="arrival">
        <scope>
          <match ignoreCase="true" multiline="false" group="0"><![CDATA[(?:^|\r)\s*(?:\d+(?:\.\d+)*\.?\s*)?З\s+щорічної\s+основної\s+відпустки\s*[:.]?\s*[\s\S]*?(?=\r\s*\d+(?:\.\d+)+\.?\s*З\s+|\s*$)]]></match>
          <context id="returnDate">
            <match ignoreCase="true" multiline="false"><![CDATA[(?:^|\r)\s*з\s+(?:[^\r]*?\s+з\s+)?(\d{1,2}(?:[.\-/]\d{1,2}[.\-/]\d{2,4}|\s+[а-яіїєґ]+\s+\d{4}\s+року))[^\r]*(?:\r[\s\S]*?)(?=\r\s*з\s+(?:[^\r]*?\s+з\s+)?\d{1,2}(?:[.\-/]\d{1,2}[.\-/]\d{2,4}|\s+[а-яіїєґ]+\s+\d{4}\s+року)|\s*$)]]></match>
          </context>
        </scope>

        <match ignoreCase="true" multiline="false"><![CDATA[(?:^|\r)\s*(?:рядовий|рядового|солдат|солдата|старший\s+солдат|старшого\s+солдата|молодший\s+сержант|молодшого\s+сержанта|сержант|сержанта|старший\s+сержант|старшого\s+сержанта|штаб-сержант|штаб-сержанта|майстер-сержант|майстер-сержанта|лейтенант|лейтенанта|старший\s+лейтенант|старшого\s+лейтенанта|капітан|капітана|майор|майора|підполковник|підполковника|полковник|полковника)\s+[\s\S]*?Підстава:\s*[^\r]*(?=\r|$)]]></match>

        <fields>
          <field id="fio" from="$match" ignoreCase="true"
            regex="(?:рядовий|рядового|солдат|солдата|старший\s+солдат|старшого\s+солдата|молодший\s+сержант|молодшого\s+сержанта|сержант|сержанта|старший\s+сержант|старшого\s+сержанта|штаб-сержант|штаб-сержанта|майстер-сержант|майстер-сержанта|лейтенант|лейтенанта|старший\s+лейтенант|старшого\s+лейтенанта|капітан|капітана|майор|майора|підполковник|підполковника|полковник|полковника)\s+([А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]+\s+[^,\r]+)\s*,"
            group="1" default=""><transform type="trim"/></field>
          <field id="ipn" from="$match" ignoreCase="true"
            regex=",\s*(\d{10})\s*," group="1" default=""><transform type="trim"/></field>
          <field id="returnDate" from="$returnDate.1"><transform type="dateFormat" format="dd.mm.yyyy"/></field>
          <field id="basis" from="$match" ignoreCase="true"
            regex="Підстава:\s*([^\r]+)" group="1" default=""><transform type="trim"/></field>
        </fields>

        <table>
          <column id="fio" caption="ПІБ" value="$fio"/>
          <column id="ipn" caption="ІПН" value="$ipn"/>
          <column id="returnDate" caption="Прибуття" value="$returnDate"/>
          <column id="basis" caption="Підстава" value="$basis"/>
        </table>
      </dataset>

      <dataset id="returned-from-treatment-leave" caption="З відпустки для лікування" flow="arrival">
        <scope>
          <match ignoreCase="true" multiline="false"><![CDATA[(?:^|\r)\s*(?:\d+(?:\.\d+)*\.?\s*)?З\s+відпустки\s+для\s+лікування[\s\S]*?(?=\r\s*\d+(?:\.\d+)+\.?\s*Із\s+самовільного|\s*$)]]></match>
          <context id="eventDate"><match ignoreCase="true" multiline="false"><![CDATA[(?:^|\r)\s*з\s+(\d{1,2}(?:[.\-/]\d{1,2}[.\-/]\d{2,4}|\s+[а-яіїєґ]+\s+\d{4}\s+року))[^\r]*(?:\r[\s\S]*?)(?=\r\s*з\s+\d{1,2}(?:[.\-/]\d{1,2}[.\-/]\d{2,4}|\s+[а-яіїєґ]+\s+\d{4}\s+року)|\s*$)]]></match></context>
        </scope>
        <match ignoreCase="false" multiline="false"><![CDATA[(?:^|\r)\s*[^\r]*[А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]{2,}\s+[^\r,]+,[\s\S]*?Підстава:\s*[^\r]*(?=\r|$)]]></match>
        <fields>
          <field id="fio" from="$match" ignoreCase="false" regex="\s([А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]{2,}\s+[А-ЯІЇЄҐ][А-Яа-яІіЇїЄєҐґ'’\-]+\s+[А-ЯІЇЄҐ][А-Яа-яІіЇїЄєҐґ'’\-]+)\s*," group="1" default=""><transform type="trim"/></field>
          <field id="ipn" from="$match" regex=",\s*(\d{10})\s*," group="1" default=""><transform type="trim"/></field>
          <field id="eventDate" from="$eventDate.1"><transform type="dateFormat" format="dd.mm.yyyy"/></field>
          <field id="basis" from="$match" regex="Підстава:\s*([^\r]+)" group="1" default=""><transform type="trim"/></field>
        </fields>
        <table><column id="fio" caption="ПІБ" value="$fio"/><column id="ipn" caption="ІПН" value="$ipn"/><column id="eventDate" caption="Прибуття" value="$eventDate"/><column id="basis" caption="Підстава" value="$basis"/></table>
      </dataset>

      <dataset id="returned-from-awol" caption="Із самовільного залишення військової частини" flow="arrival">
        <scope>
          <match ignoreCase="true" multiline="false"><![CDATA[(?:^|\r)\s*(?:\d+(?:\.\d+)*\.?\s*)?Із\s+самовільного\s+залишення\s+військової\s+частини[\s\S]*?(?=\r\s*\d+(?:\.\d+)+\.?\s*З\s+проходження|\s*$)]]></match>
          <context id="eventDate"><match ignoreCase="true" multiline="false"><![CDATA[(?:^|\r)\s*з\s+(\d{1,2}(?:[.\-/]\d{1,2}[.\-/]\d{2,4}|\s+[а-яіїєґ]+\s+\d{4}\s+року))[^\r]*(?:\r[\s\S]*?)(?=\r\s*з\s+\d{1,2}(?:[.\-/]\d{1,2}[.\-/]\d{2,4}|\s+[а-яіїєґ]+\s+\d{4}\s+року)|\s*$)]]></match></context>
        </scope>
        <match ignoreCase="false" multiline="false"><![CDATA[(?:^|\r)\s*[^\r]*[А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]{2,}\s+[^\r,]+,[\s\S]*?Підстава:\s*[^\r]*(?=\r|$)]]></match>
        <fields>
          <field id="fio" from="$match" ignoreCase="false" regex="\s([А-ЯІЇЄҐ][А-ЯІЇЄҐ'’\-]{2,}\s+[А-ЯІЇЄҐ][А-Яа-яІіЇїЄєҐґ'’\-]+\s+[А-ЯІЇЄҐ][А-Яа-яІіЇїЄєҐґ'’\-]+)\s*," group="1" default=""><transform type="trim"/></field>
          <field id="ipn" from="$match" regex=",\s*(\d{10})\s*," group="1" default=""><transform type="trim"/></field>
          <field id="eventDate" from="$eventDate.1"><transform type="dateFormat" format="dd.mm.yyyy"/></field>
          <field id="basis" from="$match" regex="Підстава:\s*([^\r]+)" group="1" default=""><transform type="trim"/></field>
        </fields>
        <table><column id="fio" caption="ПІБ" value="$fio"/><column id="ipn" caption="ІПН" value="$ipn"/><column id="eventDate" caption="Прибуття" value="$eventDate"/><column id="basis" caption="Підстава" value="$basis"/></table>
      </dataset>

