(async () => {
  const FIND_TIMEOUT = 15000;
  const FIND_INTERVAL = 750;
  const MAX_DEPTH = 12;
  const MAX_NODES = 60000;

  const sleep = ms => new Promise(r => setTimeout(r, ms));

  const isObject = value =>
    value !== null &&
    (typeof value === "object" || typeof value === "function");


  // ============================================================
  //  1. CLEANUP ПРЕДЫДУЩЕГО ЗАПУСКА
  // ============================================================

  if (window.__vagonCtrlCFix?.stop) {
    window.__vagonCtrlCFix.stop(true);
  }

  if (window.__vagonClipboardToastObserver) {
    try {
      window.__vagonClipboardToastObserver.disconnect();
    } catch {}

    delete window.__vagonClipboardToastObserver;
  }


  // ============================================================
  //  2. СКРЫТИЕ "Clipboard synced"
  // ============================================================

  const CLIPBOARD_TEXT = /^Clipboard synced[.!]?$/i;

  function hideClipboardToast(el) {
    if (!(el instanceof HTMLElement)) return;

    const text = el.innerText?.trim();

    if (!text || !CLIPBOARD_TEXT.test(text)) {
      return;
    }

    let toast = el.closest(
      '[role="alert"], ' +
      '[role="status"], ' +
      '[aria-live], ' +
      '[class*="toast" i], ' +
      '[class*="snackbar" i], ' +
      '[class*="notification" i], ' +
      '[class*="message" i]'
    );

    if (!toast) {
      let p = el;

      for (
        let i = 0;
        i < 5 && p;
        i++, p = p.parentElement
      ) {
        const style = getComputedStyle(p);
        const rect = p.getBoundingClientRect();

        if (
          (
            style.position === "fixed" ||
            style.position === "absolute"
          ) &&
          rect.width < 700 &&
          rect.height < 250
        ) {
          toast = p;
          break;
        }
      }
    }

    (toast || el).style.setProperty(
      "display",
      "none",
      "important"
    );
  }

  function scanForClipboardToast(root) {
    if (!(root instanceof Element)) return;

    hideClipboardToast(root);

    root.querySelectorAll("*").forEach(
      hideClipboardToast
    );
  }

  scanForClipboardToast(document.body);

  const toastObserver = new MutationObserver(
    mutations => {
      for (const mutation of mutations) {
        for (const node of mutation.addedNodes) {
          if (node instanceof Element) {
            scanForClipboardToast(node);
          }
        }
      }
    }
  );

  toastObserver.observe(document.documentElement, {
    childList: true,
    subtree: true
  });

  window.__vagonClipboardToastObserver =
    toastObserver;

  console.log(
    '🙈 "Clipboard synced" notifications hidden'
  );


  // ============================================================
  //  3. ПОИСК VAGON PERIPHERALS
  // ============================================================

  function isPeripheral(obj) {
    try {
      return (
        isObject(obj) &&
        typeof obj.processKeyDown === "function" &&
        typeof obj.startPendingCtrl === "function" &&
        typeof obj.sendPayload === "function" &&
        isObject(obj.trackedModifiers) &&
        "Control" in obj.trackedModifiers
      );
    } catch {
      return false;
    }
  }

  function collectRoots() {
    const roots = [];

    const add = value => {
      if (isObject(value)) {
        roots.push(value);
      }
    };

    // Ищем React/framework объекты на DOM-элементах.
    for (const el of document.querySelectorAll("*")) {
      let names;

      try {
        names = Object.getOwnPropertyNames(el);
      } catch {
        continue;
      }

      for (const name of names) {
        if (
          name.startsWith("__reactFiber$") ||
          name.startsWith("__reactProps$") ||
          name.startsWith("__reactContainer$") ||
          name === "_reactRootContainer" ||
          name === "__vueParentComponent" ||
          name === "__vue_app__"
        ) {
          try {
            const descriptor =
              Object.getOwnPropertyDescriptor(
                el,
                name
              );

            if (
              descriptor &&
              "value" in descriptor
            ) {
              add(descriptor.value);
            }
          } catch {}
        }
      }
    }

    // Плюс подозрительные глобальные объекты.
    let descriptors;

    try {
      descriptors =
        Object.getOwnPropertyDescriptors(window);
    } catch {
      descriptors = {};
    }

    for (
      const [name, descriptor]
      of Object.entries(descriptors)
    ) {
      if (
        /vagon|workstation|player|stream|peripheral|redux|store|react/i
          .test(name) &&
        "value" in descriptor
      ) {
        add(descriptor.value);
      }
    }

    return roots;
  }

  function searchGraph(roots) {
    const queue = roots.map(value => ({
      value,
      depth: 0
    }));

    const seen = new WeakSet();

    let checked = 0;

    while (
      queue.length &&
      checked < MAX_NODES
    ) {
      const { value, depth } = queue.shift();

      if (!isObject(value)) continue;

      try {
        if (seen.has(value)) continue;

        seen.add(value);
      } catch {
        continue;
      }

      checked++;

      if (isPeripheral(value)) {
        console.log(
          `✅ Vagon Peripherals найден автоматически ` +
          `(${checked} объектов проверено)`
        );

        return value;
      }

      if (depth >= MAX_DEPTH) continue;

      if (
        value instanceof Node ||
        value === window ||
        value === document
      ) {
        continue;
      }

      let descriptors;

      try {
        descriptors =
          Object.getOwnPropertyDescriptors(value);
      } catch {
        continue;
      }

      for (
        const descriptor
        of Object.values(descriptors)
      ) {
        // Не вызываем getter'ы.
        if (!("value" in descriptor)) {
          continue;
        }

        const child = descriptor.value;

        if (!isObject(child)) continue;

        queue.push({
          value: child,
          depth: depth + 1
        });
      }
    }

    return null;
  }

  async function findPeripheral() {
    const started = Date.now();

    while (
      Date.now() - started < FIND_TIMEOUT
    ) {
      const found = searchGraph(
        collectRoots()
      );

      if (found) {
        return found;
      }

      console.log(
        "🔎 Vagon Peripherals пока не найден..."
      );

      await sleep(FIND_INTERVAL);
    }

    return null;
  }


  // ============================================================
  //  4. НАХОДИМ ЖИВОЙ PERIPHERALS
  // ============================================================

  console.log("🔎 Ищу Vagon Peripherals...");

  let p = null;

  // Если ссылка уже существует, можно использовать её.
  if (isPeripheral(window.__vagonPeripheral)) {
    p = window.__vagonPeripheral;

    console.log(
      "✅ Используется существующий __vagonPeripheral"
    );
  } else {
    p = await findPeripheral();

    if (p) {
      console.log("✅ AUTO-FIND SUCCESS");
    }
  }

  if (!p) {
    console.error(
      "❌ Vagon Peripherals не найден.\n" +
      "Скрытие Clipboard synced продолжает работать,\n" +
      "но Ctrl+C fix не был запущен."
    );

    return;
  }

  window.__vagonPeripheral = p;


  // ============================================================
  //  5. CTRL+C FIX
  // ============================================================

  let ctrlHeld = false;
  let ctrlEvent = null;
  let generation = 0;

  function restoreCtrl(gen, delay) {
    if (
      !ctrlHeld ||
      !ctrlEvent ||
      gen !== generation
    ) {
      return;
    }

    // Vagon уже считает Ctrl нажатым.
    if (
      p.trackedModifiers?.Control === true
    ) {
      console.log(
        `ℹ️ ${delay}ms: Ctrl уже активен`
      );

      return;
    }

    try {
      /*
       * Передаём настоящее ранее полученное
       * KeyboardEvent напрямую внутреннему
       * обработчику Vagon.
       */
      p.processKeyDown(ctrlEvent);

      console.log(
        `✅ ${delay}ms: Ctrl restored`,
        {
          tracked:
            p.trackedModifiers?.Control,

          pressedKeys:
            p.pressedKeys
        }
      );
    } catch (error) {
      console.error(
        "❌ Ошибка восстановления Ctrl:",
        error
      );
    }
  }

  function onKeyDown(e) {
    if (!e.isTrusted) return;

    if (
      e.code === "ControlLeft" ||
      e.code === "ControlRight"
    ) {
      ctrlHeld = true;
      ctrlEvent = e;

      return;
    }

    // Исправляем только Ctrl+C.
    if (
      e.code === "KeyC" &&
      e.ctrlKey &&
      ctrlHeld
    ) {
      const gen = ++generation;

      /*
       * Clipboard Vagon может сбросить Ctrl
       * с небольшой задержкой.
       */
      setTimeout(
        () => restoreCtrl(gen, 80),
        80
      );

      setTimeout(
        () => restoreCtrl(gen, 180),
        180
      );

      setTimeout(
        () => restoreCtrl(gen, 350),
        350
      );
    }
  }

  function onKeyUp(e) {
    if (
      e.code === "ControlLeft" ||
      e.code === "ControlRight"
    ) {
      ctrlHeld = false;
      ctrlEvent = null;

      generation++;
    }
  }

  window.addEventListener(
    "keydown",
    onKeyDown,
    true
  );

  window.addEventListener(
    "keyup",
    onKeyUp,
    true
  );


  // ============================================================
  //  6. УПРАВЛЕНИЕ / CLEANUP
  // ============================================================

  window.__vagonCtrlCFix = {
    peripheral: p,
    toastObserver,

    onKeyDown,
    onKeyUp,

    stop(silent = false) {
      window.removeEventListener(
        "keydown",
        onKeyDown,
        true
      );

      window.removeEventListener(
        "keyup",
        onKeyUp,
        true
      );

      ctrlHeld = false;
      ctrlEvent = null;

      generation++;

      try {
        toastObserver.disconnect();
      } catch {}

      if (
        window.__vagonClipboardToastObserver
        === toastObserver
      ) {
        delete window.__vagonClipboardToastObserver;
      }

      if (!silent) {
        console.log(
          "🛑 Vagon Ctrl+C + Clipboard fix stopped"
        );
      }
    },

    status() {
      console.log({
        active: true,

        ctrlHeld,

        trackedControl:
          p.trackedModifiers?.Control,

        pressedKeys:
          p.pressedKeys,

        clipboardToastHider: true,

        peripheral: p
      });
    }
  };


  // ============================================================
  //  READY
  // ============================================================

  console.log(
    "✅ Vagon Ctrl+C AUTO FIX ACTIVE"
  );

  console.log(
    "✅ Clipboard notification hider ACTIVE"
  );
})();