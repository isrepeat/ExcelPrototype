(async () => {
    const FIND_TIMEOUT = 15000;
    const FIND_INTERVAL = 500;
    const MAX_DEPTH = 12;
    const MAX_NODES = 60000;

    const sleep = ms =>
        new Promise(resolve => setTimeout(resolve, ms));

    // ============================================================
    //  1. CLEANUP ПРЕДЫДУЩЕГО ЗАПУСКА
    // ============================================================

    if (window.__vagonRawCtrlVFix?.stop) {
        window.__vagonRawCtrlVFix.stop(true);
    }

    // ============================================================
    //  2. ПОИСК PERIPHERALS
    // ============================================================

    const isObject = value =>
        value !== null &&
        (
            typeof value === "object" ||
            typeof value === "function"
        );

    function isPeripheral(obj) {
        try {
            return (
                isObject(obj) &&
                typeof obj.processKeyDown === "function" &&
                typeof obj.processKeyUp === "function" &&
                typeof obj.sendPayload === "function" &&
                typeof obj.flushAsRealCtrlNow === "function" &&
                isObject(obj.trackedModifiers) &&
                "Control" in obj.trackedModifiers
            );
        } catch {
            return false;
        }
    }

    function collectRoots() {
        const roots = [];

        const add = value => {
            if (isObject(value)) {
                roots.push(value);
            }
        };

        // React / Vue объекты на DOM.
        for (const el of document.querySelectorAll("*")) {
            let names;

            try {
                names = Object.getOwnPropertyNames(el);
            } catch {
                continue;
            }

            for (const name of names) {
                if (
                    name.startsWith("__reactFiber$") ||
                    name.startsWith("__reactProps$") ||
                    name.startsWith("__reactContainer$") ||
                    name === "_reactRootContainer" ||
                    name === "__vueParentComponent" ||
                    name === "__vue_app__"
                ) {
                    try {
                        const descriptor =
                            Object.getOwnPropertyDescriptor(
                                el,
                                name
                            );

                        if (
                            descriptor &&
                            "value" in descriptor
                        ) {
                            add(descriptor.value);
                        }
                    } catch {}
                }
            }
        }

        // Подозрительные глобальные объекты.
        try {
            const descriptors =
                Object.getOwnPropertyDescriptors(window);

            for (
                const [name, descriptor]
                of Object.entries(descriptors)
            ) {
                if (
                    /vagon|workstation|player|stream|peripheral|redux|store|react/i
                        .test(name) &&
                    "value" in descriptor
                ) {
                    add(descriptor.value);
                }
            }
        } catch {}

        return roots;
    }

    function searchGraph(roots) {
        const queue = roots.map(value => ({
            value,
            depth: 0
        }));

        const seen = new WeakSet();

        let checked = 0;

        while (
            queue.length &&
            checked < MAX_NODES
        ) {
            const {
                value,
                depth
            } = queue.shift();

            if (!isObject(value)) {
                continue;
            }

            try {
                if (seen.has(value)) {
                    continue;
                }

                seen.add(value);
            } catch {
                continue;
            }

            checked++;

            if (isPeripheral(value)) {
                console.log(
                    `✅ Vagon Peripherals найден ` +
                    `(${checked} объектов проверено)`
                );

                return value;
            }

            if (depth >= MAX_DEPTH) {
                continue;
            }

            if (
                value instanceof Node ||
                value === window ||
                value === document
            ) {
                continue;
            }

            let descriptors;

            try {
                descriptors =
                    Object.getOwnPropertyDescriptors(value);
            } catch {
                continue;
            }

            for (
                const descriptor
                of Object.values(descriptors)
            ) {
                if (!("value" in descriptor)) {
                    continue;
                }

                const child = descriptor.value;

                if (!isObject(child)) {
                    continue;
                }

                queue.push({
                    value: child,
                    depth: depth + 1
                });
            }
        }

        return null;
    }

    async function findPeripheral() {
        const started = Date.now();

        while (
            Date.now() - started < FIND_TIMEOUT
        ) {
            const found =
                searchGraph(collectRoots());

            if (found) {
                return found;
            }

            console.log(
                "🔎 Vagon Peripherals пока не найден..."
            );

            await sleep(FIND_INTERVAL);
        }

        return null;
    }

    console.log("🔎 Ищу Vagon Peripherals...");

    let p = null;

    if (isPeripheral(window.__vagonPeripheral)) {
        p = window.__vagonPeripheral;

        console.log(
            "✅ Используется существующий Peripherals"
        );
    } else {
        p = await findPeripheral();
    }

    if (!p) {
        console.error(
            "❌ Vagon Peripherals не найден"
        );

        return;
    }

    window.__vagonPeripheral = p;

    // ============================================================
    //  3. RAW CTRL+V
    // ============================================================

    function sendKey(
        key,
        keyCode,
        code,
        up
    ) {
        p.sendPayload(
            JSON.stringify({
                $type: "1",
                k: key,
                kc: keyCode,
                c: code,
                u: up
            })
        );
    }

    function rawPaste() {
        /*
         * Важно определить это ДО flushAsRealCtrlNow().
         *
         * Если Vagon уже отправил Ctrl down удалённой
         * Windows, второй Ctrl down не нужен.
         */
        const ctrlAlreadyDown =
            p.trackedModifiers?.Control === true;

        /*
         * Если Ctrl ещё ждёт 15 мс для определения AltGr,
         * отменяем это ожидание.
         */
        p.flushAsRealCtrlNow?.();

        if (!ctrlAlreadyDown) {
            sendKey(
                "Control",
                17,
                "ControlLeft",
                false
            );
        }

        sendKey(
            "v",
            86,
            "KeyV",
            false
        );

        sendKey(
            "v",
            86,
            "KeyV",
            true
        );

        /*
         * Если Ctrl уже был физически передан Vagon,
         * здесь его НЕ отпускаем.
         *
         * Реальный отпуск Ctrl пользовательской клавиши
         * потом обработает сам Vagon.
         */
        if (!ctrlAlreadyDown) {
            sendKey(
                "Control",
                17,
                "ControlLeft",
                true
            );
        }
    }

    // ============================================================
    //  4. ПЕРЕХВАТ ФИЗИЧЕСКОГО CTRL+V
    // ============================================================

    let suppressVKeyUp = false;

    function onKeyDown(e) {
        if (
            !e.isTrusted ||
            e.code !== "KeyV" ||
            !e.ctrlKey ||
            e.altKey ||
            e.metaKey
        ) {
            return;
        }

        /*
         * Критично:
         *
         * НЕ даём событию KeyV дойти до Peripherals.js.
         *
         * Иначе Vagon выполнит:
         *
         * navigator.clipboard.readText()
         *       ↓
         * generatePasteToRemoteEventPayload()
         *       ↓
         * $type:9
         *
         * и перезапишет clipboard удалённой Windows
         * испорченным текстом.
         */
        e.preventDefault();
        e.stopImmediatePropagation();

        if (e.repeat) {
            return;
        }

        suppressVKeyUp = true;

        rawPaste();
    }

    function onKeyUp(e) {
        if (
            e.code !== "KeyV" ||
            !suppressVKeyUp
        ) {
            return;
        }

        /*
         * KeyV up тоже не даём штатному Vagon,
         * потому что V down/up мы уже отправили сами.
         */
        e.preventDefault();
        e.stopImmediatePropagation();

        suppressVKeyUp = false;
    }

    /*
     * Vagon слушает keyboard на document capture=true.
     *
     * window capture=true находится раньше document,
     * поэтому можем остановить проблемный KeyV.
     */
    window.addEventListener(
        "keydown",
        onKeyDown,
        true
    );

    window.addEventListener(
        "keyup",
        onKeyUp,
        true
    );

    // ============================================================
    //  5. УПРАВЛЕНИЕ
    // ============================================================

    window.__vagonRawCtrlVFix = {
        peripheral: p,

        paste() {
            rawPaste();
        },

        status() {
            console.log({
                active: true,
                trackedControl:
                    p.trackedModifiers?.Control,
                pressedKeys:
                    p.pressedKeys,
                peripheral: p
            });
        },

        stop(silent = false) {
            window.removeEventListener(
                "keydown",
                onKeyDown,
                true
            );

            window.removeEventListener(
                "keyup",
                onKeyUp,
                true
            );

            suppressVKeyUp = false;

            if (!silent) {
                console.log(
                    "🛑 Vagon RAW Ctrl+V FIX stopped"
                );
            }
        }
    };

    console.log(
        "✅ Vagon RAW Ctrl+V AUTO FIX ACTIVE"
    );
})();